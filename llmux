#!/usr/bin/env bash
set -euo pipefail

# Overridable so the sidebar re-arch (and anything else invasive) can be
# exercised against a throwaway session instead of the live one:
#   LLMUX_SESSION=llmux-test llmux sidebar on
SESSION="${LLMUX_SESSION:-llmux}"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/llmux"
CONFIG_FILE="$CONFIG_DIR/config"
PAUSED_FILE="$CONFIG_DIR/paused.json"
OWNER_REPO_ROOT="$HOME/owner/Owner"
OWNER_SLOTS_DIR="$OWNER_REPO_ROOT/.workspaces"

# llmux is frequently invoked BY THE TMUX SERVER — sidebar popups (`display-popup`),
# `run-shell` bindings, status-line `#()` calls — and that process inherited its
# environment from whenever the server was started, NOT from Jay's shell profile.
# So a tool installed in a per-user bin dir is invisible to `command -v` there.
#
# Concretely: `opencode` lives in ~/.opencode/bin, which is not on the tmux server's
# PATH, so the "+" picker's `command -v` filter silently dropped opencode from the
# platform list — you could not create an opencode thread from the sidebar at all,
# even though it is installed and works fine from the CLI.
#
# Launching was never the broken part: `send-keys` types into the PANE's interactive
# shell, which does source the profile. Only llmux's own availability CHECKS were
# wrong, which is exactly the kind of bug that looks like "the feature is missing".
for _llmux_bin in "$HOME/.opencode/bin" "$HOME/.local/bin" "$HOME/.bun/bin" \
                  "$HOME/.nodenv/shims" "$HOME/.cargo/bin" /opt/homebrew/bin; do
  if [[ -d "$_llmux_bin" ]]; then
    case ":$PATH:" in
      *":$_llmux_bin:"*) ;;
      *) PATH="$PATH:$_llmux_bin" ;;
    esac
  fi
done
unset _llmux_bin
export PATH

usage() {
  # QUOTED heredoc. Unquoted, every backtick and $( ) in the help text below is a
  # command substitution that bash RUNS before printing a word -- and one of these
  # lines cites a `reviewq review` example, which is an interactive fzf drain. So
  # `llmux help` hung forever, having silently launched the review queue in a pane
  # nobody was looking at. The text needs no expansion at all, so quoting it makes
  # the block inert and stops the next backticked example doing the same thing.
  cat <<'EOF'
llmux — multiplex LLM sessions in tmux

Usage:
  llmux add <name> [dir] [--tool <tool>] [--project <name>] [--worktree|--slot[=N]] [--branch <name>]
                                                Add a new pane. In Owner, --slot adopts an
                                                idle owner-wt slot (--worktree is aliased
                                                to --slot inside Owner).
                                                --tool none leaves it a plain shell.
                                                --project puts it in a sidebar section
                                                (default: SCRATCH). A project new to llmux
                                                is offered a Tolaria project to keep its
                                                notes in; --tolaria <slug|new|none> answers
                                                that up front.
  llmux prompt "<prompt>" [--tool <tool>] [--worktree] [--name <slug>]
                                                Auto-name + start a session with the given prompt
  llmux resume [--tool <tool>] [--all]          Pick a past session to resume (hides entries >14d old; --all shows all)
  llmux grab <name> [pane]                      Move an existing tmux pane into llmux
  llmux rm [name] [--force]                     Remove pane (releases owned slot; refuses on dirty slot unless --force)
  llmux pause [name...] [--force]               Pause one or more panes (releases owned slot; refuses on dirty slot unless --force)
  llmux cycle [name|all] [--tool <tool|none>]   Restart a pane's tool in place, resuming the same
                                                session (validates the session first; won't guess
                                                when several share a cwd). 'all' cycles every
                                                pane (terminal excepted), rebuilding the sidebar.
  llmux sidebar [on|off]                        Thread-list UI: sidebar column on the left,
                                                one thread visible at a time. Migrates the
                                                panes you already have; nothing is killed.
                                                Grouped into colour-coded sections by
                                                PROJECT, with SCRATCH first for anything
                                                unassigned. A thread's glyph says which
                                                platform it runs. Click the + to add a
                                                thread (it asks which platform).
  llmux switch [name|index]                     Make a thread the visible one (no argument =
                                                picker; or click its row in the sidebar)
  llmux mv [name|index] [project] [--tolaria <slug|new|none>]
                                                Move a thread to another project, creating
                                                the project if it's new ('scratch' moves it
                                                back). Missing arguments are prompted for;
                                                prefix+M moves the visible thread.
  llmux project [ls]                            Projects and the Tolaria project each keeps
                                                its notes in, plus vault projects with no
                                                threads yet.
  llmux project new <key> [slug]                Create a ten-note Tolaria project for <key>
  llmux project link <key> [slug]               Adopt an existing Tolaria project (picker
                                                when no slug is given)
  llmux project unlink <key>                    Detach the notes (they are left alone)
  llmux project open <key>                      Open the project's hub note
  llmux project monitor [<key> <url|--clear>]   Attach a monitoring dashboard to a project
  llmux project forge [<key> <task-id|url>      Attach a Forge task to a project — a link
             [name]] [--remove <id>] [--clear]  beside (Monitor), NOT a thread: llmux cannot
                                                drive a task it has no pane for. A project may
                                                have several. Bare tsk-… ids expand to
                                                forge.owner.sh/tasks/<id>. NAME IT FOR THE
                                                WORK ("shadow parity sweep") — not the task id
                                                and not Forge own generated task name. The ⚒
                                                glyph and its colour already say it is Forge.
  llmux project flag [<key> <flag> [service]]   Attach an Unleash flag to a project (a
             [--remove <flag>] [--clear]        project may have several; re-adding one
                                                updates it). --remove drops one,
                                                --clear drops all. The
                                                Unleash service is inferred from the flag
                                                prefix (owner-<prefix>) unless given;
                                                --url overrides the generated link.
                                                Renders as a clickable link labelled with
                                                the flag name minus its service prefix,
                                                beside (Monitor) on their own row under
                                                the project title; no argument lists them.
  llmux pr add <number|url> [--title T]         Register a PR under a project so it lists in
             [--project P] [--stack S]          the sidebar. Project defaults to the calling
                                                pane's section; title to the PR's own. PRs
                                                sharing --stack group under that name; an
                                                unlabelled base/head chain groups itself.
  llmux pr ls | rm <number|url> | refresh       List / unregister / re-poll PR state
  llmux review add --title T --url U            Queue a doc for Jay to review (lookout link or
             --context C [--kind K]             equivalent). Project defaults to the calling
             [--project P]                      pane's section. Rides on the reviewq queue, so
                                                'reviewq review' still drains it. Draws at the
                                                TOP of its project, marked 👀 until resolved.
  llmux context [<project>]                     Everything llmux knows about this thread's
                                                project: its vault notes (with paths, in
                                                reading order), monitor/flag/Forge links, PRs
                                                registered, docs awaiting review, and the
                                                sibling threads. What a new agent reads first.
  llmux who [--json]                            Every live thread: name, project, tool, status,
                                                session id, cwd. The directory an agent reads
                                                to decide who to send to.
  llmux send <name|session-id> "<message>"      Deliver a message to another thread. Refuses a
             [--force]                          target sitting on a permission prompt or menu,
                                                where keystrokes would answer it instead.
  llmux asking [on|off]                         Mark this thread as waiting on an answer from
                                                Jay, recolouring its row until he replies.
                                                Claude threads do this automatically (Stop /
                                                Notification hooks); this is for the tools
                                                without hooks.
  llmux review ls | done <id> | dismiss <id>    List / sign off / discard. Marking it done
             | open <id> | mv <id> [project]    clears the 👀; the row fades out after
                                                LLMUX_REVIEW_KEEP_HOURS (24). mv re-files an
                                                entry whose project matched no section.
  llmux snapshot [show|save]                    Live session mirrored to disk (threads,
                                                projects, tools, resumable session ids)
  llmux restore [--force]                       Rebuild the session from that snapshot
                                                after a crash or reboot
  llmux top <name>... | --reset                 Move threads to the top of their sidebar
                                                section, in the order given (--reset clears it)
  llmux next / llmux prev                       Step to the next/previous thread (wraps).
                                                Bound to prefix+j / prefix+k, prefix+Down /
                                                prefix+Up, prefix+Tab; prefix+1-9 jumps;
                                                prefix+M moves the thread to a project.
  llmux worktree <name> [branch]                Tag a pane with a worktree branch
  llmux kill                                    Kill the entire llmux session
  llmux ls                                      List panes with slot + worktree info
  llmux attach                                  Attach to the llmux session
  llmux refresh                                 Recreate session, drop idle panes
  llmux setup                                   Install deps + configure LLM tools
  llmux help                                    Show this help

Examples:
  llmux add "auth-refactor" ~/code/myproject
  llmux add "auth-refactor" --project owner       # lands in the OWNER section
  llmux mv auth-refactor owner                    # move an existing thread there
  llmux mv 3 scratch                              # sidebar row 3 back to SCRATCH
  llmux add "auth-refactor" --slot              # adopt an idle owner-wt slot, branch = pane name
  llmux add "auth-refactor" --slot=2 --branch feature/auth
  llmux add "bug-hunt" --tool amp
  llmux resume                                  # resume with default tool
  llmux resume --tool claude                    # resume a claude session specifically
  llmux resume --all                            # include sessions older than the 14d cutoff
  llmux worktree "my-pane" feature/branch       # manually tag a pane's worktree
  llmux pause "auth-refactor"                   # pause pane (and release slot if owned)
  llmux pause "auth-refactor" --force           # release slot even if dirty
  llmux resume                                     # shows paused panes first, then sessions
  llmux grab "ongoing-debug"
  llmux rm "auth-refactor"
EOF
}

check_deps() {
  local missing=()
  for dep in gum tmux python3; do
    command -v "$dep" &>/dev/null || missing+=("$dep")
  done
  if [[ ${#missing[@]} -gt 0 ]]; then
    echo "Missing dependencies: ${missing[*]}"
    echo "Run 'llmux setup' to install them."
    exit 1
  fi
}

KNOWN_TOOLS=(amp claude codex opencode aider sgpt llm mods ollama)

load_config() {
  LLMUX_TOOL=""
  LLMUX_TOOL_ARGS=""
  if [[ -f "$CONFIG_FILE" ]]; then
    source "$CONFIG_FILE"
  fi
}

get_tool_args() {
  local tool="$1"
  load_config
  local upper
  upper=$(echo "$tool" | tr '[:lower:]-' '[:upper:]_')
  local var="LLMUX_ARGS_${upper}"
  local args
  eval "args=\${$var:-}"
  if [[ -z "$args" && "$tool" == "${LLMUX_TOOL:-}" ]]; then
    args="${LLMUX_TOOL_ARGS:-}"
  fi
  echo "$args"
}

build_tool_cmd() {
  local tool="$1"
  local args
  args="$(get_tool_args "$tool")"
  echo "$tool${args:+ $args}"
}

# Best-effort: refresh codex before launching/resuming so a stale CLI doesn't
# crash the new pane on first contact. Only acts when codex is npm-installed
# globally (the common path) — brew/cargo installs are left alone. Failures
# are non-fatal: we'd rather attempt the launch with the installed version
# than block on a network hiccup.
ensure_codex_fresh() {
  command -v codex >/dev/null 2>&1 || return 0
  command -v npm   >/dev/null 2>&1 || return 0
  npm list -g @openai/codex --depth=0 >/dev/null 2>&1 || return 0

  echo "[llmux] Refreshing codex (npm install -g @openai/codex@latest)..." >&2
  if ! npm install -g @openai/codex@latest >/dev/null 2>&1; then
    echo "[llmux] codex update failed — continuing with installed version" >&2
  fi
}

# Keep ~/op-items warm before a pane's agent starts asking for credentials.
#
# Agents are supposed to read secrets from ~/op-items/<item>/<field> (0600 files)
# rather than shelling out to `op`, because N panes each calling `op` turns one
# locked vault into N Touch ID prompts. Claude panes get this from a SessionStart
# hook; codex/amp/aider panes have no equivalent, so llmux warms it for everyone.
#
# Fire-and-forget and once per llmux invocation: `refresh` launching six panes
# must not fan out into six syncs. `--if-stale` is a sub-second no-op inside the
# TTL, and op-sync takes its own lock, so a concurrent run is harmless anyway.
OP_ITEMS_WARMED=""
warm_op_items() {
  [[ -z "$OP_ITEMS_WARMED" ]] || return 0
  OP_ITEMS_WARMED=1
  local bin="$HOME/.local/bin/op-sync"
  [[ -x "$bin" ]] || return 0
  ( OP_SYNC_QUIET=1 "$bin" --if-stale >/dev/null 2>&1 & ) 2>/dev/null
  return 0
}

# paused.json holds two lists now — paused panes and registered PRs — so it is an
# object, `{"paused": [...], "prs": [...]}`. It was originally a bare list of panes.
#
# _load accepts BOTH shapes and _save always writes the object, so the first write
# migrates the file in place and a file written by an older llmux still reads. Never
# read the file with a bare json.load(): a list-form file would then break every
# `.get('prs')` and the first save would silently drop 33 paused threads.
#
# _save writes to a temp file and renames, because llmux-watch's PR refresher and an
# interactive pause/resume can land at the same moment and a half-written file loses
# everything in it.
PY_PAUSED_IO='
def _load(path):
    import json
    try:
        d = json.load(open(path))
    except Exception:
        return {"paused": [], "prs": []}
    if isinstance(d, list):
        return {"paused": d, "prs": []}
    d.setdefault("paused", [])
    d.setdefault("prs", [])
    d.setdefault("session", {})
    d.setdefault("monitors", {})
    d.setdefault("flags", {})
    return d

def _save(path, d):
    import json, os, tempfile
    fd, tmp = tempfile.mkstemp(dir=os.path.dirname(path) or ".")
    with os.fdopen(fd, "w") as f:
        json.dump(d, f, indent=2)
        f.flush()
        # The rename is atomic, but it only orders the metadata write. Without the
        # fsync a crash seconds later can leave the new name pointing at an empty
        # inode -- the exact failure this file exists to survive.
        os.fsync(f.fileno())
    os.replace(tmp, path)

def _lock(path):
    # Mutations are read-modify-write in short-lived processes, and llmux runs one
    # per agent pane. Two `pr add` calls landing together would otherwise both read
    # the old file and the second would erase the entry the first wrote. Held for life
    # of the process; the OS releases it on exit, including on a kill.
    import fcntl
    f = open(path + ".lock", "w")
    fcntl.flock(f, fcntl.LOCK_EX)
    return f
'

# Read paused.json, output pipe-delimited lines:
#   name|dir|tool|worktree|paused_at|session_id|slot|project
# Sorted most-recent-first by paused_at. `slot` is the owner-wt slot the pane was
# adopting (empty if the pane wasn't using a slot); `project` is its sidebar
# section (empty = scratch).
read_paused() {
  [[ -f "$PAUSED_FILE" ]] || return 0
  python3 -c "$PY_PAUSED_IO"'
import json, sys
data = _load(sys.argv[1])["paused"]
data.sort(key=lambda p: int(p.get("paused_at", 0) or 0), reverse=True)
# Keep keys in sync with add_paused. The slot and project keys were added later
# so they default to "" for backward-compat with older entries.
for p in data:
    print("|".join(str(p.get(k, "")) for k in ["name","dir","tool","worktree","paused_at","session_id","slot","project"]))
' "$PAUSED_FILE"
}

# Append a paused pane entry. Args: name dir tool worktree session_id [slot] [project]
add_paused() {
  local name="$1" dir="$2" tool="${3:-}" worktree="${4:-}" session_id="${5:-}" slot="${6:-}" project="${7:-}"
  python3 -c "$PY_PAUSED_IO"'
import sys, time
path = sys.argv[1]
_lk = _lock(path)
d = _load(path)
d["paused"].append({
    "name": sys.argv[2],
    "dir": sys.argv[3],
    "tool": sys.argv[4],
    "worktree": sys.argv[5],
    "session_id": sys.argv[6],
    "slot": sys.argv[7],
    "project": sys.argv[8],
    "paused_at": int(time.time())
})
_save(path, d)
' "$PAUSED_FILE" "$name" "$dir" "$tool" "$worktree" "$session_id" "$slot" "$project"
}

# Remove a paused entry by name. Returns 0 if found, 1 if not.
# Re-file a PAUSED pane into another project. A paused thread carries its section
# in paused.json rather than a pane option, so grouping has to reach in here too —
# otherwise organising a session only ever covers what happens to be running.
# Exits 2 when there is no such paused entry, so the caller can tell "not paused"
# from "couldn't write".
set_paused_project() {
  local name="${1:-}" project="${2:-}"
  [[ -z "$name" ]] && return 1
  [[ -f "$PAUSED_FILE" ]] || return 2
  python3 -c "$PY_PAUSED_IO"'
import sys
path, name, project = sys.argv[1], sys.argv[2], sys.argv[3]
_lk = _lock(path)
d = _load(path)
hit = False
for p in d["paused"]:
    if p.get("name") == name:
        p["project"] = project
        hit = True
if not hit:
    sys.exit(2)
_save(path, d)
' "$PAUSED_FILE" "$name" "$project"
}

remove_paused() {
  local name="$1"
  python3 -c "$PY_PAUSED_IO"'
import sys
path = sys.argv[1]
name = sys.argv[2]
_lk = _lock(path)
d = _load(path)
before = len(d["paused"])
d["paused"] = [p for p in d["paused"] if p.get("name") != name]
if len(d["paused"]) == before:
    sys.exit(1)
_save(path, d)
' "$PAUSED_FILE" "$name"
}


# Single place a sidebar click turns into a browser tab.
open_url() {
  [[ -n "${1:-}" ]] || return 0
  command -v open >/dev/null 2>&1 || return 0
  (open "$1" >/dev/null 2>&1 &) || true
}


# Unleash link, best effort. The URL needs the Unleash PROJECT, which the flag name
# alone does not give you -- hermes.* and olympus.* live in different projects -- so
# the project ("service") is stored alongside the flag rather than guessed at click
# time. Observed convention is owner-<prefix>, with auth-service as its own project.
UNLEASH_BASE="https://us.app.unleash-hosted.com/usgg0011"

unleash_service_for() {
  local flag="$1" prefix="${1%%.*}"
  case "$prefix" in
    auth-service) R_UNLEASH_SVC="auth-service" ;;
    "$flag")      R_UNLEASH_SVC="default" ;;   # no dotted prefix to infer from
    *)            R_UNLEASH_SVC="owner-${prefix}" ;;
  esac
}

# What a flag link is LABELLED with. The service prefix is the least informative part
# -- every Hermes flag starts "hermes." -- so it is dropped and the remainder shown,
# clipped to whatever the row has left. Only the FIRST segment goes: a flag like
# olympus.checkout.newFeeCalculation keeps "checkout.newFeeCalculation", because that
# middle segment is real context, not boilerplate.
flag_label() {
  local flag="$1" width="${2:-18}" body="${1#*.}"
  [[ "$body" == "$flag" ]] && body="$flag"   # no dotted prefix to strip
  R_FLAG_LABEL="${body:0:width}"
}

read_flags() {
  [[ -f "$PAUSED_FILE" ]] || return 0
  python3 -c "$PY_PAUSED_IO"'
import sys
# A project can be gated on more than one flag -- custom campaigns has a variant
# flag AND a reads flag -- so the value is a LIST. Older files stored a single
# dict; accept both so an in-flight session keeps working.
for k, v in (_load(sys.argv[1]).get("flags") or {}).items():
    entries = v if isinstance(v, list) else [v]
    for e in entries:
        if isinstance(e, dict) and e.get("flag"):
            print("%s\t%s\t%s\t%s" % (k, e.get("flag",""), e.get("service",""), e.get("url","")))
' "$PAUSED_FILE"
}

set_flag() {
  python3 -c "$PY_PAUSED_IO"'
import sys
path, key, flag, service, url, mode = (sys.argv[1:6] + ["add"])[:6]
if len(sys.argv) > 6:
    mode = sys.argv[6]
_lk = _lock(path)
d = _load(path)
cur = d["flags"].get(key)
entries = cur if isinstance(cur, list) else ([cur] if isinstance(cur, dict) and cur.get("flag") else [])
if mode == "remove":
    entries = [e for e in entries if e.get("flag") != flag]
elif flag:
    # Re-registering the same flag updates it in place rather than duplicating.
    entries = [e for e in entries if e.get("flag") != flag]
    entries.append({"flag": flag, "service": service, "url": url})
else:
    entries = []
if entries:
    d["flags"][key] = entries
else:
    d["flags"].pop(key, None)
_save(path, d)
' "$PAUSED_FILE" "$1" "${2:-}" "${3:-}" "${4:-}" "${5:-add}"
}

# ── Forge tasks ──────────────────────────────────────────────────────────────
#
# A Forge task is an agent working on this project somewhere else. It is very nearly
# a thread — it just happens to be running online rather than in a pane — but it is
# deliberately NOT modelled as one: a thread is a live tmux pane, and every piece of
# llmux that switches, parks, cycles, resumes, snapshots or lays out threads assumes
# a pane id it can act on. A row with no pane behind it would break all of them.
#
# So it is a LINK, alongside (Monitor) and the flags: one click to the task, no
# pretence that llmux can drive it.
FORGE_BASE="https://forge.owner.sh/tasks"

# ONE colour for every Forge link, in every project — deliberately not the project
# colour that (Monitor) and the flags take. A Forge task is a different KIND of thing
# from the config links it sits beside, and the row has to say so before you have read
# a word of it. 214 is unused elsewhere: clear of the project palette, of the alert
# yellow/red (220/203) and of the three cyans the tool glyphs use.
FORGE_COLOUR=214

# Accepts a full URL or a bare task id (tsk-…), the way `pr add` takes a number or
# a URL — the id is what you have to hand when an agent has just spawned the task.
forge_url_for() {
  local ref="$1"
  case "$ref" in
    http*://*) R_FORGE_URL="$ref" ;;
    *)         R_FORGE_URL="${FORGE_BASE}/${ref}" ;;
  esac
}

# What the link is LABELLED with: a name the registering agent chose for the WORK.
# Not the task id (tsk-CJyj5XHDU6Pz identifies nothing to a human) and not Forge own
# task name either, which is generated from the prompt and arrives long and literal.
# "shadow parity sweep" is the useful thing to see in a 30-column column.
#
# The ⚒ glyph and the colour are what say "this is Forge"; the label is free to spend
# every one of its columns on which piece of work it is. An unnamed task says so,
# rather than quietly rendering as a second link that looks like the first.
forge_label() {
  local title="$1" width="${2:-18}"
  [[ -z "$title" ]] && title="untitled task"
  R_FORGE_LABEL="${title:0:width}"
}

# Emits: project<TAB>url<TAB>title
read_forge() {
  [[ -f "$PAUSED_FILE" ]] || return 0
  python3 -c "$PY_PAUSED_IO"'
import sys
for k, v in (_load(sys.argv[1]).get("forge") or {}).items():
    entries = v if isinstance(v, list) else [v]
    for e in entries:
        if isinstance(e, dict) and e.get("url"):
            print("%s\t%s\t%s" % (k, e.get("url",""), e.get("title","")))
' "$PAUSED_FILE"
}

set_forge() {
  python3 -c "$PY_PAUSED_IO"'
import sys
path, key, url, title, mode = (sys.argv[1:5] + ["add"])[:5]
if len(sys.argv) > 5:
    mode = sys.argv[5]
_lk = _lock(path)
d = _load(path)
d.setdefault("forge", {})
cur = d["forge"].get(key)
entries = cur if isinstance(cur, list) else ([cur] if isinstance(cur, dict) and cur.get("url") else [])
if mode == "remove":
    # Match on the id as well as the whole URL: you remove a task with whatever you
    # had to hand, which is rarely the full link you registered it with.
    entries = [e for e in entries if e.get("url") != url and e.get("url","").rsplit("/", 1)[-1] != url.rsplit("/", 1)[-1]]
elif url:
    entries = [e for e in entries if e.get("url") != url]
    entries.append({"url": url, "title": title})
else:
    entries = []
if entries:
    d["forge"][key] = entries
else:
    d["forge"].pop(key, None)
_save(path, d)
' "$PAUSED_FILE" "$1" "${2:-}" "${3:-}" "${4:-add}"
}

# ── Project monitoring links ─────────────────────────────────────────────────
#
# A project that has monitoring gets a clickable "(Monitor)" beside its heading, so
# the dashboard is one click from the work rather than a bookmark you have to go
# find. Stored per project key in paused.json — the same file, no new state.
read_monitors() {
  [[ -f "$PAUSED_FILE" ]] || return 0
  python3 -c "$PY_PAUSED_IO"'
import sys
for k, v in (_load(sys.argv[1]).get("monitors") or {}).items():
    if v:
        print("%s\t%s" % (k, v))
' "$PAUSED_FILE"
}

set_monitor() {
  python3 -c "$PY_PAUSED_IO"'
import sys
path, key, url = sys.argv[1], sys.argv[2], sys.argv[3]
_lk = _lock(path)
d = _load(path)
if url:
    d["monitors"][key] = url
else:
    d["monitors"].pop(key, None)
_save(path, d)
' "$PAUSED_FILE" "$1" "${2:-}"
}

# ── Review queue ─────────────────────────────────────────────────────────────
#
# Docs a thread wants Jay to read, drawn at the TOP of their project — above the
# threads, because a doc waiting on him blocks the work under it.
#
# The queue itself belongs to `reviewq` (~/.config/reviewq/queue.jsonl); llmux
# reads that file and never writes it. Enqueueing and resolving shell out to the
# reviewq CLI, so there is exactly one queue and `reviewq review` still drains it.
# The one thing llmux stores is routing: which llmux project an entry belongs to,
# because reviewq's own --project defaults to the basename of the cwd and lands
# entries under names like "jay" or "marketing-engine-2" that match no section.
REVIEW_FILE="${REVIEWQ_DIR:-$HOME/.config/reviewq}/queue.jsonl"

# How long an approved doc keeps its row after Jay signs off. The emoji goes the
# moment it is resolved — that is the signal, and it is answered — but the row
# lingers so "what did I just approve" is still on screen. 0 drops it immediately.
REVIEW_KEEP_HOURS="${LLMUX_REVIEW_KEEP_HOURS:-24}"

set_review_project() {
  python3 -c "$PY_PAUSED_IO"'
import sys
path, rid, project = sys.argv[1], sys.argv[2], sys.argv[3]
_lk = _lock(path)
d = _load(path)
d.setdefault("reviews", {})
if project:
    d["reviews"][rid] = project
else:
    d["reviews"].pop(rid, None)
_save(path, d)
' "$PAUSED_FILE" "$1" "${2:-}"
}

invalidate_review_rows() {
  tmux set-option -t "$SESSION" @llmux_review_rows_sig "" 2>/dev/null || true
}

# Emits: project<TAB>id<TAB>pending|done<TAB>title<TAB>url
#
# $1 = the section keys currently drawn, comma-separated. An entry whose project
# matches none of them is not dropped — it goes to SCRATCH, which is always drawn.
# A doc an agent queued has to be VISIBLE somewhere; silently filing it under a
# section that does not exist is the one outcome worse than putting it in the
# wrong place.
build_review_rows() {
  [[ -f "$REVIEW_FILE" ]] || return 0
  python3 -c "$PY_PAUSED_IO"'
import sys, json, re, time, calendar
paused, qfile, keys_csv, scratch, keep_hours = sys.argv[1:6]
keys = [k for k in keys_csv.split(",") if k]
overrides = (_load(paused).get("reviews") or {})
keep = int(keep_hours) * 3600

def norm(s):
    return re.sub(r"[^a-z0-9]+", "-", (s or "").lower()).strip("-")

lookup = {norm(k): k for k in keys}
now = time.time()

def resolved_age(e):
    # reviewq stamps UTC ("...Z"), so timegm — mktime would read it as local and
    # shift the keep-window by the UTC offset.
    ts = (e.get("resolved_at") or "").replace("Z", "")
    try:
        return now - calendar.timegm(time.strptime(ts, "%Y-%m-%dT%H:%M:%S"))
    except Exception:
        return 0   # unparseable stamp keeps the row rather than vanishing it

rows = []
for line in open(qfile):
    line = line.strip()
    if not line:
        continue
    try:
        e = json.loads(line)
    except Exception:
        continue
    status = e.get("status") or "pending"
    if status == "dismissed":
        continue
    if status != "pending":
        if keep <= 0 or resolved_age(e) > keep:
            continue
    rid = str(e.get("id") or "")
    project = overrides.get(rid) or lookup.get(norm(e.get("project"))) or scratch
    rows.append((project, rid, "pending" if status == "pending" else "done",
                 " ".join((e.get("title") or "").split()), e.get("url") or ""))

# Pending first, then most recently queued: the thing waiting on him outranks the
# thing he already answered, whatever order the file happens to be in.
rows.sort(key=lambda r: (r[2] != "pending", -int(r[1] or 0)))
for r in rows:
    print("\t".join(r))
' "$PAUSED_FILE" "$REVIEW_FILE" "${1:-}" "$SCRATCH_KEY" "$REVIEW_KEEP_HOURS"
}

# Monitors, Forge tasks and flags in ONE python3 start, for the paint.
#
# read_monitors + read_flags + read_forge are three interpreter starts against the
# same file, and a python3 start is ~140ms under load against a paint that runs every
# 2s -- so the render was spending most of a second re-reading one small JSON three
# times. The individual readers stay: the CLI paths use them, where one start is fine
# and the clearer call site is worth more.
#
# Emits, tagged so bash can split it back apart without re-parsing:
#   m<TAB>project<TAB>url
#   g<TAB>project<TAB>url<TAB>title
#   f<TAB>project<TAB>flag<TAB>service<TAB>url
read_project_links() {
  [[ -f "$PAUSED_FILE" ]] || return 0
  python3 -c "$PY_PAUSED_IO"'
import sys
d = _load(sys.argv[1])
for k, v in (d.get("monitors") or {}).items():
    if v:
        print("m\t%s\t%s" % (k, v))
for k, v in (d.get("forge") or {}).items():
    for e in (v if isinstance(v, list) else [v]):
        if isinstance(e, dict) and e.get("url"):
            print("g\t%s\t%s\t%s" % (k, e.get("url",""), e.get("title","")))
for k, v in (d.get("flags") or {}).items():
    for e in (v if isinstance(v, list) else [v]):
        if isinstance(e, dict) and e.get("flag"):
            print("f\t%s\t%s\t%s\t%s" % (k, e.get("flag",""), e.get("service",""), e.get("url","")))
' "$PAUSED_FILE"
}

# ── Registered PRs ───────────────────────────────────────────────────────────
#
# An agent registers the PR it just opened; the sidebar lists it under that
# agent's project until it merges or goes quiet. Identity is "<repo>#<number>".
#
# Two halves, deliberately split:
#   paused.json `prs`   — INTENT: which PRs, whose project, the agent's title and
#                         stack name. Persisted; only a human or agent changes it.
#   @llmux_prs_state    — FETCHED: open/merged/draft + last-activity, refreshed by
#                         llmux-watch. Volatile cache, so it is a tmux option and
#                         never a file. Losing it costs one refresh, nothing more.
#
# Emits: repo|number|url|title|project|branch|base|stack
read_prs() {
  [[ -f "$PAUSED_FILE" ]] || return 0
  python3 -c "$PY_PAUSED_IO"'
import sys
for p in _load(sys.argv[1])["prs"]:
    print("|".join(str(p.get(k, "")) for k in
        ["repo","number","url","title","project","branch","base","stack"]))
' "$PAUSED_FILE"
}

# Drop the render cache so the next paint rebuilds the PR rows. Registry writes must
# call this: the cache signature includes paused.json's mtime, which `stat` reports in
# whole SECONDS — so a registration landing in the same second as the previous paint
# leaves the signature identical and the new row would not appear until the minute
# bucket rolled over. An agent registering a PR expects to see it, not to wait a minute.
invalidate_pr_rows() {
  tmux set-option -t "$SESSION" @llmux_pr_rows_sig "" 2>/dev/null || true
}

# Upsert by repo#number so re-registering updates rather than duplicating — an
# agent that re-runs `pr add` after a retitle should not create a second row.
add_pr() {
  python3 -c "$PY_PAUSED_IO"'
import sys, time
path, repo, num = sys.argv[1], sys.argv[2], sys.argv[3]
url, title, project, branch, base, stack = sys.argv[4:10]
_lk = _lock(path)
d = _load(path)
for p in d["prs"]:
    if p.get("repo") == repo and str(p.get("number")) == num:
        p.update(url=url, project=project, branch=branch, base=base)
        # Empty title/stack means "not specified this time" — keep what is there
        # rather than blanking a name an agent set earlier.
        if title: p["title"] = title
        if stack: p["stack"] = stack
        _save(path, d); sys.exit(0)
d["prs"].append(dict(repo=repo, number=int(num), url=url, title=title,
                     project=project, branch=branch, base=base, stack=stack,
                     added_at=int(time.time())))
_save(path, d)
' "$PAUSED_FILE" "$1" "$2" "$3" "$4" "$5" "$6" "$7" "$8"
}

remove_pr() {
  python3 -c "$PY_PAUSED_IO"'
import sys
path, repo, num = sys.argv[1], sys.argv[2], sys.argv[3]
_lk = _lock(path)
d = _load(path)
before = len(d["prs"])
d["prs"] = [p for p in d["prs"]
            if not (p.get("repo") == repo and str(p.get("number")) == num)]
if len(d["prs"]) == before:
    sys.exit(1)
_save(path, d)
' "$PAUSED_FILE" "$1" "$2"
}

# For claude panes: after launch, watch the project's slug dir for a jsonl
# file whose mtime jumped past `since_epoch` and tag the pane with that
# session uuid via @llmux_claude_session. Runs in the background so the
# launch path stays snappy.
#
# Why this exists: multiple claude sessions can share a cwd. The watcher's
# context-% reader needs a per-pane session id to disambiguate them; relying
# on mtime-newest in the slug dir would give every pane the same number.
capture_claude_session_async() {
  local pane_target="$1" cwd="$2" since_epoch="$3"
  # UUIDs already owned by other panes. Without this the watcher happily tags
  # this pane with a neighbour's session when they share a cwd.
  local claimed
  claimed="$(tmux list-panes -s -t "$SESSION" -F '#{@llmux_claude_session}' 2>/dev/null | grep -v '^$' | paste -sd, - 2>/dev/null || true)"
  (
    python3 - "$cwd" "$since_epoch" "$pane_target" "$claimed" <<'PY' 2>/dev/null &
import os, sys, glob, time, subprocess, re
cwd, since, pane = sys.argv[1], int(sys.argv[2]), sys.argv[3]
claimed = {u for u in (sys.argv[4] if len(sys.argv) > 4 else '').split(',') if u}
proj_root = os.path.expanduser('~/.claude/projects')
# Resolve symlinks too: /tmp/x is stored under the -private-tmp slug on macOS.
real = os.path.realpath(cwd)
slugs = set()
for c in (cwd, real):
    slugs.add(c.replace('/', '-'))
    slugs.add(c.replace('/', '-').replace('.', '-'))
dirs = [os.path.join(proj_root, s) for s in slugs if os.path.isdir(os.path.join(proj_root, s))]
UUID_RE = re.compile(r'([0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})\.jsonl$')

def uuid_of(path):
    m = UUID_RE.search(path)
    return m.group(1) if m else None

# Poll for up to 20s — covers --continue (touches latest jsonl quickly) and
# fresh launches (creates a new jsonl ~3-5s after claude starts).
deadline = time.time() + 20
match = None
while time.time() < deadline:
    fresh, touched = [], []
    for d in dirs:
        for p in glob.glob(os.path.join(d, '*.jsonl')):
            u = uuid_of(p)
            # Never steal a session another pane already owns.
            if not u or u in claimed:
                continue
            try:
                st = os.stat(p)
            except OSError:
                continue
            if st.st_mtime < since:
                continue
            # A file *created* since launch is this pane's own new session —
            # far stronger evidence than one merely written to.
            born = getattr(st, 'st_birthtime', None)
            if born is not None and born >= since:
                fresh.append((st.st_mtime, p))
            else:
                touched.append((st.st_mtime, p))
    if fresh:
        match = max(fresh)[1]
        break
    if touched:
        match = max(touched)[1]
        break
    time.sleep(0.5)

if match:
    m = UUID_RE.search(match)
    if m:
        subprocess.run(
            ['tmux', 'set-option', '-p', '-t', pane, '@llmux_claude_session', m.group(1)],
            check=False,
        )
PY
  ) &
  disown
}

# Where opencode keeps its sessions. One sqlite db for every cwd, unlike claude's
# per-directory transcript dirs — so the harvester and this watcher both query it
# rather than walking the filesystem.
OPENCODE_DB="$HOME/.local/share/opencode/opencode.db"

# For opencode panes: after launch, watch the sessions db for a row in this cwd
# created since launch, and tag the pane with its id via @llmux_opencode_session.
#
# Why this exists: opencode mints `ses_...` LAZILY, on the first message — there is
# no --session-id to pre-assign the way claude has, and no flag to name a session
# either. So a brand-new opencode pane is untagged, and `llmux cycle` can only fall
# back to `--continue` (= most recent session in the cwd), which opens the WRONG
# thread as soon as two opencode panes share a cwd. Capturing the real id closes
# that, and is also what lets the resume picker find these threads later.
#
# Two filters matter:
#   parent_id NOT NULL  — subagent sessions are rows too, and a fan-out would
#                         otherwise win the race against its own parent.
#   claimed             — never steal an id another pane already owns.
capture_opencode_session_async() {
  local pane_target="$1" cwd="$2" since_ms="$3"
  [[ -f "$OPENCODE_DB" ]] || return 0
  local claimed
  claimed="$(tmux list-panes -s -t "$SESSION" -F '#{@llmux_opencode_session}' 2>/dev/null | grep -v '^$' | paste -sd, - 2>/dev/null || true)"
  (
    python3 - "$OPENCODE_DB" "$cwd" "$since_ms" "$pane_target" "$claimed" <<'PY' 2>/dev/null &
import os, sqlite3, subprocess, sys, time
db, cwd, since, pane = sys.argv[1], sys.argv[2], int(sys.argv[3]), sys.argv[4]
claimed = {s for s in (sys.argv[5] if len(sys.argv) > 5 else '').split(',') if s}
real = os.path.realpath(cwd)

# Poll: the row only appears once the user sends a first message, which can be a
# while. 90s is generous but this costs one cheap indexed query every 2s and the
# whole thing is backgrounded.
deadline = time.time() + 90
found = None
while time.time() < deadline and not found:
    try:
        # immutable=1: read a consistent snapshot without taking a lock on a db
        # opencode itself is actively writing.
        con = sqlite3.connect(f"file:{db}?mode=ro&immutable=1", uri=True, timeout=1)
        rows = con.execute(
            "SELECT id FROM session"
            " WHERE parent_id IS NULL AND directory IN (?, ?) AND time_created >= ?"
            " ORDER BY time_created DESC",
            (cwd, real, since),
        ).fetchall()
        con.close()
        for (sid,) in rows:
            if sid not in claimed:
                found = sid
                break
    except Exception:
        pass
    if not found:
        time.sleep(2)

if found:
    subprocess.run(
        ['tmux', 'set-option', '-p', '-t', pane, '@llmux_opencode_session', found],
        check=False,
    )
PY
  ) &
  disown
}

launch_tool_in_pane() {
  local pane_target="$1"
  local tool="${2:-}"
  local session_name="${3:-}"

  if [[ -z "$tool" ]]; then
    load_config
    tool="${LLMUX_TOOL:-}"
  fi

  if [[ -n "$tool" ]]; then
    tmux set-option -p -t "$pane_target" @llmux_tool "$tool"
    warm_op_items
    [[ "$tool" == "codex" ]] && ensure_codex_fresh
    local tool_cmd
    tool_cmd="$(build_tool_cmd "$tool")"
    local launch_cmd="unset CLAUDECODE CLAUDE_CODE_SESSION; "
    if [[ -n "$session_name" && "$tool" == "amp" ]]; then
      local args
      args="$(get_tool_args "$tool")"
      launch_cmd+="THREAD_ID=\$(amp threads new --no-color 2>/dev/null) && amp threads rename \"\$THREAD_ID\" $(printf '%q' "$session_name") 2>/dev/null; amp${args:+ $args} threads continue \"\$THREAD_ID\""
    else
      launch_cmd+="$tool_cmd"
      # Claude takes -n / --name to set the session display name at launch.
      # Cleaner than the old /rename send-keys hack and avoids the 3s race.
      if [[ -n "$session_name" && "$tool" == "claude" ]]; then
        launch_cmd+=" -n $(printf '%q' "$session_name")"
      fi
    fi
    # Assign the session id ourselves instead of guessing it afterwards.
    #
    # The old approach launched claude, then watched the project dir for the
    # newest-touched jsonl. That silently mis-tags whenever panes share a cwd
    # (very common — several panes sit in ~/ or ~/owner/Owner): a neighbouring
    # pane writing to its own transcript wins the mtime race, so this pane gets
    # tagged with the NEIGHBOUR's session. `llmux cycle` then resumed the wrong
    # thread. `claude --session-id <uuid>` removes the guess entirely.
    if [[ "$tool" == "claude" ]]; then
      local new_sid
      new_sid="$(uuidgen 2>/dev/null | tr 'A-Z' 'a-z')"
      if [[ -n "$new_sid" ]]; then
        launch_cmd+=" --session-id $new_sid"
        tmux set-option -p -t "$pane_target" @llmux_claude_session "$new_sid" 2>/dev/null || true
      else
        # No uuidgen — fall back to the (best-effort) watcher.
        tmux set-option -p -t "$pane_target" @llmux_claude_session "" 2>/dev/null || true
        local cwd_now
        cwd_now=$(tmux display-message -p -t "$pane_target" '#{pane_current_path}')
        capture_claude_session_async "$pane_target" "$cwd_now" "$(date +%s)"
      fi
    fi
    # opencode can't pre-assign an id (see capture_opencode_session_async), so the
    # watcher is the only way a newly-created opencode thread ever becomes
    # cycle-able and resumable. Started before send-keys so the launch timestamp
    # can't be later than the session it's looking for.
    if [[ "$tool" == "opencode" ]]; then
      local oc_cwd oc_since
      oc_cwd=$(tmux display-message -p -t "$pane_target" '#{pane_current_path}')
      oc_since=$(( $(date +%s) * 1000 ))
      capture_opencode_session_async "$pane_target" "$oc_cwd" "$oc_since"
    fi
    tmux send-keys -t "$pane_target" "$launch_cmd" Enter
  fi
}

resume_tool_in_pane() {
  local pane_target="$1"
  local tool="$2"
  local session_name="${3:-}"
  local session_id="${4:-}"

  warm_op_items
  [[ "$tool" == "codex" ]] && ensure_codex_fresh
  local tool_cmd
  tool_cmd="$(build_tool_cmd "$tool")"
  local resume_cmd="unset CLAUDECODE CLAUDE_CODE_SESSION; "
  case "$tool" in
    claude)
      if [[ -n "$session_id" ]]; then
        resume_cmd+="$tool_cmd --resume $session_id"
      else
        resume_cmd+="$tool_cmd --continue"
      fi
      [[ -n "$session_name" ]] && resume_cmd+=" -n $(printf '%q' "$session_name")"
      ;;
    codex)  resume_cmd+="$tool_cmd resume --last" ;;
    opencode)
      # opencode takes -s <session-id> (or -c for the most recent). Its ids are
      # opaque `ses_...` strings minted lazily on the first message, so unlike
      # claude we cannot pre-assign one at launch — the id only exists to resume
      # once a session has actually said something.
      if [[ -n "$session_id" ]]; then
        resume_cmd+="$tool_cmd --session $(printf '%q' "$session_id")"
      else
        resume_cmd+="$tool_cmd --continue"
      fi
      ;;
    amp)    resume_cmd+="$tool_cmd" ;;
    *)      resume_cmd+="$tool_cmd" ;;
  esac
  tmux set-option -p -t "$pane_target" @llmux_tool "$tool"
  if [[ "$tool" == "opencode" && -n "$session_id" ]]; then
    tmux set-option -p -t "$pane_target" @llmux_opencode_session "$session_id" 2>/dev/null || true
  fi
  if [[ "$tool" == "claude" ]]; then
    if [[ -n "$session_id" ]]; then
      tmux set-option -p -t "$pane_target" @llmux_claude_session "$session_id" 2>/dev/null || true
    else
      tmux set-option -p -t "$pane_target" @llmux_claude_session "" 2>/dev/null || true
      local cwd_now
      cwd_now=$(tmux display-message -p -t "$pane_target" '#{pane_current_path}')
      capture_claude_session_async "$pane_target" "$cwd_now" "$(date +%s)"
    fi
  fi
  tmux send-keys -t "$pane_target" "$resume_cmd" Enter
}

is_default_title() {
  local title="$1"
  [[ -z "$title" || "$title" == "bash" || "$title" == "zsh" || "$title" == "$(hostname)" || "$title" == "$(hostname -s 2>/dev/null)" ]]
}

ensure_session() {
  if ! tmux has-session -t "$SESSION" 2>/dev/null; then
    tmux new-session -d -s "$SESSION" -x 200 -y 50
    # Enable pane titles in the border (with waiting indicator)
    tmux set-option -t "$SESSION" pane-border-status top
    # Status prefix, most-urgent first. `blocked`/`perm` get a WORD, not just a
    # glyph — the border is the one place with room to say what is wanted, and an
    # emoji alone reads as decoration once you have a dozen panes.
    #
    # Note the `#,` escapes: inside a #{?...} conditional a literal comma
    # separates the true/false arms, so the comma in #[fg=colour220,bold] must be
    # written #[fg=colour220#,bold] or tmux truncates the attribute list.
    apply_pane_border_format
    # Style the borders for clarity
    tmux set-option -t "$SESSION" pane-border-style 'fg=colour240'
    tmux set-option -t "$SESSION" pane-active-border-style 'fg=colour39,bold'
    # Enable mouse for scrolling and pane selection (toggle with prefix + m)
    tmux set-option -t "$SESSION" mouse on
    tmux bind-key -T prefix m set-option mouse
    apply_status_right
    # Active pane's Claude token usage (used_k/left_k vs the 1M window), bottom-left
    # under Claude's ">> bypass permissions on" footer. @llmux_ctx is maintained per
    # pane by llmux-watch; status formats resolve it against the active pane. Falls
    # back to the session name on panes with no token count (terminal/non-claude).
    tmux set-option -t "$SESSION" status-left "#{?#{@llmux_ctx},#[fg=colour214,bold] 🪙 #{@llmux_ctx} #[default],#[fg=colour244] [#{session_name}] #[default]}"
    tmux set-option -t "$SESSION" status-left-length 40
    tmux set-option -t "$SESSION" status-interval 5
    # Allow mouse wheel to scroll in non-alternate-screen panes (plain shells)
    tmux set-option -t "$SESSION" terminal-overrides 'xterm*:smcup@:rmcup@'
    # Copy mouse selections to system clipboard
    tmux set-option -s copy-command "pbcopy"
    # Mark the initial pane as the dedicated terminal (top-left)
    tmux set-option -p -t "$SESSION" @llmux_terminal "1"
    tmux set-option -p -t "$SESSION" @llmux_name "terminal"
    tmux select-pane -t "$SESSION" -T "terminal"
    # Create pinned pane to the right of terminal (top-right)
    load_config
    local pinned_name="${LLMUX_PINNED_NAME:-make-llmux-better}"
    local pinned_dir="${LLMUX_PINNED_DIR:-$HOME/code/llmux}"
    [[ ! -d "$pinned_dir" ]] && pinned_dir="$(pwd)"
    local pinned_pane
    pinned_pane=$(tmux split-window -t "$SESSION" -h -c "$pinned_dir" -P -F '#{pane_id}' -l 50%)
    tmux set-option -p -t "$pinned_pane" @llmux_pinned "1"
    tmux set-option -p -t "$pinned_pane" @llmux_name "$pinned_name"
    tmux select-pane -t "$pinned_pane" -T "$pinned_name"
    if [[ "${LLMUX_SKIP_PINNED_LAUNCH:-}" != "1" ]]; then
      launch_tool_in_pane "$pinned_pane" "${LLMUX_PINNED_TOOL:-}" "$pinned_name"
    fi
    # Auto re-layout when a pane exits
    tmux set-hook -t "$SESSION" pane-exited "run-shell 'llmux _relayout 2>/dev/null || true'"
    # Start the background watcher for waiting-state detection
    watch_start
    INITIAL_PANE=1
  fi
}

# Get the pane_id of the dedicated terminal pane.
# -s searches every window in the session, so this resolves correctly even when
# llmux is invoked from a sub-window (where the active window isn't window 0).
# Pane border: status flag, name, context counter, slot, cwd, worktree.
#
# A function rather than an inline literal in ensure_session because ensure_session
# only runs when there is no session — so an inline format could never be updated
# in a live session without recreating it (and recreating it kills every thread).
# cmd_sidebar's `on` path re-applies this, which is how a running session picks up
# a changed format. Keep that call in step with any edit here.
# status-right lives here rather than inline in ensure_session for the same reason
# apply_pane_border_format does: ensure_session only runs when there is NO session,
# so an inline format can never be corrected in a live session without recreating
# it — which kills every thread. Call this to repair one in place.
#
# The mouse flag is deliberately INVERTED from how it started out. It used to draw
# " [mouse] " when the mouse was ON and nothing when OFF, which announces the normal
# state and hides the broken one: `prefix`+`m` toggles the mouse and sits one shift
# away from `prefix`+`M` (move thread to project), so a mistyped move silently kills
# every click in the sidebar with no indication anywhere on screen. That cost a real
# debugging session. Now OFF is loud and ON says nothing.
#
# Inside a #{?...} conditional a literal comma separates the arms, so a comma inside
# #[...] must be escaped as #, — see the pane-border format below.
apply_status_right() {
  tmux set-option -t "$SESSION" status-right \
    "#(llmux _slot-status)#(llmux _status-count)#(reviewq _status-count)#{?mouse,,#[fg=colour203#,bold] MOUSE OFF (prefix+m) #[default]} %H:%M " 2>/dev/null || true
  tmux set-option -t "$SESSION" status-right-length 200 2>/dev/null || true
}

apply_pane_border_format() {
  # Built up in pieces rather than as one 600-character literal: a mis-nested
  # #{?...} silently renders the whole border empty, and the escaping is
  # impossible to eyeball inline.
  #
  # blocked/perm get a WORD, not just a glyph — the border is the one surface with
  # room to say what is wanted, and a lone emoji reads as decoration once a dozen
  # panes have one.
  #
  # Note the `#,` escapes: inside a #{?...} conditional a literal comma separates
  # the true/false arms, so the comma in #[fg=colour220,bold] must be written
  # #[fg=colour220#,bold] or tmux truncates the attribute list.
  local st_bl st_pm st_bs sflag
  st_bl='#[fg=colour220#,bold]🙋 ANSWER ME #[default]'
  st_pm='#[fg=colour203#,bold]🔐 APPROVE? #[default]'
  st_bs='#[fg=colour38]🌀 #[default]'
  # blocked > perm > busy > nothing. `idle` (and its legacy `waiting` alias) draw
  # NOTHING — see STATUS_FLAGS: idle is the resting state of most threads, so a
  # glyph on it is decoration. A bare border means "fine, nothing wanted".
  sflag="#{?#{==:#{@llmux_status},blocked},${st_bl},"
  sflag+="#{?#{==:#{@llmux_status},perm},${st_pm},"
  sflag+="#{?#{==:#{@llmux_status},busy},${st_bs},}}}"
  tmux set-option -t "$SESSION" pane-border-format " ${sflag}#{?#{@llmux_name},#{@llmux_name},#{pane_title}}#{?#{@llmux_ctx}, #[fg=colour244]#{@llmux_ctx}#[default],}#{?#{@llmux_slot}, #[fg=colour39][#{@llmux_slot}]#[default],} [#{pane_current_path}]#{?#{@llmux_worktree}, (#{@llmux_worktree}),} " 2>/dev/null || true
}

get_terminal_pane() {
  # `|| true`: when no pane is tagged as the terminal, grep exits 1, and under
  # `set -euo pipefail` that non-zero would propagate out of a `$(...)` capture
  # and abort the caller (e.g. apply_layout). No match is a valid "none" result.
  { tmux list-panes -s -t "$SESSION" -F '#{pane_id}|#{@llmux_terminal}' 2>/dev/null \
    | grep '|1$' | head -1 | cut -d'|' -f1; } || true
}

# Get the pane_id of the pinned pane (always-visible top-right)
get_pinned_pane() {
  # `|| true`: sessions created before the pinned-pane feature have no pinned
  # pane, so grep exits 1; without this the pipefail non-zero aborts apply_layout
  # mid-`add`, and the tool never launches (bare shell instead of an agent).
  { tmux list-panes -s -t "$SESSION" -F '#{pane_id}|#{@llmux_pinned}' 2>/dev/null \
    | grep '|1$' | head -1 | cut -d'|' -f1; } || true
}

# Split a new pane for an LLM tool, anchored to the terminal pane so it always
# lands in the main llmux window — not whatever window/pane happens to be active
# when add/resume/prompt/refresh is invoked (e.g. from a sub-window or popup,
# where `split-window -t "$SESSION"` would create the pane in the wrong window).
# Echoes the new pane id; callers run apply_layout afterwards.
spawn_llm_pane() {
  local dir="$1"
  local anchor
  anchor=$(get_terminal_pane)
  tmux split-window -t "${anchor:-$SESSION}" -v -c "$dir" -P -F '#{pane_id}'
}

# Re-layout: top row = terminal (left) + pinned (right), LLM panes tiled below.
# Falls back to original full-width terminal layout if no pinned pane exists.
apply_layout() {
  # Sidebar mode owns the geometry of window 0; the classic terminal/pinned
  # tiling below would fight it.
  if sidebar_enabled; then
    sidebar_apply_layout
    return
  fi
  local term_pane pinned_pane
  term_pane=$(get_terminal_pane)
  [[ -z "$term_pane" ]] && return
  pinned_pane=$(get_pinned_pane)

  # Anchor every op to the terminal pane's window (the main llmux window), not
  # the session's active window — otherwise invoking llmux from a sub-window
  # would count/re-tile the wrong window.
  local pane_count
  pane_count=$(tmux list-panes -t "$term_pane" 2>/dev/null | wc -l | tr -d ' ')

  if [[ "$pane_count" -le 1 ]]; then
    return
  fi

  # Ensure terminal pane is first (index 0) so main-horizontal puts it on top
  local first_pane
  first_pane=$(tmux list-panes -t "$term_pane" -F '#{pane_id}' | head -1)
  if [[ "$first_pane" != "$term_pane" ]]; then
    tmux swap-pane -s "$term_pane" -t "$first_pane"
  fi

  local win_height
  win_height=$(tmux display-message -t "$term_pane" -p '#{window_height}')
  local main_height=$(( win_height * 25 / 100 ))
  [[ "$main_height" -lt 10 ]] && main_height=10

  if [[ -n "$pinned_pane" && "$pane_count" -ge 3 ]]; then
    # Layout: terminal + pinned on top, LLM panes tiled below
    # Step 1: apply main-horizontal (terminal full-width top, everything else below)
    tmux set-option -t "$term_pane" main-pane-height "$main_height"
    tmux select-layout -t "$term_pane" main-horizontal
    # Step 2: move pinned pane from bottom tile into top row beside terminal
    tmux join-pane -h -t "$term_pane" -s "$pinned_pane" -l 50%
  elif [[ -n "$pinned_pane" && "$pane_count" -eq 2 ]]; then
    # Only terminal + pinned: side by side, full height
    tmux select-layout -t "$term_pane" even-horizontal
  else
    # No pinned pane: original layout
    tmux set-option -t "$term_pane" main-pane-height "$main_height"
    tmux select-layout -t "$term_pane" main-horizontal
  fi
}

# ---------------------------------------------------------------------------
# Sidebar mode — the "threads" UI
#
# Window 0 is [ sidebar | active thread ]. Every other thread is parked as a
# pane in a hidden `_parked` window, so exactly one thread is visible at a time
# and the thread list never scrolls away. Switching threads = join-pane the
# target into window 0 and park the outgoing one; panes keep their processes,
# scrollback and pane options across the move.
#
# State is derived, per the no-new-state-files rule: thread identity is still
# @llmux_name, the sidebar pane carries @llmux_sidebar=1, the parked window's
# placeholder carries @llmux_parked_anchor=1, and the mode flag is the session
# option @llmux_sidebar_mode. paused.json is untouched.
#
# Thread order is (pinned first, then name) so it is stable without storing an
# ordering anywhere — the click handler recomputes the same list the renderer
# drew, which is what makes row -> thread mapping safe.
# ---------------------------------------------------------------------------

SIDEBAR_WIDTH=30
SIDEBAR_HEADER_LINES=2   # rows of chrome above the first section; see render_sidebar
SIDEBAR_RULE_WIDTH=26    # horizontal rules stop here so title + sections align
PARKED_WINDOW="_parked"
DEFAULT_THREAD_ORDER=50  # rank for threads with no explicit @llmux_order

# --- Projects: the sidebar's grouping axis ------------------------------------
#
# Sections are PROJECTS, not tools. The tool a thread runs is per-thread trivia
# shown by its glyph (see thread_icon); what you actually organise by is "which
# piece of work is this". So a thread carries @llmux_project and the sidebar
# groups on that.
#
# Projects are IMPLICIT — one exists exactly as long as some thread claims it.
# There is no registry of "real" projects to create or delete, which is what
# makes `llmux mv <thread> <project>` the only gesture needed to reorganise.
#
# SCRATCH is the unassigned bucket: no @llmux_project = scratch. It is drawn
# first and drawn even when empty, because it is where new threads land and an
# empty inbox is itself information.
SCRATCH_KEY="scratch"
SCRATCH_COLOUR=244

# Section colours for projects, assigned by a stable hash of the project name so
# a project keeps its colour across sessions without anything being stored.
# Deliberately excludes the STATUS_FLAGS alert colours (220 / 203): a section
# heading must never read as "this needs you".
PROJECT_COLOURS=(209 141 80 78 213 39 149 175 111 116 168 105)

# Menu sentinel for "type a name" in the project picker.
NEW_PROJECT_ITEM="＋ new project…"

# Thread status vocabulary — the single registry for what llmux-watch can put in
# @llmux_status and how each state is shown. Fields: key|emoji|256-colour|label.
#
# Ordered most-urgent first.
#
# The distinction that matters: `blocked` and `perm` mean a thread has STOPPED and
# cannot continue without you, while `idle` just means it finished its turn. Those
# were one state (`waiting`, shown as ⏳) and were indistinguishable at a glance —
# a thread sitting on an unanswered question looked exactly like one that was done.
#
# ⏳ is gone entirely. It reads as "time passing" — static, and easy to mistake for
# "stalled" — which is wrong for both "answer me" and "still going". `busy` uses 🌀
# instead: a spiral reads as motion, which is exactly what it means. It also stays
# rare, since most threads never sit in one changing state for two minutes.
#
# `idle` HAS NO GLYPH ON PURPOSE. It is the resting state of every thread that
# isn't currently doing something, so at any moment most of the list is idle —
# and a glyph on the majority is decoration, not signal. Marking it made 💤 the
# most common thing in the column, which is exactly backwards: an emoji has to
# mean "look at this". Empty emoji is the OFF switch every surface already reads,
# since each gates on `[[ -n "${smeta%%|*}" ]]` — so blanking this field alone
# suppresses idle in the sidebar row, the switch picker and the pane listings.
# The label is kept for anywhere that wants to spell the state out in words.
STATUS_FLAGS=(
  "blocked|🙋|220|needs an answer"
  "perm|🔐|203|needs approval"
  "idle||244|done — at the prompt"
  "busy|🌀|38|still working"
  "waiting||244|done — at the prompt"
)

# "emoji|colour|label" for a status. Unknown/empty statuses yield empty fields, so
# callers can test for a flag with [[ -n "$emoji" ]] and draw nothing otherwise.
#
# `waiting` is a legacy alias mapped to `idle`: panes tagged by an older
# llmux-watch keep rendering sensibly instead of losing their flag mid-upgrade.
# Also sets R_STATUS_META so the render loop can read the result without a $(…) fork —
# it calls this once per row, per paint.
status_meta() {
  local key="$1" spec
  R_STATUS_META='||'
  if [[ -n "$key" ]]; then
    for spec in "${STATUS_FLAGS[@]}"; do
      if [[ "${spec%%|*}" == "$key" ]]; then
        R_STATUS_META="${spec#*|}"
        break
      fi
    done
  fi
  printf '%s' "$R_STATUS_META"
}

# ── Finished-and-unseen fade ─────────────────────────────────────────────────
#
# @llmux_done_at — the contract llmux-watch and mark_thread_seen share:
#   <empty>   never finished, or working again — no mark
#   0         finished, and since seen — no mark
#   <unixts>  finished then, still unseen — dot, faded by age
#
# Fields: max-age-secs|256-colour, first bucket the age is under wins. The colours
# stay clear of the STATUS_FLAGS alert colours and PROJECT_COLOURS: this axis is
# "how stale", not "needs you" or "which project". Why it fades: README.
DONE_FADE=(
  "60|255"
  "600|250"
  "3600|245"
  "21600|240"
)
DONE_FADE_FLOOR=236

# Also sets R_FADE so the render loop can read the result without a $(…) fork —
# it calls this once per row, per paint.
done_fade_colour() {
  local age="$1" spec
  R_FADE="$DONE_FADE_FLOOR"
  for spec in "${DONE_FADE[@]}"; do
    (( age < ${spec%%|*} )) && { R_FADE="${spec##*|}"; break; }
  done
  printf '%s' "$R_FADE"
}

# At most 3 characters wide — the row's width budget depends on it.
# Also sets R_AGE so the render loop can read the result without a $(…) fork —
# it calls this once per row, per paint.
fmt_age_short() {
  local s="$1"
  if   (( s < 60 ));    then R_AGE="now"
  elif (( s < 3600 ));  then printf -v R_AGE '%dm' $(( s / 60 ))
  elif (( s < 86400 )); then printf -v R_AGE '%dh' $(( s / 3600 ))
  else                       printf -v R_AGE '%dd' $(( s / 86400 ))
  fi
  printf '%s' "$R_AGE"
}

# The 0 sentinel, not an empty value: llmux-watch stamps on the finish EDGE and
# clears only when a thread works again, so blanking here reads as "never finished"
# and re-stamps within a tick — the dot would return seconds after you looked.
mark_thread_seen() {
  local pane="$1"
  [[ -z "$pane" ]] && return 0
  tmux set-option -p -t "$pane" @llmux_done_at "0" 2>/dev/null || true
  # Looking at the thread answers the question the 🙋 was asking, so it goes the
  # moment the thread is on screen — clicked, switched to with prefix+j/k, or
  # focused any other way, since every path lands here.
  #
  # One query, not three: this runs for the active pane on EVERY paint, and a fork
  # in that loop is the cost the render caching exists to avoid. Nothing is written
  # unless there is something to clear.
  local seen_state
  seen_state=$(tmux display-message -p -t "$pane" \
    '#{@llmux_asking}|#{@llmux_status_src}|#{@llmux_status}' 2>/dev/null || true)
  case "$seen_state" in
    \|*) return 0 ;;   # not asking — the common case, and it costs one query
  esac
  tmux set-option -p -t "$pane" @llmux_asking "" 2>/dev/null || true
  # Clear the derived status too, or the row keeps its colour for up to one watcher
  # cycle (5s) after the click. ONLY when the watcher says the `blocked` came from
  # the asking flag: a thread sitting on a real permission gate or an unanswered
  # choice menu is still blocked whether or not Jay has looked at it, and blanking
  # that would erase a state he has not actually dealt with.
  local src="${seen_state#*|}"; local st="${src#*|}"; src="${src%%|*}"
  if [[ "$st" == "blocked" && "$src" == "asking" ]]; then
    tmux set-option -p -t "$pane" @llmux_status "" 2>/dev/null || true
    tmux set-option -p -t "$pane" @llmux_status_src "" 2>/dev/null || true
  fi
}

# Column the "+" affordance is drawn in — a constant, so the click hotspot does
# not depend on how long a section's label is and the plus signs line up down the
# column. Section rules are shortened to stop just before it.
SIDEBAR_PLUS_COL=26

# Project names travel through `|`-delimited listings, a comma-delimited tmux
# option and tmux option values, so they are restricted to a safe alphabet here —
# once, at every point of entry — rather than escaped at each use site.
sanitize_project() {
  printf '%s' "${1:-}" \
    | tr '[:upper:]' '[:lower:]' \
    | tr -c 'a-z0-9._-' '-' \
    | sed -E 's/-+/-/g; s/^-+//; s/-+$//' \
    | head -c 24
}

# Platform colours. The glyph says which platform a thread runs, and says it in
# that platform's own colour — so the row carries two INDEPENDENT visual axes:
# the glyph is "what is this", the text is "which work is this".
#
# Deliberately DISJOINT from PROJECT_COLOURS. If the palettes shared a value, a
# project could be assigned the colour that means "codex" and the two axes would
# collide — check that when adding to either list.
TOOL_COLOURS=(
  "claude|173"
  "codex|44"
  "opencode|99"
  "amp|205"
  "aider|179"
  "term|71"
)
TOOL_COLOUR_FALLBACK=245

# Colour for a platform. An empty tool or @llmux_terminal=1 is a plain shell and
# takes the terminal colour, matching thread_icon's ❯ for the same cases.
# Also sets R_TOOL_COLOUR so the render loop can read the result without a $(…) fork —
# it calls this once per row, per paint.
tool_colour() {
  local tool="${1:-}" is_terminal="${2:-0}" spec want="$1"
  [[ "$is_terminal" == "1" || -z "$tool" ]] && want="term"
  R_TOOL_COLOUR="$TOOL_COLOUR_FALLBACK"
  for spec in "${TOOL_COLOURS[@]}"; do
    [[ "${spec%%|*}" == "$want" ]] && { R_TOOL_COLOUR="${spec##*|}"; break; }
  done
  printf '%s' "$R_TOOL_COLOUR"
}

# Preferred colour for a project: sum of the name's bytes, modulo the palette. The
# same name always prefers the same colour, so a project tends to keep its colour
# across sessions with nothing stored.
project_colour_preferred() {
  local key="${1:-}" h
  [[ -z "$key" || "$key" == "$SCRATCH_KEY" ]] && { printf '%s' "$SCRATCH_COLOUR"; return 0; }
  h=$({ printf '%s' "$key" | cksum | awk '{print $1}'; } || echo 0)
  [[ "$h" =~ ^[0-9]+$ ]] || h=0
  printf '%s' "${PROJECT_COLOURS[$(( h % ${#PROJECT_COLOURS[@]} ))]}"
}

# key:colour pairs, built once per process. Not persisted state — a cache, and the
# next invocation rebuilds it, which is also when the project list could have
# changed. A render asks for a colour once per section AND once per row, so
# recomputing per call would mean an O(n²) burst of tmux reads every 2s.
PROJECT_COLOUR_MAP=""

# Assign every live project a colour DISTINCT from the others'. The hash alone
# collides — 12 slots — and two sections drawn in the same colour defeats the only
# thing the colour is for. Projects are walked in registry order; each takes its
# hashed colour when free, otherwise the next free slot. First-come keeps its hash,
# so adding a project never recolours the ones above it.
build_project_colour_map() {
  local k pref c taken="" map=""
  while IFS= read -r k; do
    [[ -z "$k" || "$k" == "$SCRATCH_KEY" ]] && continue
    case ",$map" in *",$k:"*) continue ;; esac
    pref=$(project_colour_preferred "$k")
    case ",$taken," in
      *",$pref,"*)
        pref=""
        for c in "${PROJECT_COLOURS[@]}"; do
          case ",$taken," in *",$c,"*) continue ;; esac
          pref="$c"
          break
        done
        # More live projects than palette slots: take the duplicate rather than
        # draw a section with no colour at all.
        [[ -z "$pref" ]] && pref=$(project_colour_preferred "$k")
        ;;
    esac
    taken+="${pref},"
    map+="${k}:${pref},"
  done < <(known_projects)
  PROJECT_COLOUR_MAP="${map%,}"
}

project_colour() {
  local key="${1:-}" pair
  [[ -z "$key" || "$key" == "$SCRATCH_KEY" ]] && { printf '%s' "$SCRATCH_COLOUR"; return 0; }
  [[ -z "$PROJECT_COLOUR_MAP" ]] && build_project_colour_map
  local IFS_SAVE="$IFS"
  IFS=','
  for pair in $PROJECT_COLOUR_MAP; do
    if [[ "${pair%%:*}" == "$key" ]]; then
      IFS="$IFS_SAVE"
      printf '%s' "${pair##*:}"
      return 0
    fi
  done
  IFS="$IFS_SAVE"
  # Not in the registry yet (brand new, or no session): its hash is the best guess.
  project_colour_preferred "$key"
}

# "LABEL|colour" for a section key. Labels are upper-cased for display only —
# the key stays exactly what is stored in @llmux_project.
# Uppercase without forking. macOS ships bash 3.2, which has no ${var^^}, and the
# obvious `printf | tr` costs two forks — paid once per section per paint, twice
# over once sidebar_section_header asks again.
_upper() {
  local s="$1" out="" c p i
  local lo="abcdefghijklmnopqrstuvwxyz" up="ABCDEFGHIJKLMNOPQRSTUVWXYZ"
  for (( i = 0; i < ${#s}; i++ )); do
    c="${s:i:1}"
    p="${lo%%"$c"*}"
    if (( ${#p} < 26 )); then out+="${up:${#p}:1}"; else out+="$c"; fi
  done
  R_UPPER="$out"
}

# Memoised for the life of the process and published into R_PROJECT_META, because
# a paint asks for the same handful of projects repeatedly: once in the draw loop
# and again inside sidebar_section_header. At ~56ms a call on a loaded machine that
# was the single largest cost in a paint. Cache is a plain string, not an
# associative array — bash 3.2 has none.
PROJECT_META_CACHE=""
project_meta() {
  local key="${1:-$SCRATCH_KEY}" label hit
  [[ -z "$key" ]] && key="$SCRATCH_KEY"
  hit="${PROJECT_META_CACHE#*$'\x01'"$key"$'\x02'}"
  if [[ "$hit" != "$PROJECT_META_CACHE" ]]; then
    R_PROJECT_META="${hit%%$'\x01'*}"
    printf '%s' "$R_PROJECT_META"
    return 0
  fi
  _upper "$key"; label="$R_UPPER"
  R_PROJECT_META="${label}|$(project_colour "$key")"
  PROJECT_META_CACHE+=$'\x01'"${key}"$'\x02'"${R_PROJECT_META}"
  printf '%s' "$R_PROJECT_META"
}

# Every project some live thread claims, one per line, sorted.
live_projects() {
  { tmux list-panes -s -t "$SESSION" \
      -F '#{@llmux_name}|#{@llmux_sidebar}|#{@llmux_parked_anchor}|#{@llmux_project}' 2>/dev/null \
    | awk -F'|' '$1 != "" && $2 != "1" && $3 != "1" && $4 != "" { print $4 }' \
    | sort -u; } || true
}

# Remember a project's position. @llmux_project_order is a session-scoped,
# append-only list of every project seen this session — including ones whose
# threads are all paused. Sticky on purpose: a project that empties and refills
# comes back where it was instead of jumping to the bottom of the sidebar.
register_project() {
  local key="${1:-}" order
  [[ -z "$key" || "$key" == "$SCRATCH_KEY" ]] && return 0
  order=$(tmux show-option -t "$SESSION" -qv @llmux_project_order 2>/dev/null || true)
  case ",$order," in
    *",$key,"*) return 0 ;;
  esac
  tmux set-option -t "$SESSION" @llmux_project_order "${order:+$order,}$key" 2>/dev/null || true
}

# Ordered section keys, i.e. the sidebar's draw order: scratch, then projects in
# registry order, then any project seen for the first time (which this registers,
# so the next render finds it in place).
project_sections() {
  local order live key seen="" newly=()
  printf '%s\n' "$SCRATCH_KEY"
  live=$(live_projects)
  order=$(tmux show-option -t "$SESSION" -qv @llmux_project_order 2>/dev/null || true)

  local IFS_SAVE="$IFS"
  IFS=','
  for key in $order; do
    [[ -z "$key" || "$key" == "$SCRATCH_KEY" ]] && continue
    seen+="${key},"
    if printf '%s\n' "$live" | grep -qxF "$key"; then
      printf '%s\n' "$key"
    fi
  done
  IFS="$IFS_SAVE"

  while IFS= read -r key; do
    [[ -z "$key" || "$key" == "$SCRATCH_KEY" ]] && continue
    case ",$seen" in *",$key,"*) continue ;; esac
    newly+=("$key")
    printf '%s\n' "$key"
  done < <(printf '%s\n' "$live")

  for key in ${newly[@]+"${newly[@]}"}; do
    register_project "$key"
  done
}

# Every project worth offering in a picker: the live sections first, then ones
# only paused threads remember, then registry leftovers. First-seen order wins,
# so scratch stays at the top.
known_projects() {
  {
    project_sections
    tmux show-option -t "$SESSION" -qv @llmux_project_order 2>/dev/null | tr ',' '\n' || true
    read_paused | cut -d'|' -f8 || true
  } | grep -v '^$' | awk '!seen[$0]++'
}

# The project of the thread currently on screen — the contextual default when
# adding or moving, so "another thread in what I'm looking at" is one keystroke.
active_thread_project() {
  local act
  act=$(get_active_thread_pane)
  [[ -z "$act" ]] && return 0
  tmux display-message -p -t "$act" '#{@llmux_project}' 2>/dev/null || true
}

# gum-pick a project. $1 = key to offer first (may be empty = scratch).
# Echoes the chosen key ("" means scratch); non-zero if the user cancelled.
prompt_for_project() {
  local dflt key menu=() pick
  dflt=$(sanitize_project "${1:-}")
  [[ "$dflt" == "$SCRATCH_KEY" ]] && dflt=""
  [[ -n "$dflt" ]] && menu+=("$dflt")
  while IFS= read -r key; do
    [[ -z "$key" || "$key" == "$dflt" ]] && continue
    menu+=("$key")
  done < <(known_projects)
  menu+=("$NEW_PROJECT_ITEM")

  # `gum filter`, not `gum choose`, and sized to the list. choose defaults to
  # --height 10 and shows no scroll indicator, so with a dozen projects the tail --
  # including "＋ new project…" -- was simply invisible: the list looked complete and
  # silently skipped entries. filter also lets you type to narrow, which is how every
  # other long picker in llmux behaves, and the project list only grows.
  local ph=$(( ${#menu[@]} + 2 ))
  (( ph > 20 )) && ph=20
  pick=$(printf '%s\n' "${menu[@]}" | gum filter --height "$ph" \
    --placeholder "type to filter" --prompt "> " \
    --header "Project" --header.foreground "99" \
    --indicator.foreground "212" --match.foreground "212") || return 1
  [[ -z "$pick" ]] && return 1
  if [[ "$pick" == "$NEW_PROJECT_ITEM" ]]; then
    pick=$(gum input --placeholder "project name" --header "New project" \
      --header.foreground "99" --prompt.foreground "39") || return 1
    pick=$(sanitize_project "$pick")
    [[ -z "$pick" ]] && return 1
  fi
  [[ "$pick" == "$SCRATCH_KEY" ]] && pick=""
  printf '%s' "$pick"
}

# --- Tolaria: where a project keeps its memory --------------------------------
#
# An llmux project is a sidebar section — a place threads sit. A Tolaria project
# is the same piece of work's WRITTEN memory: the ten-note folder under
# `Projects/<slug>/` in the second-brain vault (that folder's AGENTS.md is the
# spec). They describe one thing from two ends, so llmux keeps them attached:
# naming a new project here offers to create the notes there, and an existing
# vault project can be adopted instead of duplicated.
#
# The association is stored IN THE VAULT — `llmux_project: <key>` in the hub
# note's frontmatter. Two reasons it doesn't live here: it survives `llmux
# refresh`, which recreates the tmux session and would drop a session option;
# and it is legible where a human is already reading. The common case stores
# nothing at all — a key and a slug spelled the same resolve to each other.
#
# Everything below degrades to a silent no-op when the vault is absent, so llmux
# still works on a machine that has never seen it.
TOLARIA_VAULT="${LLMUX_TOLARIA_VAULT:-$HOME/Vaults/second-brain}"
TOLARIA_PROJECTS_DIR="$TOLARIA_VAULT/Projects"

# The nine tracking notes beside a hub note, in the order the hub lists them:
# intent → approach → what's unknown → what we learned → what we decided →
# where we are → what's next → what happened → what's finished.
TOLARIA_NOTES=(intent approach open-questions findings decisions milestones todo log archive)
TOLARIA_NOTE_LABELS=(Intent Approach "Open questions" Findings Decisions Milestones Todo Log Archive)

tolaria_available() {
  [[ -d "$TOLARIA_PROJECTS_DIR" ]]
}

# Vault slugs use the project alphabet but not sanitize_project's 24-char cap —
# `me2-lifecycle-campaigns-migration` is a real one.
sanitize_tolaria_slug() {
  printf '%s' "${1:-}" \
    | tr '[:upper:]' '[:lower:]' \
    | tr -c 'a-z0-9._-' '-' \
    | sed -E 's/-+/-/g; s/^-+//; s/-+$//'
}

# Path to a vault project's hub note. No existence check — callers test it.
tolaria_hub() {
  printf '%s' "$TOLARIA_PROJECTS_DIR/${1:-}/${1:-}.md"
}

# Every project in the vault, one slug per line. A directory counts as a project
# only when it holds its own hub note, which is what separates a project folder
# from a stray directory someone dropped in Projects/.
tolaria_projects() {
  tolaria_available || return 0
  local d slug
  for d in "$TOLARIA_PROJECTS_DIR"/*/; do
    slug=$(basename "$d")
    [[ -f "$(tolaria_hub "$slug")" ]] && printf '%s\n' "$slug"
  done
  return 0
}

# The vault slug an llmux project key resolves to, or nothing.
#
# Name match first: a key and a slug spelled the same ARE the same project, and
# that case needs no bookkeeping. Only when they differ is the explicit
# association consulted — and only in a HUB note, so a tracking note that
# happens to quote the line can't be mistaken for one.
tolaria_slug_for_key() {
  local key="${1:-}" slug hub
  [[ -z "$key" || "$key" == "$SCRATCH_KEY" ]] && return 0
  tolaria_available || return 0
  if [[ -f "$(tolaria_hub "$key")" ]]; then
    printf '%s' "$key"
    return 0
  fi
  while IFS= read -r slug; do
    [[ -z "$slug" ]] && continue
    hub=$(tolaria_hub "$slug")
    if grep -qxF "llmux_project: $key" "$hub" 2>/dev/null; then
      printf '%s' "$slug"
      return 0
    fi
  done < <(tolaria_projects)
  return 0
}

# Reverse lookup: which llmux key claims this vault project. Used to stop a
# picker attaching two sections to one set of notes without saying so.
tolaria_key_for_slug() {
  local hub
  hub=$(tolaria_hub "${1:-}")
  [[ -f "$hub" ]] || return 0
  { grep -m1 '^llmux_project:' "$hub" | sed 's/^llmux_project:[[:space:]]*//'; } || true
}

# Frontmatter `status:` (Active / Paused / Done), for display.
tolaria_status() {
  local hub
  hub=$(tolaria_hub "${1:-}")
  [[ -f "$hub" ]] || return 0
  { grep -m1 '^status:' "$hub" | sed 's/^status:[[:space:]]*//'; } || true
}

# Append one line to a project's append-only log. Silent when there is no such
# project: llmux logging is a courtesy and must never be why a command fails.
tolaria_log() {
  local slug="${1:-}" msg="${2:-}" log
  [[ -z "$slug" || -z "$msg" ]] && return 0
  log="$TOLARIA_PROJECTS_DIR/$slug/$slug-log.md"
  [[ -f "$log" ]] || return 0
  # A hand-edited note may not end in a newline, and appending straight onto it
  # grafts the new entry onto the tail of the previous one — which corrupts the
  # note llmux is least allowed to corrupt, since -log is append-only history.
  # In a command substitution a trailing newline is stripped, so an empty result
  # means the file already ends in one.
  if [[ -s "$log" && -n "$(tail -c 1 "$log" 2>/dev/null)" ]]; then
    printf '\n' >> "$log" 2>/dev/null || true
  fi
  printf '%s\n' "- $(date '+%Y-%m-%d %H:%M') — $msg" >> "$log" 2>/dev/null || true
  return 0
}

# Write (empty key = clear) the association in a hub note's frontmatter.
# Rewritten through the same inode, so the vault's file watcher sees an edit
# rather than a delete-and-replace.
tolaria_set_association() {
  local slug="${1:-}" key="${2:-}" hub tmp
  hub=$(tolaria_hub "$slug")
  [[ -f "$hub" ]] || { echo "Error: no Tolaria hub note at $hub" >&2; return 1; }
  tmp=$(mktemp "${TMPDIR:-/tmp}/llmux-tolaria.XXXXXX") || return 1
  if ! awk -v key="$key" '
        NR == 1 && $0 == "---" { print; fm = 1; next }
        fm && /^llmux_project:/ { next }
        fm && $0 == "---" {
          if (key != "") print "llmux_project: " key
          print; fm = 0; closed = 1; next
        }
        { print }
        END { if (!closed) exit 3 }
      ' "$hub" > "$tmp"; then
    rm -f "$tmp"
    echo "Error: $slug's hub note has no frontmatter block to record the link in." >&2
    return 1
  fi
  cat "$tmp" > "$hub" && rm -f "$tmp"
}

# The seed body for one tracking note. Deliberately empty-but-shaped: a heading
# and a line saying nothing is here yet, so a fresh note reads as "not written"
# instead of as content someone wrote and abandoned.
tolaria_note_seed() {
  case "${1:-}" in
    intent)         printf '%s\n' "## What & why" "" "_Not captured yet._" ;;
    approach)       printf '%s\n' "## How" "" "_Not captured yet._" ;;
    open-questions) printf '%s\n' "_No open questions recorded yet._" ;;
    findings)       printf '%s\n' "_No findings recorded yet._" ;;
    decisions)      printf '%s\n' "Append-only, newest at the bottom." "" "_No decisions recorded yet._" ;;
    milestones)     printf '%s\n' "_No milestones planned yet._" ;;
    todo)           printf '%s\n' "Remaining work only, in priority order. Completed items move to the archive." "" "_Nothing queued yet._" ;;
    log)            printf '%s\n' "Append-only, one line per logical edit, newest at the bottom." "" ;;
    archive)        printf '%s\n' "Completed todo items, moved here as they finish." "" "_Nothing archived yet._" ;;
  esac
}

# Create the ten-note folder for <slug>, associated with llmux key <key>.
# $3 is the display title (defaults to the slug). Echoes the slug on success.
tolaria_create_project() {
  local slug="${1:-}" key="${2:-}" title="${3:-}" dir hub i note label
  [[ -z "$slug" ]] && return 1
  tolaria_available || { echo "Error: no Tolaria vault at $TOLARIA_VAULT" >&2; return 1; }
  title="${title:-$slug}"
  dir="$TOLARIA_PROJECTS_DIR/$slug"
  if [[ -e "$dir" ]]; then
    echo "Error: $dir already exists — link to it instead: llmux project link ${key:-<key>} $slug" >&2
    return 1
  fi
  mkdir -p "$dir" || return 1

  hub=$(tolaria_hub "$slug")
  {
    printf '%s\n' "---" "type: Project" "status: Active"
    [[ -n "$key" ]] && printf '%s\n' "llmux_project: $key"
    printf '%s\n' "---" "# $title" ""
    printf '%s\n' "**Status:** Active — created from llmux on $(date '+%Y-%m-%d')." ""
    printf '%s\n' "## Why" "" "_Not captured yet — see [[$slug-intent]]._" ""
    printf '%s\n' "## Approach" "" "_Not captured yet — see [[$slug-approach]]._" ""
    printf '%s\n' "## Docs" ""
    for i in "${!TOLARIA_NOTES[@]}"; do
      printf '%s\n' "- [[$slug-${TOLARIA_NOTES[$i]}]] — ${TOLARIA_NOTE_LABELS[$i]}"
    done
  } > "$hub"

  for i in "${!TOLARIA_NOTES[@]}"; do
    note="${TOLARIA_NOTES[$i]}"
    label="${TOLARIA_NOTE_LABELS[$i]}"
    {
      printf '%s\n' "---" "type: Note" "belongs_to: \"[[$slug]]\"" "---"
      printf '%s\n' "# $title — $label" ""
      tolaria_note_seed "$note"
    } > "$dir/$slug-$note.md"
  done

  tolaria_log "$slug" "Project created from llmux${key:+ (thread section '$key')}."
  printf '%s' "$slug"
}

# Associate an EXISTING vault project with an llmux key. Echoes the slug.
tolaria_link_key() {
  local key="${1:-}" slug="${2:-}" claimed
  [[ -z "$key" || -z "$slug" ]] && return 1
  if [[ ! -f "$(tolaria_hub "$slug")" ]]; then
    echo "Error: no Tolaria project '$slug' in $TOLARIA_PROJECTS_DIR" >&2
    return 1
  fi
  claimed=$(tolaria_key_for_slug "$slug")
  if [[ -n "$claimed" && "$claimed" != "$key" ]]; then
    echo "Note: '$slug' was linked to '$claimed'; re-pointing it at '$key'." >&2
  fi
  tolaria_set_association "$slug" "$key" || return 1
  tolaria_log "$slug" "Linked to llmux thread section '$key'."
  printf '%s' "$slug"
}

# gum-pick an existing vault project. Rows carry status and, when one is already
# claimed, the key claiming it — the two things that decide whether it's the one
# you meant. Echoes the slug; non-zero if cancelled or the vault is empty.
tolaria_prompt_for_slug() {
  local menu=() slug owner st row pick
  while IFS= read -r slug; do
    [[ -z "$slug" ]] && continue
    owner=$(tolaria_key_for_slug "$slug")
    st=$(tolaria_status "$slug")
    row="$slug"
    [[ -n "$st" ]] && row+="  [$st]"
    [[ -n "$owner" ]] && row+="  ← $owner"
    menu+=("$row")
  done < <(tolaria_projects)
  if [[ ${#menu[@]} -eq 0 ]]; then
    echo "No Tolaria projects in $TOLARIA_PROJECTS_DIR" >&2
    return 1
  fi
  pick=$(printf '%s\n' "${menu[@]}" | gum filter \
    --header "Tolaria project" --header.foreground "99" \
    --indicator "▸" --indicator.foreground "212" \
    --match.foreground "212" --prompt.foreground "39") || return 1
  [[ -z "$pick" ]] && return 1
  printf '%s' "${pick%% *}"
}

# Ask what a brand-new project's memory should be. Echoes a slug, or nothing if
# the answer was "no notes" — which is remembered, so the question is asked once
# per project rather than on every thread that lands in it.
tolaria_offer_project() {
  local key="${1:-}" pick slug
  [[ -z "$key" ]] && return 0
  # Non-interactive callers (hooks, scripts, another agent) must not block on a
  # picker. They pass --tolaria explicitly instead.
  [[ -t 0 ]] || return 0
  tolaria_skipped "$key" && return 0

  pick=$(printf '%s\n' \
      "create a new Tolaria project '$key'" \
      "link an existing Tolaria project…" \
      "no Tolaria project" \
    | gum choose --header "Project memory for ${key}" \
        --header.foreground "99" --cursor.foreground "212") \
    || { tolaria_skip "$key"; return 0; }

  case "$pick" in
    create*)
      slug=$(tolaria_create_project "$key" "$key") || return 0
      echo "Created Tolaria project '$slug' → $TOLARIA_PROJECTS_DIR/$slug" >&2
      ;;
    link*)
      slug=$(tolaria_prompt_for_slug) || { tolaria_skip "$key"; return 0; }
      slug=$(tolaria_link_key "$key" "$slug") || return 0
      echo "Linked '$key' → Tolaria project '$slug'" >&2
      ;;
    *)
      tolaria_skip "$key"
      return 0
      ;;
  esac
  printf '%s' "$slug"
}

# Session-scoped memory of keys offered a Tolaria project and declined. Same
# shape and lifetime as @llmux_project_order: sticky within a session, and
# nothing that matters is lost when it goes.
tolaria_skipped() {
  local key="${1:-}" skip
  skip=$(tmux show-option -t "$SESSION" -qv @llmux_tolaria_skip 2>/dev/null || true)
  case ",$skip," in *",$key,"*) return 0 ;; esac
  return 1
}

tolaria_skip() {
  local key="${1:-}" skip
  [[ -z "$key" ]] && return 0
  tolaria_skipped "$key" && return 0
  skip=$(tmux show-option -t "$SESSION" -qv @llmux_tolaria_skip 2>/dev/null || true)
  tmux set-option -t "$SESSION" @llmux_tolaria_skip "${skip:+$skip,}$key" 2>/dev/null || true
  return 0
}

# THE hook. Called wherever a thread lands in a project — `llmux add --project`,
# `llmux mv`, the sidebar "+", prefix+M — so the lifecycle is wired in one place
# instead of at each of those call sites.
#
# $1 = project key (empty/scratch = nothing to do)
# $2 = thread name, for the log line
# $3 = explicit intent, bypassing the prompt: a vault slug to link, "new" to
#      create, "none" to skip. Empty = ask when interactive, skip when not.
tolaria_attach_project() {
  local key="${1:-}" thread="${2:-}" intent="${3:-}" slug=""
  [[ -z "$key" || "$key" == "$SCRATCH_KEY" ]] && return 0
  [[ -n "${LLMUX_NO_TOLARIA:-}" ]] && return 0
  tolaria_available || return 0

  case "$intent" in
    none)
      tolaria_skip "$key"
      return 0
      ;;
    new)
      slug=$(tolaria_create_project "$key" "$key") || return 1
      echo "Created Tolaria project '$slug' → $TOLARIA_PROJECTS_DIR/$slug" >&2
      ;;
    "")
      slug=$(tolaria_slug_for_key "$key")
      [[ -z "$slug" ]] && slug=$(tolaria_offer_project "$key")
      ;;
    *)
      slug=$(tolaria_link_key "$key" "$(sanitize_tolaria_slug "$intent")") || return 1
      echo "Linked '$key' → Tolaria project '$slug'" >&2
      ;;
  esac

  [[ -n "$slug" && -n "$thread" ]] \
    && tolaria_log "$slug" "llmux: thread '$thread' joined project '$key'."
  return 0
}

sidebar_enabled() {
  local v
  v=$(tmux show-option -t "$SESSION" -qv @llmux_sidebar_mode 2>/dev/null || true)
  [[ "$v" == "1" ]]
}

# `|| true` on every grep: no match is a valid "none", and a bare non-zero
# would abort the caller under `set -euo pipefail` (same reasoning as
# get_terminal_pane / get_pinned_pane above).
get_sidebar_pane() {
  { tmux list-panes -s -t "$SESSION" -F '#{pane_id}|#{@llmux_sidebar}' 2>/dev/null \
    | grep '|1$' | head -1 | cut -d'|' -f1; } || true
}

get_parked_anchor() {
  { tmux list-panes -s -t "$SESSION" -F '#{pane_id}|#{@llmux_parked_anchor}' 2>/dev/null \
    | grep '|1$' | head -1 | cut -d'|' -f1; } || true
}

# Every thread pane, grouped by section, then @llmux_order, then pinned, then name.
#
# Section rank is the PRIMARY sort key, so the emitted order is exactly the order
# the sidebar draws — which is what keeps `llmux switch <n>`, prefix+1-9,
# active_thread_index and sidebar_step all agreeing with the numbers on screen.
# Consequence worth knowing: @llmux_order (see cmd_top) now reorders within a
# section rather than across the whole list, because it sorts after the section.
#
# @llmux_order is an explicit rank; threads without one default to
# DEFAULT_THREAD_ORDER so they keep sorting among themselves as before. Ordering
# deliberately does NOT reuse @llmux_pinned: in classic mode that option means
# "the always-visible top-right pane" and get_pinned_pane takes head -1, so
# pinning something like the terminal to reorder it would wedge apply_layout.
#
# A thread's section is its @llmux_project (empty = scratch); project_sections is
# the single source of truth for which sections exist and in what order, and the
# renderer consumes the key emitted here.
#
# Emits: pane_id|name|tool|status|window_index|is_terminal|group
list_threads() {
  local raw gorder
  raw=$({ tmux list-panes -s -t "$SESSION" \
    -F '#{pane_id}|#{@llmux_name}|#{@llmux_tool}|#{@llmux_status}|#{@llmux_pinned}|#{@llmux_sidebar}|#{@llmux_parked_anchor}|#{window_index}|#{@llmux_order}|#{@llmux_terminal}|#{@llmux_project}' \
    2>/dev/null; } || true)
  [[ -z "$raw" ]] && return 0
  gorder=$({ project_sections | paste -sd, -; } || true)
  printf '%s\n' "$raw" | awk -F'|' -v dflt="$DEFAULT_THREAD_ORDER" -v gorder="$gorder" -v scratch="$SCRATCH_KEY" '
    BEGIN { n = split(gorder, gk, ","); for (i = 1; i <= n; i++) grank[gk[i]] = i }
    $2 != "" && $6 != "1" && $7 != "1" {
      g = ($11 == "") ? scratch : $11
      gr = (g in grank) ? grank[g] : 999
      pin = ($5 == "1") ? 0 : 1
      ord = ($9 == "") ? dflt : $9 + 0
      printf "%d\t%d\t%d\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", gr, ord, pin, $2, $1, $3, $4, $8, $10, g
    }' | sort -t"$(printf '\t')" -k1,1n -k2,2n -k3,3n -k4,4 \
     | awk -F'\t' '{print $5"|"$4"|"$6"|"$7"|"$8"|"$9"|"$10}'
}

# Sidebar glyph per thread. Deliberately single-width BMP glyphs rather than
# emoji: emoji are double-width in most terminals and mixing widths across rows
# makes the 30-column list ragged.
# Also sets R_THREAD_ICON so the render loop can read the result without a $(…) fork —
# it calls this once per row, per paint.
thread_icon() {
  local tool="$1" is_terminal="$2"
  if [[ "$is_terminal" == "1" ]]; then
    R_THREAD_ICON="❯"
  else
    case "$tool" in
      claude)   R_THREAD_ICON="✳" ;;
      codex)    R_THREAD_ICON="◇" ;;
      opencode) R_THREAD_ICON="▣" ;;
      amp)      R_THREAD_ICON="◆" ;;
      aider)    R_THREAD_ICON="◈" ;;
      "")       R_THREAD_ICON="❯" ;;
      *)        R_THREAD_ICON="●" ;;
    esac
  fi
  printf '%s\n' "$R_THREAD_ICON"
}

# One section heading: coloured project label, a dim rule, and optionally a "+"
# in SIDEBAR_PLUS_COL. Returned WITHOUT a trailing newline so the caller stays in
# charge of counting rows — row geometry is the click contract and must be
# accounted for in one place (render_sidebar).
#
# with_plus is wired through but unused by the current renderer: there is ONE "+"
# for the whole sidebar (on the rule row), because a new thread now needs a
# platform chosen and that question belongs to the thread, not the section.
sidebar_section_header() {
  local key="$1" with_plus="${2:-0}"
  local meta label colour rule="" i=0 rule_len
  project_meta "$key" >/dev/null; meta="$R_PROJECT_META"
  label="${meta%%|*}"
  colour="${meta##*|}"
  if [[ "$with_plus" == "1" ]]; then
    # Stop the rule so the "+" lands exactly in SIDEBAR_PLUS_COL for every
    # section: 1 leading space + label + 1 space + rule + 1 space + "+".
    rule_len=$(( SIDEBAR_PLUS_COL - ${#label} - 3 ))
  else
    # Plus-less sections keep the rule flush with the title divider.
    rule_len=$(( SIDEBAR_RULE_WIDTH - ${#label} - 1 ))
  fi

  (( rule_len < 0 )) && rule_len=0
  while (( i < rule_len )); do rule+="─"; ((i++)); done
  printf -v R_SECTION_HEADER ' \033[1;38;5;%sm%s\033[0m \033[38;5;236m%s\033[0m' "$colour" "$label" "$rule"
  [[ "$with_plus" == "1" ]] && printf -v R_SECTION_HEADER '%s \033[1;38;5;%sm+\033[0m' "$R_SECTION_HEADER" "$colour"
  printf '%s' "$R_SECTION_HEADER"
  return 0
}

# The thread currently occupying window 0 (i.e. everything there that is not
# the sidebar). Empty when only the sidebar is up.
get_active_thread_pane() {
  local sb win
  sb=$(get_sidebar_pane)
  [[ -z "$sb" ]] && return 0
  win=$(tmux display-message -p -t "$sb" '#{window_index}' 2>/dev/null || true)
  [[ -z "$win" ]] && return 0
  { tmux list-panes -t "$SESSION:$win" -F '#{pane_id}|#{@llmux_sidebar}' 2>/dev/null \
    | grep -v '|1$' | head -1 | cut -d'|' -f1; } || true
}

# Hidden holding window. join-pane can only move a pane next to an existing
# pane, so the window needs a permanent placeholder to aim at — hence the
# anchor. It sleeps forever and is never displayed.
ensure_parked_window() {
  local anchor
  anchor=$(get_parked_anchor)
  [[ -n "$anchor" ]] && return 0
  tmux new-window -d -t "$SESSION" -n "$PARKED_WINDOW" \
    "sh -c 'while :; do sleep 86400; done'" 2>/dev/null || return 1
  local pid
  pid=$({ tmux list-panes -t "$SESSION:$PARKED_WINDOW" -F '#{pane_id}' 2>/dev/null | head -1; } || true)
  [[ -z "$pid" ]] && return 1
  tmux set-option -p -t "$pid" @llmux_parked_anchor "1"
  tmux set-option -p -t "$pid" @llmux_name "" 2>/dev/null || true
}

park_pane() {
  local pane="$1" anchor
  [[ -z "$pane" ]] && return 0
  ensure_parked_window || return 1
  anchor=$(get_parked_anchor)
  [[ -z "$anchor" ]] && return 1

  local win
  win=$(tmux display-message -p -t "$anchor" '#{window_index}' 2>/dev/null || true)

  # -d: don't follow the pane into the holding window.
  #
  # The retry matters: join-pane needs room for a new pane, and the holding
  # window keeps whatever layout the previous joins left behind. Past ~5 parked
  # threads the default layout runs out of space and the join fails, which
  # strands the thread in window 0 alongside the incoming one. Re-tiling
  # reclaims the space, so tile after every join and once more before giving up.
  if ! tmux join-pane -d -s "$pane" -t "$anchor" 2>/dev/null; then
    if [[ -n "$win" ]]; then
      tmux select-layout -t "$SESSION:$win" tiled 2>/dev/null || true
    fi
    tmux join-pane -d -s "$pane" -t "$anchor" 2>/dev/null || return 1
  fi
  if [[ -n "$win" ]]; then
    tmux select-layout -t "$SESSION:$win" tiled 2>/dev/null || true
  fi
  return 0
}

# Emit the PR rows the sidebar should draw, grouped and filtered, one per line:
#   project<TAB>kind<TAB>label<TAB>target
# kind is `stack` (a collapsible header, target = its toggle key), `pr` (a
# standalone PR, target = url) or `member` (a PR inside an expanded stack).
#
# Grouping is two-tier because stacks arrive two ways. An agent that knows it built
# a stack passes `--stack "<title>"` and that title wins. When nobody said so, a
# chain is still inferable for free from base/branch: PR B whose base IS PR A's
# head branch sits on top of A, which is exactly how `gt` stacks look to GitHub —
# so a 4-PR chain groups itself without any agent cooperating.
#
# Python, not bash: this needs a real graph walk over the chain edges plus a sort,
# and the same structured-data reasons the harvesters use python apply here.
build_pr_rows() {
  # Taken as args when the caller already read them (render_sidebar needs both for
  # its cache signature), so this doesn't repeat two tmux round-trips per paint.
  local blob="${1-}" expanded="${2-}"
  if [[ $# -lt 2 ]]; then
    blob=$(tmux show-option -t "$SESSION" -qv @llmux_prs_state 2>/dev/null || true)
    expanded=$(tmux show-option -t "$SESSION" -qv @llmux_pr_expanded 2>/dev/null || true)
  fi
  python3 -c "$PY_PAUSED_IO"'
import sys, time
path, blob, expanded, stale_days = sys.argv[1], sys.argv[2], sys.argv[3], int(sys.argv[4])
link_mode = sys.argv[5]

def link_for(p):
    # Derived from repo + number rather than stored, so the 10 PRs registered before
    # this existed switch over with no migration — and flipping LLMUX_PR_LINK takes
    # effect on the next repaint instead of needing every row re-registered.
    if link_mode == "graphite" and p.get("repo") and p.get("number"):
        return "https://app.graphite.dev/github/pr/%s/%s" % (p["repo"], p["number"])
    return p.get("url", "")

state = {}
for chunk in filter(None, blob.split(";")):
    k, _, v = chunk.partition("=")
    parts = v.split(",")
    if len(parts) == 3:
        state[k] = (parts[0], parts[1] == "1", int(parts[2] or 0))

open_keys = set(filter(None, expanded.split(",")))
now = int(time.time())
cutoff = now - stale_days * 86400

prs = []
for p in _load(path)["prs"]:
    key = "%s#%s" % (p.get("repo",""), p.get("number",""))
    st = state.get(key)
    # No cached state yet (first run after registering, or a cold session) shows the
    # row rather than hiding it: a PR an agent JUST registered must appear at once,
    # and the refresher corrects it within a tick.
    if st is not None:
        if st[0] != "OPEN":
            continue
        if st[2] and st[2] < cutoff:
            continue
    p["_key"] = key
    p["_draft"] = st[1] if st else False
    p["_updated"] = st[2] if st else now
    prs.append(p)

by_project = {}
for p in prs:
    by_project.setdefault(p.get("project") or "", []).append(p)

def label_for(p):
    t = p.get("title") or ""
    return ("#%s %s" % (p.get("number"), t)).strip()

out = []
for project, items in by_project.items():
    groups, singles = {}, []
    # Explicit --stack wins.
    for p in items:
        s = (p.get("stack") or "").strip()
        if s:
            groups.setdefault(s, []).append(p)
        else:
            singles.append(p)
    # Infer chains among whatever is left, by base -> head edges.
    heads = {p.get("branch"): p for p in singles if p.get("branch")}
    parent = {}
    for p in singles:
        b = p.get("base")
        if b in heads and heads[b] is not p:
            parent[p["_key"]] = heads[b]["_key"]
    if parent:
        by_key = {p["_key"]: p for p in singles}
        roots = [k for k in by_key if k not in parent]
        children = {}
        for k, par in parent.items():
            children.setdefault(par, []).append(k)
        claimed = set()
        for r in roots:
            chain, stack_q = [], [r]
            while stack_q:
                k = stack_q.pop(0)
                chain.append(k)
                stack_q.extend(sorted(children.get(k, [])))
            if len(chain) > 1:
                # Title an inferred stack after its bottom PR — the one whose base is
                # main. That is the change the rest of the chain builds on, so it is
                # the name a human recognises the stack by.
                name = by_key[r].get("title") or "#%s" % by_key[r].get("number")
                groups[name] = [by_key[k] for k in chain]
                claimed.update(chain)
        singles = [p for p in singles if p["_key"] not in claimed]

    for name, members in sorted(groups.items()):
        members.sort(key=lambda p: int(p.get("number") or 0))
        # Hashed, not the literal "project/title": both the prmap and the
        # expanded-set option are comma-separated, and an inferred stack is titled
        # from a PR title — which routinely contains commas. A raw key would split
        # mid-name and silently mis-resolve every row after it.
        import hashlib
        gkey = hashlib.md5(("%s/%s" % (project, name)).encode()).hexdigest()[:10]
        is_open = gkey in open_keys
        out.append((project, "stack", "%s\t%s\t%d\t%d" %
                    (name, gkey, len(members), 1 if is_open else 0)))
        if is_open:
            for m in members:
                out.append((project, "member", "%s\t%s" % (label_for(m), link_for(m))))
    for p in sorted(singles, key=lambda p: -int(p.get("_updated") or 0)):
        out.append((project, "pr", "%s\t%s" % (label_for(p), link_for(p))))

for project, kind, rest in out:
    print("%s\t%s\t%s" % (project, kind, rest))
' "$PAUSED_FILE" "$blob" "$expanded" "$PR_STALE_DAYS" "$PR_LINK"
}

# Draw the thread list, grouped into sections. Row geometry here is the contract
# sidebar_click() depends on — and with section headings and spacers in the mix
# it is no longer "chrome rows then one row per thread", so the row map is keyed
# by ABSOLUTE pane row rather than by an offset the click handler recomputes.
# Every line appended to $out must bump $row exactly once.
render_sidebar() {
  local sb
  sb=$(get_sidebar_pane)
  [[ -z "$sb" ]] && return 0

  local active
  active=$(get_active_thread_pane)

  # The pane's ACTUAL width, not the SIDEBAR_WIDTH constant — that is only the width
  # the pane was CREATED at, so every text budget derived from it kept cutting names
  # short after a resize instead of showing what now fits.
  local sb_w
  sb_w=$(tmux display-message -p -t "$sb" '#{pane_width}' 2>/dev/null || true)
  [[ "$sb_w" =~ ^[0-9]+$ ]] || sb_w="$SIDEBAR_WIDTH"
  # Treat the width the pane is actually at as the width you want, so dragging the
  # divider is all it takes to change it — and sidebar_apply_layout restores that
  # instead of the constant on the next switch.
  #
  # ONLY while the sidebar is sharing its window with a thread. Removing the visible
  # thread leaves the sidebar briefly alone, and tmux stretches it to the full window;
  # recording THAT as intent meant the next switch restored a full-width sidebar and
  # squeezed the incoming thread to a single column. A width measured with nothing
  # beside it is an artefact of the layout, not a choice anyone made.
  local sb_win npanes want_w
  sb_win=$(tmux display-message -p -t "$sb" '#{window_index}' 2>/dev/null || true)
  npanes=$({ tmux list-panes -t "$SESSION:${sb_win:-0}" -F x 2>/dev/null | wc -l | tr -d ' '; } || echo 1)
  if [[ "$npanes" -gt 1 ]]; then
    want_w=$(tmux show-option -t "$SESSION" -qv @llmux_sidebar_width 2>/dev/null || true)
    [[ "$want_w" == "$sb_w" ]] || \
      tmux set-option -t "$SESSION" @llmux_sidebar_width "$sb_w" 2>/dev/null || true
  fi

  # Tally the states that mean "a thread has stopped and needs you" BEFORE drawing,
  # so the title row can carry the count. Without it, a blocked thread below the
  # fold — or one whose section you aren't looking at — announces itself nowhere.
  # list_threads spawns tmux + awk + sort, and it used to run TWICE per paint: once
  # for this tally and again for the draw snapshot. Snapshot once, count off the
  # snapshot.
  local threads_snap=() tline
  while IFS= read -r tline; do
    [[ -n "$tline" ]] && threads_snap+=("$tline")
  done < <(list_threads)

  local n_blocked=0 n_perm=0 st
  for tline in ${threads_snap[@]+"${threads_snap[@]}"}; do
    # Inline parameter expansion, not $(cut_field4 …) — a command substitution is a
    # fork, which is the exact cost this loop is trying to avoid.
    st="${tline#*|}"; st="${st#*|}"; st="${st#*|}"; st="${st%%|*}"
    case "$st" in
      blocked) ((n_blocked++)) ;;
      perm)    ((n_perm++)) ;;
    esac
  done

  local out=""
  # Two columns short of SIDEBAR_RULE_WIDTH: the rule stops, then a space, then
  # the "+" lands exactly in SIDEBAR_PLUS_COL — where every section rule also
  # ends, so the whole column lines up.
  local rule="" ri=0
  while (( ri < SIDEBAR_PLUS_COL - 2 )); do rule+="─"; ((ri++)); done
  local title=$' \033[1;38;5;39mllmux threads\033[0m'
  # Blocked counts ride on the title row, bold, in the alert colour.
  (( n_blocked )) && title+="  \033[1;38;5;220m🙋${n_blocked}\033[0m"
  (( n_perm ))    && title+="  \033[1;38;5;203m🔐${n_perm}\033[0m"
  out+="${title}"$'\n'
  # The rule row carries the sidebar's single "+" — one affordance for "new
  # thread", which then asks which platform (claude by default). It sits here
  # rather than on the title row because the blocked/perm counts above can grow
  # into SIDEBAR_PLUS_COL and would collide with the hotspot.
  out+=" \033[38;5;240m${rule}\033[0m \033[1;38;5;39m+\033[0m"$'\n'
  local row="$SIDEBAR_HEADER_LINES"   # absolute pane row of the next line drawn

  # Snapshot the threads once, numbering them in list_threads order. The number
  # is assigned HERE rather than while drawing, so it keeps matching
  # `llmux switch <n>` / prefix+<n> no matter how the sections are laid out.
  # list_threads already sorts by section, so walking the registry below emits
  # them in this same sequence.
  local lines=() pane_id name tool status win is_term group
  local idx=0
  for tline in ${threads_snap[@]+"${threads_snap[@]}"}; do
    IFS='|' read -r pane_id name tool status win is_term group <<< "$tline"
    [[ -z "$pane_id" ]] && continue
    ((idx++))
    lines+=("${idx}|${pane_id}|${name}|${tool}|${status}|${is_term}|${group}")
  done

  # Two maps, both published with the pixels below:
  #
  # rowmap  "row:pane_id" — the thread drawn on each absolute pane row.
  #         sidebar_click resolves a click against THIS snapshot rather than
  #         recomputing list_threads, so a click always lands on the thread you
  #         actually see. Without it the two recompute independently and diverge
  #         the instant list order changes (e.g. `llmux top`) or the render loop
  #         stalls — you click one row, switch another.
  # addmap  "row:target" — the "+" hotspots. "*" means "ask which project";
  #         anything else is a project key to add straight into. Only fires for a
  #         click in SIDEBAR_PLUS_COL, so the rest of the row stays inert.
  #
  # Absolute rows mean spacers and headings appear in neither map, so clicking
  # them is a no-op for free.
  local rowmap="" addmap="1:*," prmap="" linkmap=""
  local key meta label gcolour drawn=0 entry eidx

  # PR rows, precomputed per project so the draw loop below stays a straight walk.
  # Each element: "project<TAB>kind<TAB>label<TAB>url<TAB>extra" where kind is
  # `pr` or `stack`. Built once because grouping needs to see every PR at once.
  # ONE python3 invocation, not two. The old emptiness guard called read_prs purely
  # to ask "are there any?" and then build_pr_rows asked again — and a python3 start
  # is ~95ms, so that guard cost more than the work it was trying to skip. An empty
  # registry now costs one interpreter start instead of two, and a non-empty one
  # costs one instead of two.
  # Cached behind a cheap signature. build_pr_rows costs one python3 start (~140ms
  # under load) and the paint runs every 2s, but its inputs change only when a PR is
  # registered (file mtime), when llmux-watch refreshes state (the blob), or when a
  # stack is toggled (the expanded set) — so recomputing every tick was most of the
  # paint's wall time spent re-deriving an identical answer.
  #
  # The minute bucket is what makes staleness still work: PR_STALE_DAYS is evaluated
  # against "now", so without it a PR crossing the 14-day line would keep drawing
  # until something else invalidated the cache.
  # now_ts and the paused.json mtime are read ONCE and shared by both cache
  # signatures and the done-age column below. Each was its own fork, and a fork is
  # 5-50ms in a paint that runs every 2s -- the cost the caching exists to avoid.
  local now_ts paused_mtime
  now_ts=$(date +%s)
  paused_mtime=$({ stat -f %m "$PAUSED_FILE" 2>/dev/null || echo 0; })

  local pr_blob pr_exp pr_sig pr_sig_old pr_raw
  pr_blob=$(tmux show-option -t "$SESSION" -qv @llmux_prs_state 2>/dev/null || true)
  pr_exp=$(tmux show-option -t "$SESSION" -qv @llmux_pr_expanded 2>/dev/null || true)
  pr_sig="${paused_mtime}|${pr_blob}|${pr_exp}|$(( now_ts / 60 ))"
  pr_sig_old=$(tmux show-option -t "$SESSION" -qv @llmux_pr_rows_sig 2>/dev/null || true)
  if [[ -n "$pr_sig_old" && "$pr_sig_old" == "$pr_sig" ]]; then
    pr_raw=$(tmux show-option -t "$SESSION" -qv @llmux_pr_rows 2>/dev/null || true)
  else
    pr_raw=$(build_pr_rows "$pr_blob" "$pr_exp")
    tmux set-option -t "$SESSION" @llmux_pr_rows "$pr_raw" 2>/dev/null || true
    tmux set-option -t "$SESSION" @llmux_pr_rows_sig "$pr_sig" 2>/dev/null || true
  fi

  # One read per paint for all three kinds of project link; a project without one
  # simply has no entry. The maps keep the field layouts the readers used, so the
  # awk lookups below are unchanged by the merge.
  local mon_map="" flag_map="" forge_map="" linkline
  while IFS= read -r linkline; do
    case "$linkline" in
      m$'\t'*) mon_map+="${linkline#m$'\t'}"$'\n' ;;
      g$'\t'*) forge_map+="${linkline#g$'\t'}"$'\n' ;;
      f$'\t'*) flag_map+="${linkline#f$'\t'}"$'\n' ;;
    esac
  done < <(read_project_links)

  # The sections are collected up front rather than streamed into the draw loop:
  # build_review_rows has to know which project keys exist before the first one is
  # drawn, so it can file an entry that matches none of them under SCRATCH.
  local sections=() skey
  while IFS= read -r skey; do
    [[ -n "$skey" ]] && sections+=("$skey")
  done < <(project_sections)
  local sect_csv=""
  for skey in ${sections[@]+"${sections[@]}"}; do sect_csv+="${skey},"; done
  sect_csv="${sect_csv%,}"

  # Same cache shape as the PR rows, for the same reason: one python3 start (~140ms)
  # against a paint that runs every 2s. An HOUR bucket, not a minute one — the only
  # time-dependent decision here is dropping a doc approved more than
  # REVIEW_KEEP_HOURS ago, which no one is watching to the minute.
  local rev_sig rev_sig_old rev_raw
  # mtime AND size for the queue file: `llmux review done` invalidates explicitly,
  # but Jay drains with `reviewq review` — which llmux never sees. stat reports mtime
  # in whole seconds, so a drain landing in the same second a paint sampled it would
  # leave the signature identical and the 👀 would stay on screen after he cleared it.
  # Resolving an entry always changes the file's length ("pending" → "done", plus a
  # resolved_at stamp), so the size catches what the second-resolution mtime cannot.
  rev_sig="$({ stat -f '%m.%z' "$REVIEW_FILE" 2>/dev/null || echo 0; })|${paused_mtime}|${sect_csv}|$(( now_ts / 3600 ))"
  rev_sig_old=$(tmux show-option -t "$SESSION" -qv @llmux_review_rows_sig 2>/dev/null || true)
  if [[ -n "$rev_sig_old" && "$rev_sig_old" == "$rev_sig" ]]; then
    rev_raw=$(tmux show-option -t "$SESSION" -qv @llmux_review_rows 2>/dev/null || true)
  else
    rev_raw=$(build_review_rows "$sect_csv")
    tmux set-option -t "$SESSION" @llmux_review_rows "$rev_raw" 2>/dev/null || true
    tmux set-option -t "$SESSION" @llmux_review_rows_sig "$rev_sig" 2>/dev/null || true
  fi
  local forge_rows=() forgeline
  while IFS= read -r forgeline; do
    [[ -n "$forgeline" ]] && forge_rows+=("$forgeline")
  done <<< "$forge_map"

  local rev_rows=() revline
  while IFS= read -r revline; do
    [[ -n "$revline" ]] && rev_rows+=("$revline")
  done <<< "$rev_raw"

  local pr_rows=() prline
  while IFS= read -r prline; do
    [[ -n "$prline" ]] && pr_rows+=("$prline")
  done <<< "$pr_raw"

  # Kept out of list_threads on purpose: its positional field contract has a dozen
  # read sites of varying arity, and widening it would touch every one.
  local done_map codex_parent_map codex_agents_raw codex_agents_at
  done_map=$({ tmux list-panes -s -t "$SESSION" -F '#{pane_id}|#{@llmux_done_at}' 2>/dev/null; } || true)
  codex_parent_map=$({ tmux list-panes -s -t "$SESSION" -F '#{pane_id}|#{@llmux_codex_session}' 2>/dev/null; } || true)
  codex_agents_raw=$(tmux show-option -t "$SESSION" -qv @llmux_codex_agents 2>/dev/null || true)
  codex_agents_at=$(tmux show-option -t "$SESSION" -qv @llmux_codex_agents_at 2>/dev/null || true)
  if [[ -n "$codex_agents_raw" ]] \
     && { [[ ! "$codex_agents_at" =~ ^[0-9]+$ ]] || (( now_ts - codex_agents_at > 15 )); }; then
    codex_agents_raw=""
  fi
  for key in ${sections[@]+"${sections[@]}"}; do
    [[ -z "$key" ]] && continue
    project_meta "$key" >/dev/null; meta="$R_PROJECT_META"
    label="${meta%%|*}"
    gcolour="${meta##*|}"

    # Count this section's threads first. SCRATCH is always drawn — it is where
    # new threads land, so seeing it empty is the point. A project with no live
    # threads has, by definition, stopped existing and is skipped.
    local n=0
    for entry in ${lines[@]+"${lines[@]}"}; do
      [[ "${entry##*|}" == "$key" ]] && ((n++))
    done
    # …unless a doc is still waiting on Jay, or a Forge task is still running. The
    # thread that queued the doc has usually finished and gone by the time he looks,
    # and a Forge task outliving every local thread is the normal case, not an odd
    # one — dropping the section would take both with it, leaving llmux showing
    # something nobody can see.
    if (( n == 0 )) && [[ "$key" != "$SCRATCH_KEY" ]]; then
      local has_extra=0 rv
      for rv in ${rev_rows[@]+"${rev_rows[@]}"}; do
        [[ "${rv%%$'\t'*}" == "$key" ]] && { has_extra=1; break; }
      done
      if (( ! has_extra )); then
        for rv in ${forge_rows[@]+"${forge_rows[@]}"}; do
          [[ "${rv%%$'\t'*}" == "$key" ]] && { has_extra=1; break; }
        done
      fi
      (( has_extra )) || continue
    fi

    # Spacer between sections, never above the first drawn one.
    if (( drawn )); then
      out+=$'\n'
      ((row++))
    fi
    drawn=1
    sidebar_section_header "$key" 0 >/dev/null
    out+="${R_SECTION_HEADER}"$'\n'
    ((row++))

    # Links get their OWN row under the heading rather than sharing it. Inline, a
    # 20-character project name plus "(Monitor) (Flag)" cannot fit 30 columns, and
    # the loser is always the thing you wanted to click. A dedicated row spills
    # once, deliberately, instead of fighting for width on every project.
    local mon_url="" flg_url=""
    if [[ -n "$mon_map" ]]; then
      mon_url=$(printf '%s' "$mon_map" | awk -F'\t' -v k="$key" '$1==k {print $2; exit}')
    fi
    if [[ -n "$flag_map" ]]; then
      flg_url=$(printf '%s' "$flag_map" | awk -F'\t' -v k="$key" '$1==k {print $4; exit}')
    fi
    if [[ -n "$mon_url" || -n "$flg_url" ]]; then
      local lrow="" lcol=2
      out+="  "
      if [[ -n "$mon_url" ]]; then
        out+="\033[4;38;5;${gcolour}m(Monitor)\033[0m"
        linkmap+="${row}:${lcol}:$(( lcol + 8 )):${mon_url}"$'\n'
        lcol=$(( lcol + 10 )); out+=" "
      fi
      # Every flag the project carries, until the row runs out. A stub of four or
      # fewer characters identifies nothing and cannot be aimed at, so stop rather
      # than draw one.
      local fl_name fl_url first_flag=1
      while IFS=$'\t' read -r fl_name fl_url; do
        [[ -z "$fl_url" ]] && continue
        (( sb_w - lcol < 5 )) && break
        if (( ! first_flag )); then out+=" "; lcol=$(( lcol + 1 )); fi
        (( sb_w - lcol < 5 )) && break
        flag_label "$fl_name" $(( sb_w - lcol ))
        [[ -z "$R_FLAG_LABEL" ]] && break
        out+="\033[4;38;5;${gcolour}m${R_FLAG_LABEL}\033[0m"
        linkmap+="${row}:${lcol}:$(( lcol + ${#R_FLAG_LABEL} - 1 )):${fl_url}"$'\n'
        lcol=$(( lcol + ${#R_FLAG_LABEL} ))
        first_flag=0
      done < <(printf '%s' "$flag_map" | awk -F'\t' -v k="$key" '$1==k {print $2"\t"$4}')
      out+=$'\n'
      ((row++))
    fi

    # Docs awaiting review, ABOVE the threads. A doc Jay hasn't signed off on is
    # usually the thing holding its project up, so it reads before the work it is
    # holding up — the inverse of PR rows, which record what already shipped.
    #
    # 👀 is the whole signal: it means "this wants your eyes". The moment the entry
    # resolves the emoji goes and the row dims to a plain link, so the section
    # answers "is anything waiting on me" from the glyphs alone.
    local rev_entry r_proj r_id r_state r_title r_url
    for rev_entry in ${rev_rows[@]+"${rev_rows[@]}"}; do
      IFS=$'\t' read -r r_proj r_id r_state r_title r_url <<< "$rev_entry"
      [[ "$r_proj" == "$key" ]] || continue
      local r_glyph="  " r_col="38;5;250" r_ind=" "
      if [[ "$r_state" == "pending" ]]; then
        r_glyph="👀"; r_col="1;38;5;220"
      fi
      # An emoji is two columns; the resolved row pads to the same two so both
      # kinds of row start their text in the same place and the column reads as
      # one list rather than two ragged ones.
      local r_w=$(( sb_w - 4 ))
      (( r_w < 4 )) && r_w=4
      local r_label="${r_title:0:r_w}"
      out+=" ${r_glyph} \033[${r_col}m${r_label}\033[0m"$'\n'
      # Column-scoped like the Monitor/flag links, and on linkmap rather than
      # prmap: prmap is comma-separated and a doc URL is not guaranteed comma-free.
      [[ -n "$r_url" ]] && linkmap+="${row}:4:$(( 4 + ${#r_label} - 1 )):${r_url}"$'\n'
      ((row++))
    done

    # Forge tasks: ONE ROW EACH, directly above the threads. They shared the links
    # row with (Monitor) and the flags at first, and that row cannot carry them — a
    # project with a monitor, two flags and two tasks ran off the right edge, and
    # what got pushed off was whatever came last. A task also has a human-written
    # name that wants room, unlike a flag whose label is a fixed identifier.
    #
    # Last before the threads on purpose: this is the same axis as a thread — work
    # in progress, one line per piece — so the two read as one list, with the tasks
    # that llmux cannot switch to sitting just above the ones it can.
    local fg_entry fg_proj fg_url fg_title
    for fg_entry in ${forge_rows[@]+"${forge_rows[@]}"}; do
      IFS=$'\t' read -r fg_proj fg_url fg_title <<< "$fg_entry"
      [[ "$fg_proj" == "$key" ]] || continue
      # Same geometry as a PR row (" ⌥ label"): glyph at column 1, label at 3. The
      # kinds then line up down the section instead of each starting somewhere new.
      forge_label "$fg_title" $(( sb_w - 3 ))
      out+=" \033[1;38;5;${FORGE_COLOUR}m⚒\033[0m \033[4;38;5;${FORGE_COLOUR}m${R_FORGE_LABEL}\033[0m"$'\n'
      # Hotspot spans the glyph too: one column is not a thing anyone should have to
      # aim at, and nothing else on this row competes for the click.
      linkmap+="${row}:1:$(( 3 + ${#R_FORGE_LABEL} - 1 )):${fg_url}"$'\n'
      ((row++))
    done

    for entry in ${lines[@]+"${lines[@]}"}; do
      [[ "${entry##*|}" == "$key" ]] || continue
      IFS='|' read -r eidx pane_id name tool status is_term group <<< "$entry"

      # The row number doubles as the prefix+<n> shortcut, so it is shown even
      # past 9 (where no binding exists) to keep numbering aligned with
      # `llmux switch <index>`.
      #
      # Colour split — TWO independent axes on one row:
      #   glyph            → the PLATFORM's colour (claude orange, codex cyan, …)
      #   number + name    → the PROJECT's colour (unique per project)
      # So "what is this" and "which work is this" are readable separately, and
      # neither has to be looked up in a legend.
      #
      # Names used to stay grey until active, on the theory that colouring them all
      # would drown the selection. With every name now tinted, the selection is
      # carried by BOLD plus the ▶ marker instead — the marker is why that still
      # reads at a glance.
      local tcolour marker=" "
      tool_colour "$tool" "$is_term" >/dev/null; tcolour="$R_TOOL_COLOUR"
      local name_col="\033[38;5;${gcolour}m" idx_col="\033[38;5;${gcolour}m"
      local icon_col="\033[38;5;${tcolour}m"
      if [[ "$pane_id" == "$active" ]]; then
        marker="▶"
        name_col="\033[1;38;5;${gcolour}m"
        idx_col="\033[1;38;5;${gcolour}m"
        icon_col="\033[1;38;5;${tcolour}m"
      fi

      # Status flag, plus an alert tint for the states that mean "stopped, needs
      # you". The tint overrides the section colour on purpose: a thread waiting on
      # an answer has to win the eye against eleven that aren't, and the ▶ marker
      # still distinguishes which one is on screen.
      local smeta semoji scolour flag=""
      status_meta "$status" >/dev/null; smeta="$R_STATUS_META"
      semoji="${smeta%%|*}"
      scolour="${smeta#*|}"; scolour="${scolour%%|*}"
      if [[ -n "$semoji" ]]; then
        flag=" \033[1;38;5;${scolour}m${semoji}\033[0m"
        if [[ "$status" == "blocked" || "$status" == "perm" ]]; then
          name_col="\033[1;38;5;${scolour}m"
          marker="${marker/ /·}"
        fi
      fi
      local icon
      thread_icon "$tool" "$is_term" >/dev/null; icon="$R_THREAD_ICON"

      # Only when no status flag is drawn: a stale stamp can outlive an
      # idle→blocked escalation, and the louder state wins the row.
      local age_txt="" fade=""
      if [[ -z "$semoji" ]]; then
        local done_at=""
        [[ "$done_map" =~ (^|$'\n')"${pane_id}"\|([0-9]+) ]] && done_at="${BASH_REMATCH[2]}"
        if [[ -n "$done_at" && "$done_at" != "0" ]] && (( now_ts >= done_at )); then
          fmt_age_short $(( now_ts - done_at )) >/dev/null; age_txt="$R_AGE"
          done_fade_colour $(( now_ts - done_at )) >/dev/null; fade="$R_FADE"
        fi
      fi

      # Names are cut to what the pane can ACTUALLY show, never to a fixed cap. The
      # budget exists only to stop a row wrapping — a wrapped row occupies two pane
      # rows while rowmap counts one, and every click below it then resolves to the
      # wrong thread. Anything narrower than that is hiding text for no reason: widen
      # the sidebar and the names get longer on the next repaint.
      local prefix_w=$(( 1 + ${#eidx} + 1 + 1 + 1 ))   # marker, index, sp, icon, sp
      # A status emoji is TWO columns plus its leading space. Unbudgeted it used to
      # fit only because names were capped at 18; with names free to fill the pane a
      # flagged row would be the one that overflows.
      local flag_w=0
      [[ -n "$semoji" ]] && flag_w=3
      local age_w=0
      [[ -n "$age_txt" ]] && age_w=$(( 3 + ${#age_txt} ))   # sp, dot, sp, text
      local name_w=$(( sb_w - prefix_w - flag_w - age_w ))
      if (( name_w < 6 )) && (( age_w > 0 )); then
        # Too narrow to say both: the name is what identifies the row, so the age goes.
        age_txt=""; age_w=0
        name_w=$(( sb_w - prefix_w - flag_w ))
      fi
      (( name_w < 1 )) && name_w=1
      local tlabel="${name:0:name_w}"
      # Pad only when something is right-aligned after it, so the age column lines up.
      (( age_w > 0 )) && printf -v tlabel '%-*s' "$name_w" "$tlabel"
      # No tool name on the row: sections group by project now, so the glyph is
      # what says which platform this is — and it does that in one column, in the
      # platform's colour. The marker takes the project colour with the number and
      # name: it marks WHICH THREAD is selected, which is the same axis.
      out+="${idx_col}${marker}\033[0m${idx_col}${eidx}\033[0m ${icon_col}${icon}\033[0m ${name_col}${tlabel}\033[0m"
      [[ -n "$age_txt" ]] && out+=" \033[38;5;${fade}m● ${age_txt}\033[0m"
      out+="${flag}"$'\n'
      rowmap+="${row}:${pane_id},"
      ((row++))

      # Codex sub-agents are derived child rows, not threads: they have no pane,
      # cannot be switched to, and therefore never enter rowmap. The watcher
      # publishes only agents whose latest lifecycle event is task_started.
      # Still bump the absolute row for each one so every clickable row below it
      # keeps resolving against the pixels that were actually drawn.
      if [[ "$tool" == "codex" && -n "$codex_agents_raw" ]]; then
        local codex_sid="" cpane csid
        while IFS='|' read -r cpane csid; do
          if [[ "$cpane" == "$pane_id" ]]; then
            codex_sid="$csid"
            break
          fi
        done <<< "$codex_parent_map"

        if [[ -n "$codex_sid" ]]; then
          local agent_root agent_depth agent_nickname agent_path
          while IFS='|' read -r agent_root agent_depth agent_nickname agent_path; do
            [[ "$agent_root" == "$codex_sid" ]] || continue
            [[ "$agent_depth" =~ ^[0-9]+$ ]] || agent_depth=1
            local agent_indent=$(( 1 + agent_depth * 2 ))
            (( agent_indent > 7 )) && agent_indent=7
            local agent_prefix="" ai=0
            while (( ai < agent_indent )); do agent_prefix+=" "; ((ai++)); done
            agent_prefix+="↳ "

            local agent_task="${agent_path##*/}"
            [[ -z "$agent_task" ]] && agent_task="${agent_nickname:-sub-agent}"
            local agent_tail=""
            [[ -n "$agent_nickname" && "$agent_nickname" != "$agent_task" ]] \
              && agent_tail=" · ${agent_nickname}"
            local agent_w=$(( sb_w - ${#agent_prefix} ))
            (( agent_w < 1 )) && agent_w=1
            local agent_label="$agent_task"
            if (( ${#agent_task} + ${#agent_tail} <= agent_w )); then
              agent_label+="$agent_tail"
            fi
            agent_label="${agent_label:0:agent_w}"
            out+="${agent_prefix%↳ }\033[38;5;44m↳\033[0m \033[38;5;245m${agent_label}\033[0m"$'\n'
            ((row++))
          done <<< "$codex_agents_raw"
        fi
      fi
    done

    # PR rows close each project section, below its threads: the threads are what
    # you act in, the PRs are what that work has already produced.
    local pr_entry p_proj p_kind p_rest
    for pr_entry in ${pr_rows[@]+"${pr_rows[@]}"}; do
      IFS=$'\t' read -r p_proj p_kind p_rest <<< "$pr_entry"
      [[ "$p_proj" == "$key" ]] || continue
      case "$p_kind" in
        stack)
          local s_name s_key s_count s_open marker_g
          IFS=$'\t' read -r s_name s_key s_count s_open <<< "$p_rest"
          # ▾ open / ▸ closed, with the member count — a stack reads as one item
          # until you ask for it, which is the whole point of grouping.
          marker_g="▸"; [[ "$s_open" == "1" ]] && marker_g="▾"
          local tail=" ${marker_g}${s_count}"
          local namew=$(( sb_w - 3 - ${#tail} ))
          (( namew < 4 )) && namew=4
          local sl
          printf -v sl '%-*s' "$namew" "${s_name:0:namew}"
          out+=" \033[38;5;${gcolour}m⌥\033[0m \033[38;5;250m${sl}\033[0m\033[38;5;244m${tail}\033[0m"$'\n'
          prmap+="${row}:toggle:${s_key},"
          ((row++))
          ;;
        pr|member)
          local p_label p_url indent="" lw
          IFS=$'\t' read -r p_label p_url <<< "$p_rest"
          [[ "$p_kind" == "member" ]] && indent="  "
          lw=$(( sb_w - 3 - ${#indent} ))
          (( lw < 4 )) && lw=4
          out+="${indent} \033[38;5;${gcolour}m⌥\033[0m \033[38;5;250m${p_label:0:lw}\033[0m"$'\n'
          prmap+="${row}:open:${p_url},"
          ((row++))
          ;;
      esac
    done
  done

  out+=$'\n\033[38;5;240m click a row, + to add\n prefix j/k  next/prev\n prefix M    move project\n prefix 1-9  jump\033[0m\n'

  # Publish both maps together with the pixels. Set them right before the draw so
  # the mapping the click handler reads can never be newer than what's on screen.
  tmux set-option -t "$SESSION" @llmux_sidebar_rowmap "${rowmap%,}" 2>/dev/null || true
  tmux set-option -t "$SESSION" @llmux_sidebar_addmap "${addmap%,}" 2>/dev/null || true
  # Same contract as rowmap, for the same reason: a PR row's identity is published
  # in the call that paints it, so a click can never resolve against an order the
  # pixels no longer show.
  tmux set-option -t "$SESSION" @llmux_sidebar_prmap "${prmap%,}" 2>/dev/null || true
  tmux set-option -t "$SESSION" @llmux_sidebar_linkmap "$linkmap" 2>/dev/null || true

  # respawn-pane would kill the loop; write straight into the pane instead.
  tmux send-keys -t "$sb" "" 2>/dev/null || true
  # \033[?7l turns autowrap OFF for the pane: anything past the right margin is
  # discarded by the terminal instead of continuing onto the next line. The width
  # budgets above already prevent that, so this is a belt — but it is the belt that
  # matters, because the failure it prevents (a wrapped row desyncing rowmap, so
  # clicks land on the wrong thread) is silent and confusing.
  #
  # \033[3J erases the scrollback. tmux treats \033[2J the way a shell's `clear`
  # wants it treated — the erased frame is pushed into history so you can scroll
  # back to it — so repainting every 2s buried the pane under stale copies of
  # itself and pinned it at history-limit within the hour. There is nothing worth
  # scrolling back to here: the pane shows current state and nothing else.
  printf '\033[H\033[2J\033[3J\033[?7l%b' "$out" > "$(tmux display-message -p -t "$sb" '#{pane_tty}')" 2>/dev/null || true
}

# Runs inside the sidebar pane. Polls so llmux-watch's @llmux_status changes
# (the status flags) show up without anything having to notify us.
sidebar_loop() {
  printf '\033[?25l'   # hide cursor; this pane is a display, not an input
  trap 'printf "\033[?25h\033[?7h"' EXIT

  # Single-writer guard. Two render loops painting the same pane is the bug that
  # actually bit: each repaints every 2s from its own list_threads read, so one
  # can write pixels for order A while the other publishes a rowmap for order B —
  # and a click then resolves against a row the pixels no longer show. Claiming
  # ownership (newest loop wins) and exiting NON-ZERO when a newer loop takes over
  # lets the wrapper (`... || break`) retire the loser for good, so at most one
  # loop ever paints.
  local me="$$"
  tmux set-option -t "$SESSION" @llmux_sidebar_loop_pid "$me" 2>/dev/null || true
  while tmux has-session -t "$SESSION" 2>/dev/null; do
    local owner
    owner=$(tmux show-option -t "$SESSION" -qv @llmux_sidebar_loop_pid 2>/dev/null || true)
    if [[ -n "$owner" && "$owner" != "$me" ]]; then
      return 3   # a newer loop owns the pane now — retire (wrapper breaks on this)
    fi
    # Catches focus changes made outside llmux (prefix+o, a mouse click) without a
    # tmux hook. Before the render, so a thread can't be drawn unseen on the tick it
    # was seen.
    mark_thread_seen "$(get_active_thread_pane)"
    render_sidebar
    # Snapshot when the thread set CHANGES, not on a timer: a crash moments after
    # adding or removing a thread should still recover it, and the digest makes the
    # common case (nothing changed) free.
    _sig=$(tmux list-panes -s -t "$SESSION" -F '#{@llmux_name}|#{@llmux_project}|#{@llmux_tool}' 2>/dev/null | md5 -q 2>/dev/null || true)
    if [[ -n "$_sig" && "$_sig" != "${_snap_sig:-}" ]]; then
      _snap_sig="$_sig"
      snapshot_session
    fi
    sleep 2
  done
}

# Translate a click at pane row $1 into a thread switch. $2, when supplied, is
# the pane the click landed in — verified against the sidebar so a mis-targeted
# binding can't move threads around.
# $3 (mouse column) is LAST and optional on purpose: bindings live in the tmux
# server, so a binding registered by an older llmux still calls this with two
# args. Missing column just means the "+" hotspots don't fire — thread clicks
# keep working — instead of every click breaking until `llmux sidebar on` re-runs.
sidebar_click() {
  local y="${1:-}" clicked="${2:-}" x="${3:-}"
  [[ -z "$y" ]] && return 0
  [[ "$y" =~ ^[0-9]+$ ]] || return 0
  [[ "$x" =~ ^[0-9]+$ ]] || x=""

  # The pane id is diagnostic only — deliberately NOT a veto. The if-shell
  # condition is targeted at the clicked pane (-t=), so reaching here already
  # means the sidebar was clicked. If #{pane_id} happens to expand to the active
  # pane instead of the clicked one, vetoing on the mismatch would silently
  # reject every legitimate click — a worse failure than the one it guards.
  local sb
  sb=$(get_sidebar_pane)
  if [[ -n "${LLMUX_DEBUG_CLICK:-}" ]]; then
    local note="ok"
    [[ -n "$clicked" && "$clicked" != "$sb" ]] && note="PANE-MISMATCH(sidebar=$sb)"
    echo "$(date +%H:%M:%S) y=$y pane=$clicked $note" \
      >> "${TMPDIR:-/tmp}/llmux-click.log"
  fi

  # Debounce. A physical click can deliver more than one MouseDown, and because
  # the binding uses `run-shell -b` those land as concurrent handlers. Two
  # handlers resolving different rows will each park what the other just joined,
  # which reads as "the thread flashes in and disappears". Last-click time lives
  # in a session option rather than a file, per the no-new-state-files rule.
  local now_ms last_ms
  now_ms=$(python3 -c 'import time; print(int(time.time()*1000))' 2>/dev/null || echo 0)
  last_ms=$(tmux show-option -t "$SESSION" -qv @llmux_last_click 2>/dev/null || true)
  [[ -z "$last_ms" ]] && last_ms=0
  if [[ "$now_ms" -gt 0 ]] && (( now_ms - last_ms < 400 )); then
    if [[ -n "${LLMUX_DEBUG_CLICK:-}" ]]; then
      echo "$(date +%H:%M:%S) y=$y DEBOUNCED ($(( now_ms - last_ms ))ms)" \
        >> "${TMPDIR:-/tmp}/llmux-click.log"
    fi
    return 0
  fi
  tmux set-option -t "$SESSION" @llmux_last_click "$now_ms" 2>/dev/null || true

  # "+" hotspot first, and BEFORE the header-row guard below: the sidebar's single
  # "+" lives on the rule row, which is chrome. Only a click in (or within one
  # column of) SIDEBAR_PLUS_COL counts — clicking the rule or a section label is
  # deliberately inert, because "click the label" and "click the plus" would
  # otherwise be the same gesture with different meanings.
  if [[ -n "$x" ]] \
     && (( x + 1 >= SIDEBAR_PLUS_COL )) && (( x <= SIDEBAR_PLUS_COL + 1 )); then
    local addmap apair
    addmap=$(tmux show-option -t "$SESSION" -qv @llmux_sidebar_addmap 2>/dev/null || true)
    if [[ -n "$addmap" ]]; then
      local IFS_ADD="$IFS"
      IFS=','
      for apair in $addmap; do
        if [[ "${apair%%:*}" == "$y" ]]; then
          IFS="$IFS_ADD"
          if [[ -n "${LLMUX_DEBUG_CLICK:-}" ]]; then
            echo "$(date +%H:%M:%S) y=$y x=$x -> add (target '${apair#*:}')" \
              >> "${TMPDIR:-/tmp}/llmux-click.log"
          fi
          sidebar_add_prompt "${apair#*:}"
          return 0
        fi
      done
      IFS="$IFS_ADD"
    fi
  fi

  (( y < SIDEBAR_HEADER_LINES )) && return 0

  # Link rows (Monitor / Flag) carry no thread, so they are checked before the thread
  # maps and are column-scoped -- clicking anywhere else on the row stays inert.
  local linkmap lline l_row l_s l_e l_url
  linkmap=$(tmux show-option -t "$SESSION" -qv @llmux_sidebar_linkmap 2>/dev/null || true)
  if [[ -n "$linkmap" && -n "$x" ]]; then
    while IFS= read -r lline; do
      [[ -z "$lline" ]] && continue
      l_row="${lline%%:*}"; lline="${lline#*:}"
      l_s="${lline%%:*}";   lline="${lline#*:}"
      l_e="${lline%%:*}";   l_url="${lline#*:}"
      if [[ "$l_row" == "$y" ]] && (( x >= l_s )) && (( x <= l_e )); then
        open_url "$l_url"
        return 0
      fi
    done <<< "$linkmap"
  fi

  # PR rows first: prmap and rowmap are disjoint by construction (each row draws
  # either a thread or a PR), so order is about cost, not correctness.
  local prmap ppair
  prmap=$(tmux show-option -t "$SESSION" -qv @llmux_sidebar_prmap 2>/dev/null || true)
  if [[ -n "$prmap" ]]; then
    local IFS_PR="$IFS"
    IFS=','
    for ppair in $prmap; do
      if [[ "${ppair%%:*}" == "$y" ]]; then
        IFS="$IFS_PR"
        local pact="${ppair#*:}"
        local pkind="${pact%%:*}" pval="${pact#*:}"
        if [[ "$pkind" == "open" ]]; then
          # `open` rather than an OSC 8 hyperlink: TERM_PROGRAM is tmux inside
          # Terminal.app, which does not honour them. Backgrounded so a slow browser
          # launch never blocks the handler.
          #
          # Called directly, NOT via `tmux run-shell`: run-shell executes in the tmux
          # server's environment, which inherits whatever the server was started with
          # rather than this process's — so it is both a second environment to reason
          # about and impossible to exercise in a test.
          [[ -n "$pval" ]] && open_url "$pval"
        else
          local ex
          ex=$(tmux show-option -t "$SESSION" -qv @llmux_pr_expanded 2>/dev/null || true)
          if [[ ",${ex}," == *",${pval},"* ]]; then
            # `|| true`: collapsing the only expanded stack leaves grep with no
            # matches, and its exit 1 under `set -euo pipefail` aborts the whole
            # substitution — so the row would stay stuck open forever.
            ex=$({ printf '%s' "$ex" | tr ',' '\n' | grep -vxF "$pval" | paste -sd, -; } || true)
          else
            ex="${ex:+$ex,}$pval"
          fi
          tmux set-option -t "$SESSION" @llmux_pr_expanded "$ex" 2>/dev/null || true
          render_sidebar
        fi
        return 0
      fi
    done
    IFS="$IFS_PR"
  fi

  # Resolve the row against the map render_sidebar published for the pixels now
  # on screen — NOT a fresh list_threads, which can already have reordered. The
  # map holds "row:pane_id" for every row that actually drew a thread, keyed by
  # absolute pane row, so a click on a section heading or a spacer finds no entry
  # and correctly does nothing.
  #
  # There is deliberately NO fall-back to a computed row offset here. Sections
  # make the geometry dynamic, so any independently-derived offset is a guess
  # that can differ from what was drawn — the exact divergence the map exists to
  # eliminate. With no map (the render loop hasn't painted since this version
  # loaded) a click is a no-op for at most one poll interval.
  local name="" rowmap pair pid=""
  rowmap=$(tmux show-option -t "$SESSION" -qv @llmux_sidebar_rowmap 2>/dev/null || true)
  [[ -z "$rowmap" ]] && return 0
  local IFS_SAVE="$IFS"
  IFS=','
  for pair in $rowmap; do
    if [[ "${pair%%:*}" == "$y" ]]; then
      pid="${pair#*:}"
      break
    fi
  done
  IFS="$IFS_SAVE"
  [[ -z "$pid" ]] && return 0
  # A pane the map named may have been closed since the draw; an empty name here
  # falls through to a no-op, never a wrong switch.
  name=$(tmux display-message -p -t "$pid" '#{@llmux_name}' 2>/dev/null || true)
  [[ -z "$name" ]] && return 0

  if [[ -n "${LLMUX_DEBUG_CLICK:-}" ]]; then
    echo "$(date +%H:%M:%S) y=$y pid=$pid -> switch '$name' (pid $$)" \
      >> "${TMPDIR:-/tmp}/llmux-click.log"
  fi
  cmd_switch "$name"
}

# The "+" was clicked: ask which platform, what to call it, and (unless the
# hotspot named a project) where it goes — then create the thread.
#
# The whole add runs INSIDE the popup (`-E` closes it when the command exits)
# because gum needs a tty, and the sidebar's own pane is a display running the
# render loop — there is nowhere else to prompt. Failures are swallowed: a click
# that can't open a popup should do nothing, not spray errors into the pane.
#
# $1 is "*" for the global "+" (ask for the project) or a project key to add
# straight into.
# Popup height follows the project list: a fixed 14 rows clipped the picker as soon
# as there were more than a handful of projects.
popup_height() {
  local n
  n=$({ known_projects | grep -c . ; } || echo 0)
  local h=$(( n + 8 ))
  (( h < 14 )) && h=14
  (( h > 28 )) && h=28
  printf '%s' "$h"
}

sidebar_add_prompt() {
  local target="${1:-*}"
  tmux display-popup -E -w 56 -h "$(popup_height)" -T " new thread " \
    "$(printf 'llmux _newthread %q' "$target")" 2>/dev/null || true
}

# Platforms offered by the "+" picker, in order — claude first so Enter takes it.
# Filtered to what's actually installed, with `shell` (a plain pane, no tool)
# always available at the end.
NEWTHREAD_TOOLS=(claude codex opencode amp aider)

# Create a thread. $1 = project key, or "*" to ask. Called from inside the popup
# above, and from `prefix m`'s sibling flow.
cmd__newthread() {
  local target="${1:-*}"

  # --- platform ---
  local menu=() t
  for t in "${NEWTHREAD_TOOLS[@]}"; do
    command -v "$t" >/dev/null 2>&1 && menu+=("$(thread_icon "$t" 0)  $t")
  done
  [[ ${#menu[@]} -eq 0 ]] && menu+=("$(thread_icon claude 0)  claude")
  menu+=("$(thread_icon "" 1)  shell")

  local pick tool
  pick=$(printf '%s\n' "${menu[@]}" | gum choose \
    --header "Platform" --header.foreground "99" --cursor.foreground "212") || return 0
  [[ -z "$pick" ]] && return 0
  tool=$(printf '%s' "$pick" | awk '{print $NF}')
  # `shell` means "no tool" — cmd_add spells that --tool none.
  [[ "$tool" == "shell" ]] && tool="none"

  # --- name ---
  local name
  name=$(gum input --placeholder "thread name" \
    --header "New ${tool} thread" \
    --header.foreground "99" --prompt.foreground "39") || return 0
  # Pane names become tmux option values, window titles and (for claude) session
  # names; whitespace in them breaks the `|`-delimited listings elsewhere.
  name=$(printf '%s' "$name" | tr -d '[:space:]')
  [[ -z "$name" ]] && return 0

  # --- project ---
  # Default to the project of the thread you were looking at, so "another thread
  # in what I'm working on" is just Enter. With no projects yet the question has
  # one answer, so it isn't asked.
  local project=""
  if [[ "$target" != "*" ]]; then
    project=$(sanitize_project "$target")
  elif [[ -n "$(known_projects | grep -v "^${SCRATCH_KEY}$" || true)" ]]; then
    project=$(prompt_for_project "$(active_thread_project)") || return 0
  fi

  # Start the new thread beside the one you were looking at. The popup inherits
  # the sidebar pane's cwd ($HOME), which is almost never the repo you meant.
  local dir="" act
  act=$(get_active_thread_pane)
  [[ -n "$act" ]] && dir=$(tmux display-message -p -t "$act" '#{pane_current_path}' 2>/dev/null || true)
  [[ -z "$dir" || ! -d "$dir" ]] && dir="$HOME"

  if [[ -n "$project" ]]; then
    cmd_add "$name" "$dir" --tool "$tool" --project "$project"
  else
    cmd_add "$name" "$dir" --tool "$tool"
  fi
}

# --- Moving threads between projects -----------------------------------------
#
# Sections are projects, so this is THE reorganising gesture. A thread's project
# is one pane option: changing it re-sections the thread on the next render with
# nothing killed, relaunched or written to disk — the agent keeps running and
# never notices.

# Point <pane> at a project and say so. Empty project = back to scratch.
# $3 is the Tolaria intent (slug / "new" / "none" / empty = ask), threaded
# through to the one hook that owns that decision.
move_thread_to() {
  local pane="${1:-}" intent="${3:-}" project name label prev prev_slug
  [[ -z "$pane" ]] && return 1
  project=$(sanitize_project "${2:-}")
  name=$(tmux display-message -p -t "$pane" '#{@llmux_name}' 2>/dev/null || true)
  prev=$(tmux display-message -p -t "$pane" '#{@llmux_project}' 2>/dev/null || true)
  if ! tmux set-option -p -t "$pane" @llmux_project "$project" 2>/dev/null; then
    echo "Error: could not set the project on '${name:-$pane}'" >&2
    return 1
  fi
  register_project "$project"
  # A thread leaving is as much a project event as one arriving, and the old
  # project's log is the only place that departure would otherwise show up.
  if [[ -n "$prev" && "$prev" != "$project" && -n "$name" ]]; then
    prev_slug=$(tolaria_slug_for_key "$prev")
    [[ -n "$prev_slug" ]] && tolaria_log "$prev_slug" "llmux: thread '$name' left project '$prev'."
  fi
  tolaria_attach_project "$project" "$name" "$intent" || true
  label=$(project_meta "$project")
  label="${label%%|*}"
  if sidebar_enabled; then
    render_sidebar
  fi
  echo "Moved '${name:-$pane}' to ${label}"
}

# The same gesture as move_thread_to, for a thread that isn't running. Nothing is
# resumed to do it: the section is a field in paused.json, so a paused thread can
# be filed exactly like a live one.
move_paused_thread_to() {
  local name="${1:-}" intent="${3:-}" project prev prev_slug label rc
  [[ -z "$name" ]] && return 1
  project=$(sanitize_project "${2:-}")
  prev=$({ read_paused | grep -m1 "^${name}|" | cut -d'|' -f8; } || true)

  set_paused_project "$name" "$project" && rc=0 || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    echo "Error: could not re-file paused thread '$name'" >&2
    return 1
  fi

  register_project "$project"
  if [[ -n "$prev" && "$prev" != "$project" ]]; then
    prev_slug=$(tolaria_slug_for_key "$prev")
    [[ -n "$prev_slug" ]] && tolaria_log "$prev_slug" "llmux: paused thread '$name' left project '$prev'."
  fi
  tolaria_attach_project "$project" "$name" "$intent" || true

  if sidebar_enabled; then
    render_sidebar
  fi
  label=$(project_meta "$project")
  label="${label%%|*}"
  echo "Moved paused '$name' to ${label}"
}

# Move a thread to another project:
#   llmux mv                          pick the thread, then the project
#   llmux mv <name|index>             pick the project for that thread
#   llmux mv <name|index> <project>   move it straight there (creating the
#                                     project if it's new)
# 'scratch', 'none' and '-' all mean the scratch section.
#
# --tolaria <slug|new|none> answers the vault question up front, which is also
# how a non-interactive caller answers it at all (it never gets the picker).
cmd_mv() {
  local thread="" project="" have_project=0 intent=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --tolaria) intent="${2:?--tolaria requires a value}"; shift 2 ;;
      --tolaria=*) intent="${1#--tolaria=}"; shift ;;
      --no-tolaria) intent="none"; shift ;;
      *)
        if [[ -z "$thread" ]]; then
          thread="$1"
        elif (( ! have_project )); then
          project="$1"; have_project=1
        fi
        shift
        ;;
    esac
  done

  if ! tmux has-session -t "$SESSION" 2>/dev/null; then
    echo "Error: no llmux session running" >&2
    return 1
  fi

  # No thread given: pick one rather than erroring out (same reasoning as
  # `llmux switch` with no argument).
  if [[ -z "$thread" ]]; then
    local menu=() pid nm rest
    while IFS='|' read -r pid nm rest; do
      [[ -z "$pid" ]] && continue
      menu+=("$nm")
    done < <(list_threads)
    # Paused threads are movable too, and names can't collide across the two
    # lists, so they can go in the same menu and resolve by name below.
    while IFS='|' read -r nm rest; do
      [[ -z "$nm" ]] && continue
      menu+=("$nm")
    done < <(read_paused)
    if [[ ${#menu[@]} -eq 0 ]]; then
      echo "No threads to move." >&2
      return 1
    fi
    thread=$(printf '%s\n' "${menu[@]}" | gum filter \
      --header "Move which thread?" \
      --indicator "▸" --indicator.foreground "212" \
      --match.foreground "212" --header.foreground "99" \
      --prompt.foreground "39") || return 0
    [[ -z "$thread" ]] && return 0
  fi

  # Accept the sidebar's row number as well as the name — the number is right
  # there on screen, which is usually why you're moving this one.
  local line=""
  if [[ "$thread" =~ ^[0-9]+$ ]]; then
    line=$({ list_threads | sed -n "${thread}p"; } || true)
  else
    line=$({ list_threads | grep -m1 "^[^|]*|${thread}|"; } || true)
  fi
  # Not running: it may be paused, which is still a thread you can re-file. Only
  # by name — a row number addresses the sidebar, and paused threads aren't on it.
  if [[ -z "$line" ]]; then
    if [[ ! "$thread" =~ ^[0-9]+$ ]] && read_paused | grep -q "^${thread}|"; then
      if (( ! have_project )); then
        project=$(prompt_for_project "$({ read_paused | grep -m1 "^${thread}|" | cut -d'|' -f8; } || true)") || return 0
      fi
      case "$project" in
        "$SCRATCH_KEY"|none|-) project="" ;;
      esac
      move_paused_thread_to "$thread" "$project" "$intent"
      return $?
    fi
    echo "Error: no thread '$thread'" >&2
    return 1
  fi
  local pane
  pane=$(printf '%s' "$line" | cut -d'|' -f1)

  if (( ! have_project )); then
    project=$(prompt_for_project "$(tmux display-message -p -t "$pane" '#{@llmux_project}' 2>/dev/null || true)") || return 0
  fi
  case "$project" in
    "$SCRATCH_KEY"|none|-) project="" ;;
  esac

  move_thread_to "$pane" "$project" "$intent"
}

# prefix+M: move the thread on screen. Runs in a popup for the same reason
# _newthread does — gum needs a tty the sidebar pane can't give it.
cmd__movethread() {
  local pane cur project
  pane=$(get_active_thread_pane)
  if [[ -z "$pane" ]]; then
    echo "No thread on screen to move." >&2
    sleep 1
    return 0
  fi
  cur=$(tmux display-message -p -t "$pane" '#{@llmux_project}' 2>/dev/null || true)
  project=$(prompt_for_project "$cur") || return 0
  move_thread_to "$pane" "$project"
}

# --- The project ↔ Tolaria surface -------------------------------------------

# Live + paused threads claiming a project. `-s` because without it this counts
# only the active window, which in sidebar mode is exactly one thread.
project_thread_count() {
  local key="${1:-}" live paused
  live=$({ tmux list-panes -s -t "$SESSION" \
        -F '#{@llmux_name}|#{@llmux_sidebar}|#{@llmux_parked_anchor}|#{@llmux_project}' 2>/dev/null \
      | awk -F'|' -v k="$key" '$1 != "" && $2 != "1" && $3 != "1" && $4 == k' | wc -l; } || echo 0)
  paused=$({ read_paused | awk -F'|' -v k="$key" '$8 == k' | wc -l; } || echo 0)
  live="${live//[[:space:]]/}"
  paused="${paused//[[:space:]]/}"
  if [[ "${paused:-0}" -gt 0 ]]; then
    printf '%s+%s' "${live:-0}" "$paused"
  else
    printf '%s' "${live:-0}"
  fi
}

# Both halves of the picture: llmux projects and what they point at, then vault
# projects nothing points at. The second list is the useful one — it's the menu
# `llmux project link` is choosing from.
tolaria_project_report() {
  local key slug st n keys="" owner unlinked=()

  printf '%-26s  %7s  %-34s  %s\n' "PROJECT" "THREADS" "TOLARIA" "STATUS"
  printf '%-26s  %7s  %-34s  %s\n' "-------" "-------" "-------" "------"
  while IFS= read -r key; do
    [[ -z "$key" || "$key" == "$SCRATCH_KEY" ]] && continue
    keys+="${key},"
    slug=$(tolaria_slug_for_key "$key")
    st=""
    [[ -n "$slug" ]] && st=$(tolaria_status "$slug")
    n=$(project_thread_count "$key")
    printf '%-26s  %7s  %-34s  %s\n' "$key" "$n" "${slug:-—}" "${st:-—}"
  done < <(known_projects)
  [[ -z "$keys" ]] && echo "(no projects yet — everything is in SCRATCH)"

  tolaria_available || {
    echo ""
    echo "No Tolaria vault at $TOLARIA_VAULT — project memory is off."
    return 0
  }

  while IFS= read -r slug; do
    [[ -z "$slug" ]] && continue
    # Claimed explicitly, or resolved by name — either way it has a home.
    owner=$(tolaria_key_for_slug "$slug")
    [[ -n "$owner" ]] && continue
    case ",$keys" in *",$slug,"*) continue ;; esac
    unlinked+=("$slug")
  done < <(tolaria_projects)

  if [[ ${#unlinked[@]} -gt 0 ]]; then
    echo ""
    echo "Tolaria projects with no llmux threads:"
    for slug in "${unlinked[@]}"; do
      st=$(tolaria_status "$slug")
      printf '  %-34s  %s\n' "$slug" "${st:-—}"
    done
  fi
}

# Open a project's hub note. Tolaria owns the vault, so prefer it; `open` alone
# hands a .md to whatever the system has registered, which may be a text editor.
tolaria_open_project() {
  local key="${1:-}" slug hub
  [[ -z "$key" ]] && { echo "Usage: llmux project open <key>" >&2; return 1; }
  key=$(sanitize_project "$key")
  slug=$(tolaria_slug_for_key "$key")
  if [[ -z "$slug" ]]; then
    echo "Error: '$key' has no Tolaria project — link one with: llmux project link $key" >&2
    return 1
  fi
  hub=$(tolaria_hub "$slug")
  if [[ -d /Applications/Tolaria.app ]]; then
    open -a Tolaria "$hub" 2>/dev/null || open "$hub"
  else
    open "$hub"
  fi
  echo "Opened $hub"
}

# The explicit lifecycle surface. Everything here is also reachable implicitly
# (naming a new project in any picker offers the same choices); this is for when
# you want to state the association rather than be asked about it.
cmd_project() {
  local sub="${1:-ls}" key slug
  shift || true
  case "$sub" in
    ls|list|"")
      tolaria_project_report
      ;;
    new)
      key=$(sanitize_project "${1:-}")
      [[ -z "$key" ]] && { echo "Usage: llmux project new <key> [slug]" >&2; return 1; }
      slug=$(sanitize_tolaria_slug "${2:-$key}")
      slug=$(tolaria_create_project "$slug" "$key") || return 1
      register_project "$key"
      echo "Created Tolaria project '$slug' → $TOLARIA_PROJECTS_DIR/$slug"
      ;;
    link)
      key=$(sanitize_project "${1:-}")
      [[ -z "$key" ]] && { echo "Usage: llmux project link <key> [slug]" >&2; return 1; }
      if [[ -n "${2:-}" ]]; then
        slug=$(sanitize_tolaria_slug "$2")
      else
        slug=$(tolaria_prompt_for_slug) || return 0
      fi
      slug=$(tolaria_link_key "$key" "$slug") || return 1
      register_project "$key"
      echo "Linked '$key' → Tolaria project '$slug'"
      ;;
    unlink)
      key=$(sanitize_project "${1:-}")
      [[ -z "$key" ]] && { echo "Usage: llmux project unlink <key>" >&2; return 1; }
      slug=$(tolaria_slug_for_key "$key")
      [[ -z "$slug" ]] && { echo "'$key' has no Tolaria project."; return 0; }
      # Clearing the frontmatter line only breaks an EXPLICIT link. A slug that
      # matches the key by name resolves by name and cannot be unlinked — say so
      # rather than reporting success and leaving it attached.
      if [[ "$slug" == "$key" ]]; then
        echo "Error: '$slug' matches the project name, so it resolves by name." >&2
        echo "       Rename one of the two if they really aren't the same work." >&2
        return 1
      fi
      tolaria_set_association "$slug" "" || return 1
      tolaria_log "$slug" "Unlinked from llmux thread section '$key'."
      echo "Unlinked '$key' from '$slug' (the notes are untouched)"
      ;;
    forge)
      local gkey="${1:-}" gref="${2:-}" gtitle=""
      if [[ -z "$gkey" ]]; then
        local k u t
        printf '%-28s %-24s %s\n' PROJECT TITLE LINK
        while IFS=$'\t' read -r k u t; do
          [[ -n "$k" ]] && printf '%-28s %-24s %s\n' "$k" "${t:-—}" "$u"
        done < <(read_forge)
        return 0
      fi
      gkey=$(sanitize_project "$gkey")
      if [[ "$gref" == "--clear" || "$gref" == "none" ]]; then
        set_forge "$gkey" "" "" clear
        echo "Cleared all Forge tasks for $gkey."
        render_sidebar 2>/dev/null || true
        return 0
      fi
      if [[ "$gref" == "--remove" ]]; then
        [[ -z "${3:-}" ]] && { echo "Usage: llmux project forge <key> --remove <task-id|url>" >&2; return 1; }
        forge_url_for "$3"
        set_forge "$gkey" "$R_FORGE_URL" "" remove
        echo "Removed $3 from $gkey."
        render_sidebar 2>/dev/null || true
        return 0
      fi
      [[ -z "$gref" ]] && { echo "Usage: llmux project forge <key> <task-id|url> [title]" >&2; return 1; }
      shift 2 2>/dev/null || true
      # Remaining words are the title, unquoted or not — "llmux project forge x tsk-1
      # fix flaky test" is what someone actually types.
      gtitle="$*"
      forge_url_for "$gref"
      set_forge "$gkey" "$R_FORGE_URL" "$gtitle" add
      if [[ -z "$gtitle" ]]; then
        echo "Warning: no name given — the row will read \"⚒ untitled task\"." >&2
        echo "         Name it for the work: llmux project forge $gkey $gref <short name>" >&2
      fi
      echo "$gkey → ⚒ ${gtitle:-untitled task}"
      echo "  $R_FORGE_URL"
      render_sidebar 2>/dev/null || true
      return 0
      ;;
    flag)
      local fkey="${1:-}" fname="${2:-}" fsvc="${3:-}" furl=""
      if [[ -z "$fkey" ]]; then
        local k n sv u
        printf '%-28s %-38s %-16s %s\n' PROJECT FLAG SERVICE LINK
        while IFS=$'\t' read -r k n sv u; do
          [[ -n "$k" ]] && printf '%-28s %-38s %-16s %s\n' "$k" "$n" "$sv" "$u"
        done < <(read_flags)
        return 0
      fi
      fkey=$(sanitize_project "$fkey")
      if [[ "$fname" == "--clear" || "$fname" == "none" ]]; then
        set_flag "$fkey" "" "" "" clear
        echo "Cleared all flags for $fkey."
        render_sidebar 2>/dev/null || true
        return 0
      fi
      if [[ "$fname" == "--remove" ]]; then
        [[ -z "${3:-}" ]] && { echo "Usage: llmux project flag <key> --remove <flag-name>" >&2; return 1; }
        set_flag "$fkey" "$3" "" "" remove
        echo "Removed $3 from $fkey."
        render_sidebar 2>/dev/null || true
        return 0
      fi
      [[ -z "$fname" ]] && { echo "Usage: llmux project flag <key> <flag-name> [unleash-service] [--url U]" >&2; return 1; }
      # Explicit --url wins; otherwise infer the Unleash project from the flag prefix.
      if [[ "$fsvc" == "--url" ]]; then furl="${4:-}"; fsvc=""; fi
      [[ "${4:-}" == "--url" ]] && furl="${5:-}"
      if [[ -z "$fsvc" ]]; then unleash_service_for "$fname"; fsvc="$R_UNLEASH_SVC"; fi
      [[ -z "$furl" ]] && furl="${UNLEASH_BASE}/projects/${fsvc}/features/${fname}"
      set_flag "$fkey" "$fname" "$fsvc" "$furl" add
      echo "$fkey → $fname [$fsvc]"
      echo "  $furl"
      render_sidebar 2>/dev/null || true
      return 0
      ;;
    monitor)
      local mkey="${1:-}" murl="${2:-}"
      if [[ -z "$mkey" ]]; then
        local mk mu
        printf '%-28s %s\n' PROJECT MONITOR
        while IFS=$'\t' read -r mk mu; do
          [[ -n "$mk" ]] && printf '%-28s %s\n' "$mk" "$mu"
        done < <(read_monitors)
        return 0
      fi
      mkey=$(sanitize_project "$mkey")
      if [[ "$murl" == "--clear" || "$murl" == "none" ]]; then
        set_monitor "$mkey" ""
        echo "Cleared monitoring link for $mkey."
      elif [[ -z "$murl" ]]; then
        echo "Usage: llmux project monitor <key> <url|--clear>" >&2; return 1
      else
        set_monitor "$mkey" "$murl"
        echo "$mkey → $murl"
      fi
      render_sidebar 2>/dev/null || true
      return 0
      ;;
    open)
      tolaria_open_project "${1:-}"
      ;;
    *)
      echo "Usage: llmux project [ls | new <key> [slug] | link <key> [slug] | unlink <key> | open <key> | monitor <key> <url> | flag <key> <flag> | forge <key> <task-id> [title]]" >&2
      return 1
      ;;
  esac
}

# Size window 0 as [ sidebar | active thread ].
sidebar_apply_layout() {
  local sb
  sb=$(get_sidebar_pane)
  [[ -z "$sb" ]] && return 0
  local win
  win=$(tmux display-message -p -t "$sb" '#{window_index}' 2>/dev/null || true)
  [[ -z "$win" ]] && return 0

  local count
  count=$(tmux list-panes -t "$SESSION:$win" 2>/dev/null | wc -l | tr -d ' ')
  if [[ "$count" -le 1 ]]; then
    return 0
  fi

  # Sidebar must be pane 0 so even-horizontal puts it on the left.
  local first
  first=$({ tmux list-panes -t "$SESSION:$win" -F '#{pane_id}' | head -1; } || true)
  if [[ -n "$first" && "$first" != "$sb" ]]; then
    tmux swap-pane -s "$sb" -t "$first" 2>/dev/null || true
  fi
  tmux select-layout -t "$SESSION:$win" even-horizontal 2>/dev/null || true
  # The width YOU last left it at, not the constant. This used to snap back to
  # SIDEBAR_WIDTH on every switch, so widening the sidebar to read longer names
  # survived only until the next thread change. render_sidebar records a manual
  # drag into @llmux_sidebar_width, and this restores that.
  local want winw
  want=$(tmux show-option -t "$SESSION" -qv @llmux_sidebar_width 2>/dev/null || true)
  [[ "$want" =~ ^[0-9]+$ ]] || want="$SIDEBAR_WIDTH"
  # Clamp, so a poisoned value can never wedge the layout — and so a session that
  # already stored one heals itself on the next layout instead of needing a manual
  # fix. The thread is the point of the window; the sidebar never gets most of it.
  winw=$(tmux display-message -p -t "$sb" '#{window_width}' 2>/dev/null || true)
  if [[ "$winw" =~ ^[0-9]+$ ]] && (( winw > 40 )); then
    local maxw=$(( winw / 2 ))
    (( want > maxw )) && want="$SIDEBAR_WIDTH"
  fi
  (( want < 10 )) && want="$SIDEBAR_WIDTH"
  tmux resize-pane -t "$sb" -x "$want" 2>/dev/null || true
}

# Make <name> the visible thread. Accepts a name or a 1-based list index.
cmd_switch() {
  local target="${1:-}"
  if ! sidebar_enabled; then
    echo "Error: sidebar mode is off — run 'llmux sidebar on' first" >&2
    return 1
  fi

  # No argument: pick from a list rather than erroring out, so `llmux switch`
  # is usable when you can't remember a thread's name.
  if [[ -z "$target" ]]; then
    local menu=() pane_id name tool status win n=0
    while IFS='|' read -r pane_id name tool status win; do
      [[ -z "$pane_id" ]] && continue
      ((n++))
      local mark=" "
      [[ "$pane_id" == "$(get_active_thread_pane)" ]] && mark="▶"
      # Spell the state out here — the picker has room, and "needs an answer" is
      # what makes you pick that row.
      local wait="" smeta
      smeta=$(status_meta "$status")
      [[ -n "${smeta%%|*}" ]] && wait="  ${smeta%%|*} ${smeta##*|}"
      menu+=("$(printf '%s %d  %-20s %s%s' "$mark" "$n" "$name" "${tool:-—}" "$wait")")
    done < <(list_threads)
    if [[ ${#menu[@]} -eq 0 ]]; then
      echo "Error: no threads" >&2
      return 1
    fi
    local picked
    picked=$(printf '%s\n' "${menu[@]}" | gum choose --header "Switch to thread") || return 0
    # Field 2 of the rendered row is the index.
    target=$(printf '%s' "$picked" | awk '{print $2}')
    [[ -z "$target" ]] && return 0
  fi

  local line
  if [[ "$target" =~ ^[0-9]+$ ]]; then
    line=$({ list_threads | sed -n "${target}p"; } || true)
  else
    line=$({ list_threads | grep -m1 "^[^|]*|${target}|"; } || true)
  fi
  if [[ -z "$line" ]]; then
    echo "Error: no thread named '$target'" >&2
    return 1
  fi

  local pane name
  pane=$(printf '%s' "$line" | cut -d'|' -f1)
  name=$(printf '%s' "$line" | cut -d'|' -f2)

  # Serialize. park + join is a two-step move through a shared window, so two
  # concurrent switches can interleave and leave a thread stranded or park the
  # one the other just brought in. mkdir is the atomic primitive available
  # everywhere (no flock on macOS by default).
  local lock="${TMPDIR:-/tmp}/llmux-switch-${SESSION}.lock"
  local waited=0
  while ! mkdir "$lock" 2>/dev/null; do
    # Reap a lock orphaned by a killed handler.
    if [[ -d "$lock" ]]; then
      local age
      age=$(python3 -c "
import os,time
try: print(int(time.time() - os.path.getmtime('$lock')))
except Exception: print(999)" 2>/dev/null || echo 999)
      if [[ "$age" -gt 10 ]]; then
        rmdir "$lock" 2>/dev/null || true
        continue
      fi
    fi
    (( waited++ ))
    # Another switch is mid-flight; that one wins rather than queueing behind it.
    (( waited > 20 )) && return 0
    python3 -c 'import time; time.sleep(0.05)' 2>/dev/null || true
  done
  # A bash RETURN trap is NOT function-local: left installed it fires again when
  # the CALLER returns, where $lock is out of scope — under set -u that throws
  # "unbound variable" and the handler exits 1, which tmux spams into the pane as
  # `'llmux _click …' returned 1`. Guard the expansion AND clear the trap as it
  # fires so it can't leak up the stack.
  trap 'rmdir "${lock:-}" 2>/dev/null || true; trap - RETURN' RETURN

  local sb current
  sb=$(get_sidebar_pane)
  current=$(get_active_thread_pane)

  if [[ "$pane" == "$current" ]]; then
    tmux select-pane -t "$pane" 2>/dev/null || true
    mark_thread_seen "$pane"
    render_sidebar
    return 0
  fi

  # Park the outgoing thread first so window 0 never holds two threads (a
  # failed join would otherwise leave the layout wedged).
  if [[ -n "$current" ]]; then
    park_pane "$current" || {
      echo "Error: could not park current thread" >&2
      return 1
    }
  fi

  if ! tmux join-pane -h -s "$pane" -t "$sb" 2>/dev/null; then
    echo "Error: could not bring thread '$name' into view" >&2
    return 1
  fi

  sidebar_apply_layout
  tmux select-pane -t "$pane" 2>/dev/null || true
  tmux select-window -t "$sb" 2>/dev/null || true
  # Not just on the loop's tick: waiting up to 2s would leave the dot on a thread
  # you are already reading.
  mark_thread_seen "$pane"
  render_sidebar
}

# Pin threads to the top of the list, in the order given:
#   llmux top terminal make-llmux-better
# Ranks start below DEFAULT_THREAD_ORDER so anything untouched follows. Passing
# --reset clears the explicit ranks and returns everything to pinned-then-name.
cmd_top() {
  if [[ $# -eq 0 ]]; then
    echo "Usage: llmux top <name>... | llmux top --reset" >&2
    return 1
  fi

  if [[ "$1" == "--reset" ]]; then
    local pane_id rest
    while IFS='|' read -r pane_id rest; do
      [[ -z "$pane_id" ]] && continue
      tmux set-option -p -t "$pane_id" @llmux_order "" 2>/dev/null || true
    done < <(list_threads)
    render_sidebar
    echo "Thread order reset."
    return 0
  fi

  # Resolve every name up front: a half-applied reorder is worse than none.
  local panes=() nm line
  for nm in "$@"; do
    line=$({ list_threads | grep -m1 "^[^|]*|${nm}|"; } || true)
    if [[ -z "$line" ]]; then
      echo "Error: no thread named '$nm'" >&2
      return 1
    fi
    panes+=("$(printf '%s' "$line" | cut -d'|' -f1)")
  done

  local rank=10 p
  for p in "${panes[@]}"; do
    tmux set-option -p -t "$p" @llmux_order "$rank" 2>/dev/null || true
    ((rank++))
  done

  render_sidebar
  echo "Thread order:"
  local n=1 pane_id name rest2
  while IFS='|' read -r pane_id name rest2; do
    [[ -z "$pane_id" ]] && continue
    printf '  %d. %s\n' "$n" "$name"
    ((n++))
  done < <(list_threads)
}

# 1-based position of the visible thread in list_threads order; empty when the
# active pane isn't a thread (e.g. focus sitting on the sidebar itself).
active_thread_index() {
  local active
  active=$(get_active_thread_pane)
  [[ -z "$active" ]] && return 0
  local n=0 pane_id rest
  while IFS='|' read -r pane_id rest; do
    [[ -z "$pane_id" ]] && continue
    ((n++))
    if [[ "$pane_id" == "$active" ]]; then
      echo "$n"
      return 0
    fi
  done < <(list_threads)
}

# Step through the thread list, wrapping at both ends. $1 = +1 | -1
sidebar_step() {
  local delta="$1"
  if ! sidebar_enabled; then
    echo "Error: sidebar mode is off — run 'llmux sidebar on' first" >&2
    return 1
  fi
  local total
  total=$({ list_threads | wc -l | tr -d ' '; } || echo 0)
  [[ "$total" -lt 1 ]] && return 0

  local cur
  cur=$(active_thread_index)
  # No thread in view (or focus is elsewhere): treat "next" as thread 1 rather
  # than doing nothing, so the keys always move somewhere.
  [[ -z "$cur" ]] && cur=0

  local next=$(( cur + delta ))
  (( next < 1 )) && next="$total"
  (( next > total )) && next=1
  cmd_switch "$next"
}

cmd_next() { sidebar_step 1; }
cmd_prev() { sidebar_step -1; }

# prefix-based traversal. Prefix (not bare) keys on purpose: bare bindings are
# swallowed before the thread's TUI sees them, and Claude/codex need their own
# j/k/arrows/digits. prefix 0-9 is otherwise dead weight here — this arch runs a
# single visible window, so select-window has nothing to select.
# -b on every run-shell: the handlers issue a burst of tmux commands, and a
# synchronous run-shell blocks the server while they do, so they end up fighting
# it. Same failure mode that broke click-to-switch.
sidebar_bind_keys() {
  tmux bind-key -T prefix j run-shell -b 'llmux next' 2>/dev/null || true
  tmux bind-key -T prefix k run-shell -b 'llmux prev' 2>/dev/null || true
  tmux bind-key -T prefix Down run-shell -b 'llmux next' 2>/dev/null || true
  tmux bind-key -T prefix Up   run-shell -b 'llmux prev' 2>/dev/null || true
  tmux bind-key -T prefix Tab  run-shell -b 'llmux next' 2>/dev/null || true
  # Move the visible thread to another project. display-popup directly rather
  # than via run-shell: the popup IS the interaction, and gum needs its tty.
  #
  # M, not m: ensure_session already owns prefix+m as the mouse toggle (the
  # "[mouse]" flag in status-right), and stealing it would break the one binding
  # you need when the mouse is what's misbehaving.
  tmux bind-key -T prefix M display-popup -E -w 56 -h 24 -T ' move thread ' \
    'llmux _movethread' 2>/dev/null || true
  local i
  for i in 1 2 3 4 5 6 7 8 9; do
    tmux bind-key -T prefix "$i" run-shell -b "llmux switch $i" 2>/dev/null || true
  done
}

# tmux has no persistent "keep this pane N columns wide" constraint, so an
# even-horizontal layout redistributes the sidebar's width whenever the client
# resizes (attaching from a different terminal, splitting the outer window, …)
# and the column creeps wider. Re-apply the layout on resize to pin it back.
#
# client-resized specifically, NOT window-layout-changed: our own resize-pane
# changes the layout, so hooking that would recurse.
sidebar_hook_resize() {
  tmux set-hook -t "$SESSION" client-resized \
    "run-shell 'llmux _relayout 2>/dev/null || true'" 2>/dev/null || true
}

sidebar_unhook_resize() {
  tmux set-hook -u -t "$SESSION" client-resized 2>/dev/null || true
}

# Put tmux's defaults back for everything sidebar_bind_keys took over.
sidebar_unbind_keys() {
  tmux unbind-key -T prefix j 2>/dev/null || true
  tmux unbind-key -T prefix k 2>/dev/null || true
  tmux unbind-key -T prefix Tab 2>/dev/null || true
  # M has no tmux default and prefix+m stays the mouse toggle, so just drop it.
  tmux unbind-key -T prefix M 2>/dev/null || true
  # Down/Up are select-pane by default.
  tmux bind-key -T prefix Down select-pane -D 2>/dev/null || true
  tmux bind-key -T prefix Up   select-pane -U 2>/dev/null || true
  local i
  for i in 1 2 3 4 5 6 7 8 9; do
    tmux bind-key -T prefix "$i" select-window -t ":$i" 2>/dev/null || true
  done
  tmux unbind-key -n MouseDown1Pane 2>/dev/null || true
  # Not `unbind`: this one overrode a tmux default, so dropping it would leave
  # the wheel dead everywhere. Put the stock binding back verbatim.
  tmux bind-key -n WheelUpPane \
    if-shell -F -t= '#{||:#{alternate_on},#{pane_in_mode},#{mouse_any_flag}}' \
      'send-keys -M -t=' 'copy-mode -e -t=' 2>/dev/null || true
}

# Enable/disable sidebar mode. Enabling migrates the panes that already exist:
# the first thread stays visible, the rest get parked. Nothing is killed and no
# tool is relaunched, so live agents keep running.
cmd_sidebar() {
  local action="${1:-on}"

  case "$action" in
    off)
      if ! sidebar_enabled; then
        echo "Sidebar mode is already off."
        return 0
      fi
      # Pull every parked thread back into window 0, drop the sidebar and the
      # holding window, then hand the layout back to the classic tiler.
      local sb win
      sb=$(get_sidebar_pane)
      if [[ -n "$sb" ]]; then
        win=$(tmux display-message -p -t "$sb" '#{window_index}' 2>/dev/null || true)
        local pane_id rest
        while IFS='|' read -r pane_id rest; do
          [[ -z "$pane_id" ]] && continue
          local pwin
          pwin=$(tmux display-message -p -t "$pane_id" '#{window_index}' 2>/dev/null || true)
          [[ "$pwin" == "$win" ]] && continue
          # Re-tile + retry, exactly as park_pane does in the other direction:
          # join-pane needs free space and window 0 runs out of room past ~5
          # panes. Without the retile, joins beyond that silently fail (|| true)
          # and STRAND those threads in the old holding window — which then
          # survives as a second `_parked` window after the rebuild. This is the
          # bug that made `cycle all` (off → cycle → on) shred a busy session.
          if ! tmux join-pane -d -s "$pane_id" -t "$sb" 2>/dev/null; then
            tmux select-layout -t "$SESSION:$win" tiled 2>/dev/null || true
            tmux join-pane -d -s "$pane_id" -t "$sb" 2>/dev/null || true
          fi
          tmux select-layout -t "$SESSION:$win" tiled 2>/dev/null || true
        done < <(list_threads)
        tmux kill-pane -t "$sb" 2>/dev/null || true
      fi
      local anchor
      anchor=$(get_parked_anchor)
      [[ -n "$anchor" ]] && tmux kill-pane -t "$anchor" 2>/dev/null || true
      tmux set-option -t "$SESSION" @llmux_sidebar_mode "0" 2>/dev/null || true
      sidebar_unbind_keys
      sidebar_unhook_resize
      apply_layout
      echo "Sidebar mode off — classic layout restored."
      return 0
      ;;
    on) ;;
    *)
      echo "Usage: llmux sidebar [on|off]" >&2
      return 1
      ;;
  esac

  if ! tmux has-session -t "$SESSION" 2>/dev/null; then
    echo "Error: no llmux session — start one with 'llmux add <name>' first" >&2
    return 1
  fi

  if sidebar_enabled && [[ -n "$(get_sidebar_pane)" ]]; then
    # Re-register rather than bailing outright: bindings live in the tmux server,
    # not the session, so they vanish on a server restart. Running `sidebar on`
    # again is the documented way to get them back.
    sidebar_bind_mouse
    sidebar_bind_keys
    sidebar_hook_resize
    apply_pane_border_format
    apply_status_right
    sidebar_apply_layout
    render_sidebar
    echo "Sidebar mode already on — bindings re-registered."
    return 0
  fi

  local threads=()
  local pane_id name rest
  while IFS='|' read -r pane_id name rest; do
    [[ -z "$pane_id" ]] && continue
    threads+=("$pane_id|$name")
  done < <(list_threads)

  if [[ ${#threads[@]} -eq 0 ]]; then
    echo "Error: no named panes to turn into threads" >&2
    return 1
  fi

  # Anchor the sidebar to the window the first thread lives in, so it lands in
  # the main window rather than wherever the caller happens to be.
  local first_pane first_win
  first_pane=$(printf '%s' "${threads[0]}" | cut -d'|' -f1)
  first_win=$(tmux display-message -p -t "$first_pane" '#{window_index}' 2>/dev/null || true)
  if [[ -z "$first_win" ]]; then
    echo "Error: could not locate the main window" >&2
    return 1
  fi

  local sb
  sb=$(tmux split-window -h -t "$first_pane" -c "$HOME" -P -F '#{pane_id}' -l "$SIDEBAR_WIDTH" 2>/dev/null) || {
    echo "Error: could not create the sidebar pane" >&2
    return 1
  }
  tmux set-option -p -t "$sb" @llmux_sidebar "1"
  tmux set-option -p -t "$sb" @llmux_name "" 2>/dev/null || true
  tmux select-pane -t "$sb" -T "threads" 2>/dev/null || true

  ensure_parked_window || {
    echo "Error: could not create the parked window" >&2
    return 1
  }

  tmux set-option -t "$SESSION" @llmux_sidebar_mode "1"

  # Park every thread except the first.
  local i
  for (( i = 1; i < ${#threads[@]}; i++ )); do
    local p
    p=$(printf '%s' "${threads[$i]}" | cut -d'|' -f1)
    park_pane "$p" || echo "Warning: could not park ${threads[$i]#*|}" >&2
  done

  sidebar_bind_mouse
  sidebar_bind_keys
  sidebar_hook_resize
  apply_pane_border_format
  # Both formats are re-applied here for the same reason: ensure_session can't
  # reach a live session, so `llmux sidebar on` is the repair path for a session
  # whose status bar or borders predate a change to either format.
  apply_status_right
  sidebar_apply_layout
  # The loop runs in the sidebar pane's own shell, which does not inherit our
  # environment — so an overridden session name has to be passed through
  # explicitly or the loop would render the default session into this pane.
  #
  # Wrapped in `while :; do … done` so a loop that exits (a transient tmux error
  # under set -e, a stray ^C) revives instead of dropping to a bare prompt and
  # freezing the list — the exact state that made clicks resolve against a live
  # order the frozen pixels no longer matched.
  #
  # `|| break` retires this wrapper the moment its loop returns non-zero, which
  # sidebar_loop does ONLY when a newer loop has claimed the pane. So if a second
  # wrapper is ever started (a stale one left behind by a pane swap), the older
  # one stops itself instead of dueling — at most one loop paints, always.
  local inner=""
  [[ -n "${LLMUX_SESSION:-}" ]] && inner+="LLMUX_SESSION=$(printf '%q' "$LLMUX_SESSION") "
  # Forward the config root too, and re-invoke THIS script by absolute path rather
  # than whatever `llmux` resolves to on the pane shell's PATH. Without both, a
  # second llmux running from another checkout (the isolated dev environment) had
  # its sidebar painted by the PRODUCTION binary reading the PRODUCTION config —
  # so the thing under test was never the thing running.
  [[ -n "${XDG_CONFIG_HOME:-}" ]] && inner+="XDG_CONFIG_HOME=$(printf '%q' "$XDG_CONFIG_HOME") "
  local self
  self="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)/$(basename "$(readlink -f "$0" 2>/dev/null || echo "$0")")"
  [[ -x "$self" ]] || self="llmux"
  inner+="$(printf '%q' "$self") _sidebar-loop"
  local loop_cmd="clear; while :; do ${inner} || break; sleep 1; done"
  tmux send-keys -t "$sb" "$loop_cmd" Enter
  tmux select-pane -t "$first_pane" 2>/dev/null || true

  echo "Sidebar mode on — ${#threads[@]} thread(s):"
  local n=1
  while IFS='|' read -r pane_id name rest; do
    [[ -z "$pane_id" ]] && continue
    printf '  %d. %s\n' "$n" "$name"
    ((n++))
  done < <(list_threads)
  echo ""
  echo "Click a row to switch, or: llmux switch <name|index>"
}

# Route clicks in the sidebar to sidebar_click; forward every other click to
# the application exactly as tmux's default MouseDown1Pane binding does
# (select-pane then send-keys -M), so clicking inside Claude/codex still works.
sidebar_bind_mouse() {
  # Two things here are load-bearing and were both wrong in the first cut:
  #
  # -t=  : `=` is the mouse target — the pane the click landed in. Without it,
  #        if-shell evaluates @llmux_sidebar against the *active* pane, so the
  #        test answered a question nobody asked: "is the focused pane the
  #        sidebar", not "was the sidebar clicked". With focus on a thread, a
  #        sidebar click fell through to select-pane (focusing the sidebar), and
  #        the *next* click anywhere then read as a sidebar click.
  #
  # -b   : run-shell without it is synchronous and blocks the tmux server while
  #        the handler runs. The handler is itself a pile of tmux calls
  #        (join-pane/select-layout/…), so it fought the very server it was
  #        blocking — which is what made a click flash a thread in and back out.
  #
  # The pane id is passed through so the handler can re-verify it really was the
  # sidebar; a mis-evaluated condition then costs nothing instead of switching a
  # thread out from under you.
  # Note: tmux's brace command-blocks are NOT usable here. bind-key receives its
  # command as argv, and `{` / `}` are only recognised by tmux's own config
  # parser — passing them from a shell yields "if-shell: too many arguments".
  # Nested quoted strings are the correct form for an argv invocation.
  # mouse_x goes last so a binding left over from an older llmux (which passed
  # only y and pane_id) degrades to "no + hotspots" rather than mis-parsing.
  tmux bind-key -n MouseDown1Pane \
    if-shell -F -t= '#{==:#{@llmux_sidebar},1}' \
      "run-shell -b 'llmux _click #{mouse_y} #{pane_id} #{mouse_x}'" \
      "select-pane -t= ; send-keys -M" 2>/dev/null || true

  # Swallow the wheel over the sidebar. Clearing the scrollback each paint stops
  # it showing stale frames, but tmux's default WheelUpPane still drops the pane
  # into copy-mode, which freezes it on the frame you happened to scroll — a
  # display that has stopped updating and looks identical to one that is live.
  # The empty arm is a real tmux command list, so the event is consumed here and
  # never reaches copy-mode.
  #
  # The else arm reproduces tmux's stock WheelUpPane so every other pane keeps
  # scrolling normally: bindings are server-global, not session-scoped, and this
  # one has to be a no-op outside llmux's sidebar.
  tmux bind-key -n WheelUpPane \
    if-shell -F -t= '#{==:#{@llmux_sidebar},1}' \
      "" \
      "if-shell -F -t= '#{||:#{alternate_on},#{pane_in_mode},#{mouse_any_flag}}' 'send-keys -M -t=' 'copy-mode -e -t='" 2>/dev/null || true
}

attach_to_pane() {
  local name="$1"
  # Select the pane by llmux name
  local pane_id
  pane_id=$(tmux list-panes -s -t "$SESSION" -F '#{pane_id}|#{@llmux_name}' | grep "|${name}$" | head -1 | cut -d'|' -f1)
  if [[ -n "$pane_id" ]]; then
    # select-window first so the client lands on the pane's window — it may live
    # in the main window even when llmux was invoked from a sub-window.
    tmux select-window -t "$pane_id"
    tmux select-pane -t "$pane_id"
  fi
  # Attach or switch
  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$SESSION"
  else
    tmux attach-session -t "$SESSION"
  fi
}

create_worktree_for_pane() {
  local name="$1"
  local repo_root
  repo_root=$(git rev-parse --show-toplevel 2>/dev/null) || {
    echo "Error: not inside a git repository"
    exit 1
  }

  # Determine worktree base directory
  local wt_base=""
  if [[ -d "$repo_root/.worktrees" ]]; then
    wt_base="$repo_root/.worktrees"
  elif [[ -d "$repo_root/.workspaces" ]]; then
    wt_base="$repo_root/.workspaces"
  elif [[ -d "$repo_root/worktrees" ]]; then
    wt_base="$repo_root/worktrees"
  else
    wt_base="$repo_root/.worktrees"
    mkdir -p "$wt_base"
  fi

  # Ensure the worktree directory is gitignored
  local wt_rel="${wt_base#$repo_root/}"
  if ! git -C "$repo_root" check-ignore -q "$wt_rel" 2>/dev/null; then
    echo "$wt_rel" >> "$repo_root/.gitignore"
    echo "Added $wt_rel to .gitignore"
  fi

  # Sanitize name for branch/directory (replace spaces with dashes)
  local safe_name
  safe_name=$(echo "$name" | tr ' ' '-' | tr -cd '[:alnum:]._-/')

  local wt_dir="$wt_base/$safe_name"
  local branch_name="$safe_name"

  if [[ -d "$wt_dir" ]]; then
    echo "Worktree already exists at $wt_dir"
    echo "$wt_dir"
    return 0
  fi

  echo "Creating worktree: $wt_dir (branch: $branch_name)"
  git -C "$repo_root" worktree add "$wt_dir" -b "$branch_name" 2>&1
  echo "$wt_dir"
}

cmd_add() {
  local name="" dir="" tool_override="" use_worktree=false
  local use_slot=false explicit_slot="" explicit_branch="" project="" tolaria_intent=""

  # Parse args: name [directory] [--tool <tool>] [--project <name>] [--worktree|--slot[=N]] [--branch <name>]
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --tool) tool_override="${2:?--tool requires a value}"; shift 2 ;;
      --project) project="${2:?--project requires a value}"; shift 2 ;;
      --project=*) project="${1#--project=}"; shift ;;
      --tolaria) tolaria_intent="${2:?--tolaria requires a value}"; shift 2 ;;
      --tolaria=*) tolaria_intent="${1#--tolaria=}"; shift ;;
      --no-tolaria) tolaria_intent="none"; shift ;;
      --worktree|--wt) use_worktree=true; shift ;;
      --slot)
        use_slot=true
        # Optional next arg: slot-N or N
        if [[ "${2:-}" =~ ^(slot-)?[0-9]+$ ]]; then
          explicit_slot="$2"; shift 2
        else
          shift
        fi
        ;;
      --slot=*) use_slot=true; explicit_slot="${1#--slot=}"; shift ;;
      --branch) explicit_branch="${2:?--branch requires a value}"; shift 2 ;;
      --branch=*) explicit_branch="${1#--branch=}"; shift ;;
      *)
        if [[ -z "$name" ]]; then
          name="$1"
        elif [[ -z "$dir" ]]; then
          dir="$1"
        fi
        shift
        ;;
    esac
  done

  [[ -z "$name" ]] && { echo "Usage: llmux add <name> [directory] [--tool <tool>] [--project <name>] [--worktree|--slot[=N]] [--branch <name>]"; exit 1; }

  # No project = scratch. Deliberately NOT derived from the cwd: inside Owner
  # every thread lives in .workspaces/slot-N, which would invent a project per
  # slot — and scratch is the intended landing pad anyway.
  project=$(sanitize_project "$project")

  # Inside Owner, --worktree is aliased to --slot — the two used to compete
  # (one creating .worktrees/<name>, the other adopting a slot), and the slot
  # path is now the canonical worktree story for this repo.
  local cwd_for_owner_check="${dir:-$(pwd)}"
  if $use_worktree && { [[ "$cwd_for_owner_check" == "$OWNER_REPO_ROOT" ]] || [[ "$cwd_for_owner_check" == "$OWNER_REPO_ROOT"/* ]]; }; then
    echo "Note: --worktree inside Owner is deprecated; adopting an owner-wt slot instead." >&2
    use_worktree=false
    use_slot=true
  fi

  local adopted_slot=""
  if $use_slot; then
    if [ ! -d "$OWNER_SLOTS_DIR" ]; then
      echo "Error: --slot requires $OWNER_SLOTS_DIR (run 'owner-wt init' first)." >&2
      exit 1
    fi
    local slot
    slot=$(pick_idle_slot "$explicit_slot") || exit 1
    local branch="${explicit_branch:-$name}"

    echo "Adopting $slot for branch '$branch'..." >&2
    if ! (cd "$OWNER_REPO_ROOT" && owner-wt grab "$branch" --slot="$slot"); then
      echo "Error: owner-wt grab failed; not creating pane." >&2
      exit 1
    fi
    dir="$OWNER_SLOTS_DIR/$slot"
    adopted_slot="$slot"
  elif $use_worktree; then
    local wt_dir
    wt_dir=$(create_worktree_for_pane "$name")
    # Last line of output is the directory
    dir=$(echo "$wt_dir" | tail -1)

    # Run post-worktree hook if present in the repo
    local repo_root
    repo_root=$(git rev-parse --show-toplevel 2>/dev/null || true)
    local hook="$repo_root/.llmux/post-worktree"
    if [[ -x "$hook" ]]; then
      echo "Running post-worktree hook..."
      "$hook" "$dir" 2>&1 || true
    fi
  fi

  dir="${dir:-$(pwd)}"
  dir="$(cd "$dir" && pwd)"

  ensure_session

  if tmux list-panes -s -t "$SESSION" -F '#{@llmux_name}' 2>/dev/null | grep -qxF "$name"; then
    echo "Error: pane '$name' already exists"
    # If we just grabbed a slot for this pane we should give it back so the
    # next attempt isn't blocked. The pane name collision is the user's bug;
    # silent slot leakage would compound it.
    [[ -n "$adopted_slot" ]] && release_slot "$adopted_slot"
    exit 1
  fi

  if read_paused | grep -q "^${name}|"; then
    echo "Error: pane '$name' is paused — resume it first with: llmux resume"
    [[ -n "$adopted_slot" ]] && release_slot "$adopted_slot"
    exit 1
  fi

  # Always split a new pane for the LLM tool (terminal pane stays on top)
  local new_pane
  new_pane=$(spawn_llm_pane "$dir")
  tmux select-pane -t "$new_pane" -T "$name"
  tmux set-option -p -t "$new_pane" @llmux_name "$name"
  tag_pane_worktree "$new_pane" "$dir"
  if [[ -n "$adopted_slot" ]]; then
    tmux set-option -p -t "$new_pane" @llmux_slot "$adopted_slot"
  fi
  if [[ -n "$project" ]]; then
    tmux set-option -p -t "$new_pane" @llmux_project "$project"
    register_project "$project"
    # After the pane exists on purpose: if the vault question is declined or
    # cancelled, you still get the thread you asked for.
    tolaria_attach_project "$project" "$name" "$tolaria_intent" || true
  fi
  apply_layout
  # `--tool none` = leave it a shell: no tool launched and no @llmux_tool set,
  # which is exactly what the sidebar classifier groups under TERMINALS. Passing
  # an empty tool would NOT do this — launch_tool_in_pane falls back to the
  # configured default when the tool is empty.
  if [[ "$tool_override" != "none" ]]; then
    launch_tool_in_pane "$new_pane" "$tool_override" "$name"
  fi
  echo "Created pane '$name' in $dir"
  # In sidebar mode the pane was spawned off the terminal pane, which lives in the
  # hidden _parked window — attach_to_pane does select-window and would drag the
  # client into that window, showing every thread tiled. cmd_switch is the
  # supported way to bring a thread into view, and it leaves window 0 as
  # [ sidebar | new thread ].
  if sidebar_enabled; then
    cmd_switch "$name"
  else
    attach_to_pane "$name"
  fi
}

cmd_prompt() {
  local prompt="" tool_override="" use_worktree=false name_override=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --tool) tool_override="${2:?--tool requires a value}"; shift 2 ;;
      --worktree|--wt) use_worktree=true; shift ;;
      --name) name_override="${2:?--name requires a value}"; shift 2 ;;
      *)
        if [[ -z "$prompt" ]]; then prompt="$1"
        else prompt+=" $1"
        fi
        shift
        ;;
    esac
  done

  if [[ -z "$prompt" ]] && ! [ -t 0 ]; then
    prompt=$(cat)
  fi
  [[ -z "$prompt" ]] && { echo "Usage: llmux prompt \"<prompt>\" [--tool <tool>] [--worktree] [--name <slug>]"; exit 1; }

  # --- Generate session slug ---
  local name="$name_override"
  if [[ -z "$name" ]]; then
    if command -v claude &>/dev/null; then
      echo "Naming session..." >&2
      name=$(claude -p --model haiku "Output ONLY a 2-4 word kebab-case slug (lowercase, hyphenated, max 24 chars, no quotes, no punctuation, no trailing newline) summarizing this coding-session prompt. Prompt: $prompt" 2>/dev/null \
        | tr -d '\r\n"`' \
        | tr '[:upper:]' '[:lower:]' \
        | tr -c 'a-z0-9-' '-' \
        | sed -E 's/-+/-/g; s/^-+//; s/-+$//' \
        | head -c 24)
    fi
    [[ -z "$name" ]] && name="prompt-$(date +%s)"
    echo "Session: $name" >&2
  fi

  # --- Worktree (mirrors cmd_add) ---
  local dir=""
  if $use_worktree; then
    local wt_dir
    wt_dir=$(create_worktree_for_pane "$name")
    dir=$(echo "$wt_dir" | tail -1)
    local repo_root
    repo_root=$(git rev-parse --show-toplevel 2>/dev/null || true)
    local hook="$repo_root/.llmux/post-worktree"
    if [[ -x "$hook" ]]; then
      echo "Running post-worktree hook..." >&2
      "$hook" "$dir" 2>&1 || true
    fi
  fi
  dir="${dir:-$(pwd)}"
  dir="$(cd "$dir" && pwd)"

  ensure_session

  if tmux list-panes -s -t "$SESSION" -F '#{@llmux_name}' 2>/dev/null | grep -qxF "$name"; then
    echo "Error: pane '$name' already exists" >&2
    exit 1
  fi
  if read_paused | grep -q "^${name}|"; then
    echo "Error: pane '$name' is paused — resume it first with: llmux resume" >&2
    exit 1
  fi

  local new_pane
  new_pane=$(spawn_llm_pane "$dir")
  tmux select-pane -t "$new_pane" -T "$name"
  tmux set-option -p -t "$new_pane" @llmux_name "$name"
  tag_pane_worktree "$new_pane" "$dir"
  apply_layout
  launch_tool_in_pane "$new_pane" "$tool_override" "$name"

  # After tool is ready (and /rename has fired at t≈3s), paste the prompt + Enter
  (
    sleep 5
    local buf="llmux-prompt-$$"
    tmux load-buffer -b "$buf" - <<<"$prompt"
    tmux paste-buffer -b "$buf" -t "$new_pane" -d
    sleep 0.3
    tmux send-keys -t "$new_pane" Enter
  ) &
  disown

  echo "Created pane '$name' in $dir with prompt"
  attach_to_pane "$name"
}

cmd_rm() {
  local force=0
  local name=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force|-f) force=1; shift ;;
      *) [[ -z "$name" ]] && name="$1"; shift ;;
    esac
  done

  if ! tmux has-session -t "$SESSION" 2>/dev/null; then
    echo "Error: no llmux session running"
    exit 1
  fi

  # If no name given, show a picker (exclude terminal and pinned panes)
  if [[ -z "$name" ]]; then
    local names=()
    while IFS= read -r line; do
      local n is_term is_pin
      n=$(echo "$line" | cut -d'|' -f1)
      is_term=$(echo "$line" | cut -d'|' -f2)
      is_pin=$(echo "$line" | cut -d'|' -f3)
      [[ -z "$n" ]] && continue
      [[ "$is_term" == "1" ]] && continue
      [[ "$is_pin" == "1" ]] && continue
      names+=("$n")
    done < <(tmux list-panes -s -t "$SESSION" -F '#{@llmux_name}|#{@llmux_terminal}|#{@llmux_pinned}')

    if [[ ${#names[@]} -eq 0 ]]; then
      echo "No named panes to remove."
      exit 0
    fi

    name=$(printf '%s\n' "${names[@]}" | gum filter \
      --header "Remove which pane?" \
      --indicator "▸" \
      --indicator.foreground "212" \
      --match.foreground "212" \
      --header.foreground "99" \
      --prompt.foreground "39")
    [[ -z "$name" ]] && exit 0
  fi

  # Prevent removing the terminal pane
  if [[ "$name" == "terminal" ]]; then
    local term_pane
    term_pane=$(get_terminal_pane)
    if [[ -n "$term_pane" ]]; then
      echo "Error: cannot remove the terminal pane"
      exit 1
    fi
  fi

  # Prevent removing the pinned pane
  local check_pin=""
  check_pin=$(tmux list-panes -s -t "$SESSION" -F '#{@llmux_name}|#{@llmux_pinned}' 2>/dev/null \
    | grep "^${name}|1$" || true)
  if [[ -n "$check_pin" ]]; then
    echo "Error: cannot remove the pinned pane"
    exit 1
  fi

  # Find the pane with this llmux name, also capturing its slot.
  local target_pane="" pane_slot=""
  while IFS='|' read -r pane_id pane_name pane_slot_val; do
    if [[ "$pane_name" == "$name" ]]; then
      target_pane="$pane_id"
      pane_slot="$pane_slot_val"
      break
    fi
  done < <(tmux list-panes -s -t "$SESSION" -F '#{pane_id}|#{@llmux_name}|#{@llmux_slot}')

  if [[ -z "$target_pane" ]]; then
    echo "Error: no pane named '$name'"
    exit 1
  fi

  # Dirty-check the slot before tearing the pane down — same rule as pause.
  # rm is more destructive (no paused.json entry survives), so refusing here
  # is the conservative choice; --force overrides.
  if [[ -n "$pane_slot" ]]; then
    if ! slot_dirty_check "$pane_slot" "$force"; then
      echo "Skipping '$name': $pane_slot is dirty (re-run with --force to release anyway)" >&2
      exit 1
    fi
  fi

  # WINDOW-SCOPED ON PURPOSE — do not add -s. This feeds a layout decision about
  # the window we are about to leave a hole in ("is the terminal the only thing
  # left beside this pane?"), so the count must be of the CURRENT window. Every
  # other list-panes in this file is a session-wide name lookup and needs -s; this
  # one is the exception.
  local pane_count
  pane_count=$(tmux list-panes -t "$SESSION" | wc -l | tr -d ' ')

  if [[ "$pane_count" -le 2 ]]; then
    # Only terminal + this pane left — kill just the LLM pane, keep terminal
    tmux kill-pane -t "$target_pane"
    echo "Removed pane '$name'"
  else
    tmux kill-pane -t "$target_pane"
    apply_layout
    echo "Removed pane '$name'"
  fi

  if [[ -n "$pane_slot" ]]; then
    release_slot "$pane_slot"
    echo "Released $pane_slot back to idle"
  fi
}

# Pause a single pane by name. Echoes a status line; returns 0 on success,
# non-zero on validation failure (so the caller can keep going through a list).
# Caller is responsible for calling apply_layout once after a batch.
pause_one() {
  local name="$1"
  local force="${2:-0}"

  if [[ "$name" == "terminal" ]]; then
    echo "Skipping '$name': cannot pause the terminal pane"
    return 1
  fi
  # -s on every scan below: in sidebar mode all but the visible thread live in the
  # hidden _parked window, so a window-scoped lookup found only whatever happened
  # to be on screen and `llmux pause <parked-thread>` reported "no pane with that
  # name". The sidebar pane and parked anchor that -s also exposes both carry an
  # empty @llmux_name, so the name match here and the empty-name guards below
  # already exclude them.
  local check_pin=""
  check_pin=$(tmux list-panes -s -t "$SESSION" -F '#{@llmux_name}|#{@llmux_pinned}' 2>/dev/null \
    | grep "^${name}|1$" || true)
  if [[ -n "$check_pin" ]]; then
    echo "Skipping '$name': cannot pause the pinned pane"
    return 1
  fi

  local target_pane="" pane_dir="" pane_tool="" pane_wt="" pane_sid="" pane_slot="" pane_project=""
  while IFS='|' read -r pid pname pdir ptool pwt pterm psid pslot pproj; do
    if [[ "$pname" == "$name" ]]; then
      target_pane="$pid"
      pane_dir="$pdir"
      pane_tool="$ptool"
      pane_wt="$pwt"
      pane_sid="$psid"
      pane_slot="$pslot"
      pane_project="$pproj"
      break
    fi
  done < <(tmux list-panes -s -t "$SESSION" -F '#{pane_id}|#{@llmux_name}|#{pane_current_path}|#{@llmux_tool}|#{@llmux_worktree}|#{@llmux_terminal}|#{@llmux_claude_session}|#{@llmux_slot}|#{@llmux_project}')

  if [[ -z "$target_pane" ]]; then
    echo "Skipping '$name': no pane with that name"
    return 1
  fi

  # If pane owns a slot, dirty-check before kill — pause is meant to free the
  # slot for the next session, so leaving uncommitted work behind would just
  # get clobbered on the next grab.
  if [[ -n "$pane_slot" ]]; then
    if ! slot_dirty_check "$pane_slot" "$force"; then
      echo "Skipping '$name': $pane_slot is dirty (re-run with --force to release anyway)" >&2
      return 1
    fi
  fi

  # If an active pane and a paused entry coexist with this name, the paused
  # entry is stale (the session-history resume path doesn't clean up). Self-heal
  # rather than blocking the pause.
  if read_paused | grep -q "^${name}|"; then
    remove_paused "$name" >/dev/null 2>&1 || true
  fi

  add_paused "$name" "$pane_dir" "$pane_tool" "$pane_wt" "$pane_sid" "$pane_slot" "$pane_project"
  tmux kill-pane -t "$target_pane"
  if [[ -n "$pane_slot" ]]; then
    release_slot "$pane_slot"
    echo "Paused '$name' (released $pane_slot back to idle)"
  else
    echo "Paused '$name'"
  fi
  return 0
}

cmd_pause() {
  if ! tmux has-session -t "$SESSION" 2>/dev/null; then
    echo "Error: no llmux session running"
    exit 1
  fi

  local force=0
  local names=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force|-f) force=1; shift ;;
      *) names+=("$1"); shift ;;
    esac
  done

  if [[ ${#names[@]} -eq 0 ]]; then
    # No args: show multi-select picker (exclude terminal and pinned panes)
    local pickable=()
    while IFS='|' read -r n is_term is_pin; do
      [[ -z "$n" ]] && continue
      [[ "$is_term" == "1" ]] && continue
      [[ "$is_pin" == "1" ]] && continue
      pickable+=("$n")
    done < <(tmux list-panes -s -t "$SESSION" -F '#{@llmux_name}|#{@llmux_terminal}|#{@llmux_pinned}')

    if [[ ${#pickable[@]} -eq 0 ]]; then
      echo "No panes to pause."
      exit 0
    fi

    local selection
    selection=$(printf '%s\n' "${pickable[@]}" | gum filter \
      --no-limit \
      --header "Pause which panes? (tab to select, enter to confirm)" \
      --indicator "▸" \
      --indicator.foreground "212" \
      --match.foreground "212" \
      --header.foreground "99" \
      --prompt.foreground "39")
    [[ -z "$selection" ]] && exit 0

    while IFS= read -r n; do
      [[ -n "$n" ]] && names+=("$n")
    done <<< "$selection"
  fi

  local paused_count=0
  for name in "${names[@]}"; do
    pause_one "$name" "$force" && paused_count=$((paused_count + 1))
  done

  if [[ $paused_count -gt 0 ]]; then
    apply_layout
    echo "Resume anytime with: llmux resume"
  fi
}

# Does session <sid> have a transcript under <cwd>'s claude project dir?
# Guards against a stale or cross-pane @llmux_claude_session tag — one that
# points at a session belonging to a different pane, a different cwd, or one
# that no longer exists on disk.
claude_session_in_cwd() {
  local sid="$1" cwd="$2"
  [[ -n "$sid" && -n "$cwd" ]] || return 1
  python3 - "$sid" "$cwd" <<'PY'
import os, sys
sid, cwd = sys.argv[1], sys.argv[2]
root = os.path.expanduser('~/.claude/projects')
slugs = set()
for c in (cwd, os.path.realpath(cwd)):
    slugs.add(c.replace('/', '-'))
    slugs.add(c.replace('/', '-').replace('.', '-'))
sys.exit(0 if any(os.path.isfile(os.path.join(root, s, sid + '.jsonl')) for s in slugs) else 1)
PY
}

# Recent claude sessions whose cwd is <dir>, as "uuid|when|summary" lines,
# newest first. Reuses the resume harvester so the summaries match what
# `llmux resume` shows.
claude_sessions_for_dir() {
  local cwd="$1" real
  real="$(cd "$cwd" 2>/dev/null && pwd -P || printf '%s' "$cwd")"
  harvest_claude_sessions 2>/dev/null \
    | awk -F'|' -v a="$cwd" -v b="$real" '$2==a || $2==b {print $1"|"$3"|"$4}'
}

# Cycle every pane (terminal excepted). cmd_cycle relays on the classic tiler
# (apply_layout), which would fight the sidebar column, so in sidebar mode we
# drop to classic first, cycle each pane there, then rebuild the sidebar once.
cmd_cycle_all() {
  if ! tmux has-session -t "$SESSION" 2>/dev/null; then
    echo "Error: no llmux session running" >&2
    return 1
  fi

  # Collect cyclable names up front (the pane set changes as we cycle). The tool
  # comes along because a tool-less pane needs an explicit `--tool none`: plain
  # `cmd_cycle` now refuses to guess what an untagged pane should become, and for a
  # sweep that means "restart everything" the right answer for a shell is to
  # restart it AS a shell rather than skip it.
  local names=() n is_term tool
  while IFS='|' read -r n is_term tool; do
    [[ -z "$n" || "$is_term" == "1" ]] && continue
    names+=("${n}|${tool}")
  done < <(tmux list-panes -s -t "$SESSION" -F '#{@llmux_name}|#{@llmux_terminal}|#{@llmux_tool}')

  if [[ ${#names[@]} -eq 0 ]]; then
    echo "No panes to cycle."
    return 0
  fi

  local labels=()
  for n in "${names[@]}"; do labels+=("${n%%|*}"); done
  echo "Cycling ${#names[@]} pane(s): ${labels[*]}"

  local was_sidebar=0
  if sidebar_enabled; then
    was_sidebar=1
    cmd_sidebar off >/dev/null 2>&1 || true
  fi

  local entry nm tl
  for entry in "${names[@]}"; do
    nm="${entry%%|*}"
    tl="${entry#*|}"
    # Subshell so a cmd_cycle that `exit`s on one pane (e.g. an ambiguous claude
    # session it refuses to guess) skips just that pane instead of aborting the
    # whole sweep. CYCLE_NO_ATTACH stops focus bouncing across every pane.
    if [[ -z "$tl" ]]; then
      ( CYCLE_NO_ATTACH=1 cmd_cycle "$nm" --tool none ) || echo "  (skipped '$nm')" >&2
    else
      ( CYCLE_NO_ATTACH=1 cmd_cycle "$nm" ) || echo "  (skipped '$nm')" >&2
    fi
  done

  # Restoring the sidebar can genuinely fail — the rebuild join-panes every thread
  # back and that runs out of room past roughly five of them. Swallowing it with
  # `|| true` left the session silently in classic mode, and the next `llmux switch`
  # then failed with "sidebar mode is off", which points nowhere near the cause.
  # Say it here, where the user can act on it.
  if [[ "$was_sidebar" == "1" ]]; then
    if ! cmd_sidebar on >/dev/null 2>&1 || ! sidebar_enabled; then
      echo "Warning: could not rebuild the sidebar after cycling — the session is in" >&2
      echo "         classic mode. Re-run: llmux sidebar on" >&2
    fi
  fi

  echo "Cycled ${#names[@]} pane(s)."
}

# Restart a pane as a bare shell, IN PLACE. respawn-pane keeps the pane id and
# every @llmux_* option set on it, so name / project / worktree / pin survive with
# nothing re-applied — which is why this needs none of the metadata the tool path
# has to thread through a kill-and-respawn.
respawn_bare_shell() {
  local pane="${1:-}" dir="${2:-}" name="${3:-}"
  [[ -z "$pane" ]] && return 1
  [[ -d "$dir" ]] || dir="$HOME"
  if ! tmux respawn-pane -k -t "$pane" -c "$dir" 2>/dev/null; then
    echo "Error: could not restart '${name:-$pane}'" >&2
    return 1
  fi
  # A tool-less pane must carry NO @llmux_tool at all: an UNSET tool is what the
  # sidebar classifier reads as "terminal", and what every launch path reads as
  # "nothing to start". Storing the string "none" would look like a program name.
  tmux set-option -pu -t "$pane" @llmux_tool 2>/dev/null || true
  if sidebar_enabled; then
    render_sidebar
  fi
  echo "Cycled '${name:-$pane}' (bare shell)"
  return 0
}

cmd_cycle() {
  local name="" tool_override=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --tool) tool_override="${2:?--tool requires a value}"; shift 2 ;;
      --tool=*) tool_override="${1#--tool=}"; shift ;;
      *) [[ -z "$name" ]] && name="$1"; shift ;;
    esac
  done

  if ! tmux has-session -t "$SESSION" 2>/dev/null; then
    echo "Error: no llmux session running"
    exit 1
  fi

  if [[ "$name" == "all" ]]; then
    cmd_cycle_all
    return $?
  fi

  # Picker if no name given (exclude terminal; pinned is fine — pin state is
  # preserved through the cycle).
  if [[ -z "$name" ]]; then
    local names=()
    while IFS='|' read -r n is_term _is_pin; do
      [[ -z "$n" || "$is_term" == "1" ]] && continue
      names+=("$n")
    done < <(tmux list-panes -s -t "$SESSION" -F '#{@llmux_name}|#{@llmux_terminal}|#{@llmux_pinned}')

    if [[ ${#names[@]} -eq 0 ]]; then
      echo "No panes to cycle."
      exit 0
    fi

    name=$(printf '%s\n' "${names[@]}" | gum filter \
      --header "Cycle which pane?" \
      --indicator "▸" \
      --indicator.foreground "212" \
      --match.foreground "212" \
      --header.foreground "99" \
      --prompt.foreground "39")
    [[ -z "$name" ]] && exit 0
  fi

  if [[ "$name" == "terminal" ]]; then
    echo "Error: cannot cycle the terminal pane"
    exit 1
  fi

  # Capture pane metadata before killing — including the captured claude session
  # UUID so we resume the exact same session (--resume <id>) rather than
  # --continue, which only grabs the most-recent session in the cwd.
  local target_pane="" pane_dir="" pane_tool="" pane_wt="" pane_pinned="" pane_sid="" pane_ocsid="" pane_project=""
  while IFS='|' read -r pid pname pdir ptool pwt _pterm ppin psid pocsid pproj; do
    if [[ "$pname" == "$name" ]]; then
      target_pane="$pid"; pane_dir="$pdir"; pane_tool="$ptool"; pane_wt="$pwt"; pane_pinned="$ppin"
      pane_sid="$psid"; pane_ocsid="$pocsid"; pane_project="$pproj"
      break
    fi
  done < <(tmux list-panes -s -t "$SESSION" -F '#{pane_id}|#{@llmux_name}|#{pane_current_path}|#{@llmux_tool}|#{@llmux_worktree}|#{@llmux_terminal}|#{@llmux_pinned}|#{@llmux_claude_session}|#{@llmux_opencode_session}|#{@llmux_project}')

  if [[ -z "$target_pane" ]]; then
    echo "Error: no pane named '$name'"
    exit 1
  fi

  if [[ ! -d "$pane_dir" ]]; then
    echo "Warning: directory $pane_dir no longer exists, using home directory"
    pane_dir="$HOME"
  fi

  # An empty @llmux_tool means one of TWO different things, and nothing stored on
  # the pane distinguishes them: `llmux add --tool none` leaves a deliberate plain
  # shell untagged, and `llmux grab` doesn't tag what it adopts either.
  #
  # This used to silently resolve to the configured default tool for both. On a
  # deliberate shell that is wrong twice over: with several claude sessions in the
  # cwd cycle aborts with a confusing session error, and with EXACTLY ONE it
  # quietly turns your shell pane into a claude pane resuming an unrelated thread.
  # Silently opening the wrong session is the bug class this function already
  # refuses to commit for tagged panes — so it must not commit it here either.
  #
  # Adopting a tool is now something you ASK for: `llmux cycle <name> --tool X`.
  #
  # `--tool none` means the same here as in cmd_add — leave it a bare shell — so it
  # must NOT be stored as a tool named "none" or resume_tool_in_pane would try to
  # launch that. It is the one --tool value that is a sentinel, not a program.
  if [[ "$tool_override" == "none" ]]; then
    respawn_bare_shell "$target_pane" "$pane_dir" "$name"
    return $?
  fi
  if [[ -z "$pane_tool" ]]; then
    if [[ -z "$tool_override" ]]; then
      echo "Error: '$name' has no tool tagged, so there is nothing to resume." >&2
      echo "       It's either a plain shell (--tool none) or an adopted pane (llmux grab)." >&2
      echo "       To restart it as a bare shell:  llmux cycle $name --tool none" >&2
      echo "       To give it a platform:          llmux cycle $name --tool <claude|codex|opencode|amp>" >&2
      exit 1
    fi
    pane_tool="$tool_override"
  fi
  # An explicit --tool always wins, so cycle can also switch a pane's platform.
  [[ -n "$tool_override" ]] && pane_tool="$tool_override"

  # Resolve WHICH claude session to resume before killing anything.
  #
  # cycle used to trust @llmux_claude_session blindly, and silently fall back to
  # `--continue` (= most-recent session in the cwd) when it was empty. Both open
  # the WRONG thread as soon as two panes share a cwd, which is the normal case
  # (several panes in ~/ or ~/owner/Owner). Resolving here — before the pane is
  # destroyed — means an ambiguous case can bail out costing nothing.
  # opencode keeps its sessions in a sqlite db rather than per-cwd transcripts, so
  # there is no cwd-ambiguity problem to resolve — carry the tag straight through.
  # Untagged panes fall through to `--continue` (most recent), which is the best
  # available guess for a session id that is only minted on the first message.
  if [[ "$pane_tool" == "opencode" ]]; then
    pane_sid="$pane_ocsid"
  fi

  if [[ "$pane_tool" == "claude" ]]; then
    if [[ -n "$pane_sid" ]] && ! claude_session_in_cwd "$pane_sid" "$pane_dir"; then
      echo "Warning: '$name' is tagged with session $pane_sid, which has no transcript" >&2
      echo "         under $pane_dir. Ignoring the stale tag." >&2
      pane_sid=""
    fi

    if [[ -z "$pane_sid" ]]; then
      local cands cand_count
      cands="$(claude_sessions_for_dir "$pane_dir")"
      cand_count="$(printf '%s' "$cands" | grep -c . || true)"

      if [[ "$cand_count" -eq 1 ]]; then
        pane_sid="${cands%%|*}"
        echo "[llmux] '$name' had no session tag; resuming the only claude session in $pane_dir."
      elif [[ "$cand_count" -gt 1 ]]; then
        # Refuse to guess. Offer a picker when we can, error out when we can't.
        if [[ -t 0 ]] && command -v gum >/dev/null 2>&1; then
          echo "[llmux] '$name' has no session tag and $cand_count claude sessions share $pane_dir." >&2
          local choice
          choice=$(printf '%s\n' "$cands" \
            | awk -F'|' '{printf "%s  [%s]  %s\n", substr($1,1,8), $2, $3}' \
            | gum filter \
                --header "Which session is '$name'?" \
                --indicator "▸" \
                --indicator.foreground "212" \
                --match.foreground "212" \
                --header.foreground "99" \
                --prompt.foreground "39")
          [[ -z "$choice" ]] && { echo "Aborted — nothing was cycled." >&2; exit 0; }
          local short="${choice%% *}"
          pane_sid="$(printf '%s\n' "$cands" | awk -F'|' -v s="$short" 'index($1,s)==1{print $1; exit}')"
          [[ -z "$pane_sid" ]] && { echo "Error: could not resolve that choice." >&2; exit 1; }
        else
          echo "Error: '$name' has no @llmux_claude_session tag, and $cand_count claude" >&2
          echo "       sessions share $pane_dir. Refusing to guess — cycle would likely" >&2
          echo "       open the wrong thread." >&2
          echo "       Pick one explicitly with 'llmux resume', or tag the pane:" >&2
          echo "         tmux set-option -p -t $target_pane @llmux_claude_session <uuid>" >&2
          echo "       Candidates (newest first):" >&2
          printf '%s\n' "$cands" | head -8 | awk -F'|' '{printf "         %s  [%s]  %s\n", $1, $2, $3}' >&2
          exit 1
        fi
      fi
      # cand_count == 0: nothing to resume; fall through to a fresh session.
    fi
  fi

  # Kill old pane, recreate at same name with same metadata, restart the tool.
  # This is pause+resume in one step — skips the paused.json roundtrip.
  tmux kill-pane -t "$target_pane"

  local new_pane
  new_pane=$(spawn_llm_pane "$pane_dir")
  tmux select-pane -t "$new_pane" -T "$name"
  tmux set-option -p -t "$new_pane" @llmux_name "$name"
  [[ -n "$pane_wt" ]] && tmux set-option -p -t "$new_pane" @llmux_worktree "$pane_wt"
  # Preserve pinned state so apply_layout repositions the pane back into the
  # top-right slot instead of treating it like a regular LLM pane.
  [[ "$pane_pinned" == "1" ]] && tmux set-option -p -t "$new_pane" @llmux_pinned "1"
  # Same reasoning for the project: a cycle must not silently move a thread back
  # to scratch, which is what dropping the tag would look like in the sidebar.
  [[ -n "$pane_project" ]] && tmux set-option -p -t "$new_pane" @llmux_project "$pane_project"
  tag_pane_worktree "$new_pane" "$pane_dir"
  apply_layout

  # pane_tool was already resolved (and the claude session validated) before the
  # kill, so there's nothing left to decide here.
  if [[ -n "$pane_tool" ]]; then
    resume_tool_in_pane "$new_pane" "$pane_tool" "$name" "$pane_sid"
  else
    echo "Warning: '$name' had no @llmux_tool and no default tool configured — pane is bare shell" >&2
  fi

  echo "Cycled '$name'"
  # `cycle all` sets CYCLE_NO_ATTACH so focus doesn't bounce across every pane
  # as the sweep runs; a plain `cycle <name>` still attaches as before.
  [[ -n "${CYCLE_NO_ATTACH:-}" ]] || attach_to_pane "$name"
}

detect_worktree() {
  local dir="$1"
  [[ ! -d "$dir" ]] && return 0
  local git_dir git_common
  git_dir=$(git -C "$dir" rev-parse --git-dir 2>/dev/null) || return 0
  git_common=$(git -C "$dir" rev-parse --git-common-dir 2>/dev/null) || return 0
  # If git-dir != git-common-dir, this is a worktree
  local abs_git_dir abs_common
  abs_git_dir=$(cd "$dir" && cd "$git_dir" && pwd)
  abs_common=$(cd "$dir" && cd "$git_common" && pwd)
  if [[ "$abs_git_dir" != "$abs_common" ]]; then
    local branch
    branch=$(git -C "$dir" rev-parse --abbrev-ref HEAD 2>/dev/null)
    echo "${branch:-detached}"
  fi
}

tag_pane_worktree() {
  local pane_target="$1"
  local dir="$2"
  local wt
  wt=$(detect_worktree "$dir")
  if [[ -n "$wt" ]]; then
    tmux set-option -p -t "$pane_target" @llmux_worktree "$wt"
  fi
  # Also tag the slot when the pane lands inside an owner-wt slot dir, so the
  # @llmux_slot var is set even for panes created without --slot (e.g. via
  # `llmux grab` of a pane that was already running inside .workspaces/slot-N).
  if [[ "$dir" == "$OWNER_SLOTS_DIR/slot-"* ]]; then
    local rel="${dir#$OWNER_SLOTS_DIR/}"
    local slot_name="${rel%%/*}"
    tmux set-option -p -t "$pane_target" @llmux_slot "$slot_name"
  fi
}

# Return the owner-wt slot name (slot-N) hosting a given path, or empty if
# the path isn't under .workspaces/.
slot_from_path() {
  local dir="$1"
  if [[ "$dir" == "$OWNER_SLOTS_DIR/slot-"* ]]; then
    local rel="${dir#$OWNER_SLOTS_DIR/}"
    echo "${rel%%/*}"
  fi
}

# Output newline-separated names of idle slots (detached HEAD). Empty if
# the slots dir doesn't exist or no slots are idle.
list_idle_slots() {
  [ -d "$OWNER_SLOTS_DIR" ] || return 0
  local slot branch
  for slot in "$OWNER_SLOTS_DIR"/slot-*; do
    [ -d "$slot" ] || continue
    branch=$(git -C "$slot" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
    [ "$branch" = "HEAD" ] && echo "${slot##*/}"
  done
}

# Pick an idle slot, honoring user intent. Emits the chosen slot name on
# stdout, or returns nonzero with an explanatory message on stderr.
#   $1 (optional): explicit slot name (slot-2 or just 2)
# Behavior:
#   - explicit specified → validate it exists and is idle, use it
#   - 0 idle  → error
#   - 1 idle  → use it silently
#   - >1 idle → gum picker
pick_idle_slot() {
  local explicit="${1:-}"
  if [[ -n "$explicit" ]]; then
    [[ "$explicit" =~ ^[0-9]+$ ]] && explicit="slot-$explicit"
    local path="$OWNER_SLOTS_DIR/$explicit"
    if [[ ! -d "$path" ]]; then
      echo "Error: $explicit does not exist under $OWNER_SLOTS_DIR" >&2
      return 1
    fi
    local branch
    branch=$(git -C "$path" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")
    if [[ "$branch" != "HEAD" ]]; then
      echo "Error: $explicit is not idle (currently on $branch). Release it first or pick another slot." >&2
      return 1
    fi
    echo "$explicit"
    return 0
  fi

  local idle=()
  while IFS= read -r s; do
    idle+=("$s")
  done < <(list_idle_slots)

  # 0 idle → before giving up, try reclaiming "unclaimed" slots (branch checked
  # out but no pane / paused entry owns them — a session that ended without
  # releasing). gc only releases clean unclaimed slots; in-use and dirty slots
  # are never touched. All gc output goes to stderr — stdout must stay clean
  # (callers capture it as the chosen slot name).
  if [[ ${#idle[@]} -eq 0 ]] && command -v owner-wt >/dev/null 2>&1; then
    echo "No idle slots — attempting reclaim of unclaimed slots (owner-wt gc)..." >&2
    (cd "$OWNER_REPO_ROOT" && owner-wt gc) >&2 || true
    idle=()
    while IFS= read -r s; do
      idle+=("$s")
    done < <(list_idle_slots)
  fi

  local n=${#idle[@]}
  if [[ $n -eq 0 ]]; then
    echo "Error: no idle slots. Run 'owner-wt add' to grow the pool, or release a slot." >&2
    echo "All slots are held by live panes/paused sessions or dirty. Try: llmux pause <pane> | owner-wt gc --dry-run" >&2
    return 1
  elif [[ $n -eq 1 ]]; then
    echo "${idle[0]}"
    return 0
  else
    local choice
    choice=$(printf '%s\n' "${idle[@]}" | gum choose --header "Adopt which idle slot?" \
      --cursor.foreground "212") || true
    [[ -z "$choice" ]] && return 1
    echo "$choice"
    return 0
  fi
}

# Refuse to release a slot that has uncommitted/unstaged changes unless
# `force` is "1". Echoes the dirty/unpushed summary on stderr when blocking.
# Args: slot_name force
slot_dirty_check() {
  local slot_name="$1"
  local force="${2:-0}"
  local path="$OWNER_SLOTS_DIR/$slot_name"
  [ -d "$path" ] || return 0  # nothing to check

  local dirty=""
  if ! git -C "$path" diff --quiet 2>/dev/null; then dirty+="unstaged "; fi
  if ! git -C "$path" diff --cached --quiet 2>/dev/null; then dirty+="staged "; fi
  if [ -n "$(git -C "$path" ls-files --others --exclude-standard 2>/dev/null)" ]; then dirty+="untracked "; fi

  if [[ -n "$dirty" && "$force" != "1" ]]; then
    echo "Error: $slot_name has $dirty changes on $(git -C "$path" rev-parse --abbrev-ref HEAD 2>/dev/null). Commit/stash or pass --force." >&2
    return 1
  fi
  return 0
}

# Run owner-wt release; tolerate failure (just warn) so a pane teardown
# doesn't get stuck when owner-wt is unavailable or the slot is missing.
release_slot() {
  local slot_name="$1"
  command -v owner-wt >/dev/null 2>&1 || {
    echo "Warning: owner-wt not on PATH; can't auto-release $slot_name" >&2
    return 0
  }
  (cd "$OWNER_REPO_ROOT" && owner-wt release "$slot_name") || {
    echo "Warning: owner-wt release $slot_name failed; you may need to release it manually." >&2
    return 0
  }
}

cmd_worktree() {
  local name="${1:-}"
  local branch="${2:-}"

  if ! tmux has-session -t "$SESSION" 2>/dev/null; then
    echo "Error: no llmux session running"
    exit 1
  fi

  [[ -z "$name" ]] && { echo "Usage: llmux worktree <pane-name> [branch]"; exit 1; }

  # Find the pane
  local pane_id=""
  local pane_path=""
  while IFS='|' read -r pid pname ppath; do
    if [[ "$pname" == "$name" ]]; then
      pane_id="$pid"
      pane_path="$ppath"
      break
    fi
  done < <(tmux list-panes -s -t "$SESSION" -F '#{pane_id}|#{@llmux_name}|#{pane_current_path}')

  [[ -z "$pane_id" ]] && { echo "Error: no pane named '$name'"; exit 1; }

  if [[ -z "$branch" ]]; then
    # Auto-detect from pane's current directory
    branch=$(detect_worktree "$pane_path")
    [[ -z "$branch" ]] && { echo "Error: pane '$name' is not in a worktree. Pass branch explicitly: llmux worktree '$name' <branch>"; exit 1; }
  fi

  tmux set-option -p -t "$pane_id" @llmux_worktree "$branch"
  echo "Tagged '$name' → $branch"
}

# ── Startup context ──────────────────────────────────────────────────────────
#
# What a new agent should read before it does anything. Everything here is already
# in llmux -- the project, its notes, its flags and dashboards, the PRs in flight,
# the docs waiting on Jay, the sibling threads -- and until now a fresh session knew
# only its own name. It would ask about, or worse re-do, work another thread had
# already finished.
#
# It POINTS more than it prints. A wall of file contents in every session is a tax
# on every trivial one; a list of exact paths costs a few lines and the agent reads
# what its task actually needs.
cmd_context() {
  local pane="${TMUX_PANE:-}" name="" project="" tool="" cwd="" sid=""
  if [[ -n "$pane" ]]; then
    IFS='|' read -r name project tool cwd sid < <(tmux display-message -p -t "$pane" \
      '#{@llmux_name}|#{@llmux_project}|#{@llmux_tool}|#{pane_current_path}|#{@llmux_claude_session}' 2>/dev/null || true)
  fi
  [[ -n "${1:-}" ]] && project="$1"
  [[ -z "$project" ]] && project="$SCRATCH_KEY"

  echo "# Thread"
  echo "name:     ${name:-（not in an llmux pane）}"
  echo "project:  $project"
  [[ -n "$tool" ]] && echo "tool:     $tool"
  [[ -n "$cwd" ]]  && echo "cwd:      $cwd"
  [[ -n "$sid" ]]  && echo "session:  $sid"

  # ── the project's notes ────────────────────────────────────────────────────
  local slug=""
  slug=$(tolaria_slug_for_key "$project")
  echo
  echo "# Project notes"
  if [[ -n "$slug" ]]; then
    local st; st=$(tolaria_status "$slug")
    echo "vault project: $slug${st:+  (status: $st)}"
    echo "READ FIRST, in this order:"
    echo "  $(tolaria_hub "$slug")"
    local n label i=0
    for n in "${TOLARIA_NOTES[@]}"; do
      label="${TOLARIA_NOTE_LABELS[$i]}"; i=$(( i + 1 ))
      case "$n" in
        intent|open-questions|decisions|todo)
          echo "  $TOLARIA_PROJECTS_DIR/$slug/$slug-$n.md   # $label" ;;
      esac
    done
    echo "  (then $slug-log.md for what happened most recently -- read its TAIL)"
  else
    if [[ "$project" == "$SCRATCH_KEY" ]]; then
      # SCRATCH is where unassigned threads land; it is not a project and never gets
      # notes. Telling an agent to create them for it would make a junk vault entry.
      echo "none — this thread is unassigned (SCRATCH). If the work belongs to a"
      echo "project, 'llmux mv $name <project>' files it and this command gets useful."
    else
      echo "none linked. If this project earns notes, 'llmux project new $project' creates them."
    fi
  fi

  # ── what the project points at ─────────────────────────────────────────────
  local kind k v1 v2 v3 mon="" flags="" forge=""
  while IFS='|' read -r kind k v1 v2 v3; do
    [[ "$k" == "$project" ]] || continue
    case "$kind" in
      m) mon="$v1" ;;
      f) flags="${flags:+$flags, }$v1" ;;
      g) forge="${forge:+$forge, }${v2:-untitled task}" ;;
    esac
  done < <(read_project_links | awk -F'\t' '{print $1"|"$2"|"$3"|"$4"|"$5}')
  if [[ -n "$mon$flags$forge" ]]; then
    echo
    echo "# This project is wired to"
    [[ -n "$mon" ]]   && echo "monitor:     $mon"
    [[ -n "$flags" ]] && echo "flags:       $flags"
    [[ -n "$forge" ]] && echo "forge tasks: $forge"
  fi

  # ── work already in flight ─────────────────────────────────────────────────
  local repo number url title pproj branch base stack had_pr=0
  while IFS='|' read -r repo number url title pproj branch base stack; do
    [[ "$pproj" == "$project" && -n "$number" ]] || continue
    (( had_pr )) || { echo; echo "# PRs registered under this project"; had_pr=1; }
    echo "  #${number} ${title}${stack:+  [stack: $stack]}"
  done < <(read_prs)

  local r_proj r_id r_state r_title r_url had_rev=0
  while IFS=$'\t' read -r r_proj r_id r_state r_title r_url; do
    [[ "$r_proj" == "$project" && "$r_state" == "pending" ]] || continue
    (( had_rev )) || { echo; echo "# Docs waiting on Jay (do not re-decide what these settle)"; had_rev=1; }
    echo "  #${r_id} ${r_title}"
    echo "        ${r_url}"
  done < <(build_review_rows "$(known_projects | tr '\n' ',')" 2>/dev/null || true)

  # ── who else is here ───────────────────────────────────────────────────────
  local p_id p_name p_proj p_tool p_status p_sid p_cwd p_done had_sib=0
  while IFS='|' read -r p_id p_name p_proj p_tool p_status p_sid p_cwd p_done; do
    [[ "$p_proj" == "$project" && "$p_name" != "$name" ]] || continue
    (( had_sib )) || { echo; echo "# Other threads on this project -- ASK THEM before redoing their work"; echo "# (llmux send <name> \"...\")"; had_sib=1; }
    echo "  ${p_name}  [${p_status:-working}]  ${p_cwd/#$HOME/~}"
  done < <(thread_directory)

  # ── the repo you are standing in ───────────────────────────────────────────
  if [[ -n "$cwd" && -d "$cwd" ]]; then
    local f found=""
    for f in CLAUDE.md AGENTS.md CLAUDE.local.md .context; do
      [[ -e "$cwd/$f" ]] && found="${found:+$found, }$f"
    done
    local branch=""
    branch=$(git -C "$cwd" rev-parse --abbrev-ref HEAD 2>/dev/null || true)
    if [[ -n "$found$branch" ]]; then
      echo
      echo "# Repo at $cwd"
      [[ -n "$branch" ]] && echo "branch: $branch"
      [[ -n "$found" ]]  && echo "read:   $found"
    fi
  fi

  echo
  echo "# Before taking instructions"
  echo "Read the notes listed above -- at minimum the hub, intent, decisions and"
  echo "open-questions -- plus any CLAUDE.md/AGENTS.md in the repo. Then say in one or"
  echo "two lines what this project is and where it stands. If a sibling thread already"
  echo "owns the piece you are being asked for, message it rather than duplicating it."
}

# ── Message passing between threads ──────────────────────────────────────────
#
# `who` is the directory an agent reads to decide who to talk to; `send` delivers.
#
# Delivery goes through the PANE, not through `claude --resume <id> -p`. The session
# id is the right way to NAME a thread and it is recorded per pane already, but
# resuming a session that a live TUI is holding open puts two writers on one
# transcript -- that corrupts the session rather than delivering a message. The pane
# is where a running agent actually reads input, so that is the mailbox.
#
# Everything here is derived from tmux pane options. No new state, and a thread that
# dies takes its mailbox with it, which is correct: there is nobody to read it.

# The thread the CALLER is running in, if any. -t "$TMUX_PANE" rather than a bare
# display-message, which answers for whichever pane is active and would credit a
# background agent's message to whatever thread Jay is looking at.
sender_thread_name() {
  R_SENDER=""
  [[ -n "${TMUX_PANE:-}" ]] || return 0
  R_SENDER=$(tmux display-message -p -t "$TMUX_PANE" '#{@llmux_name}' 2>/dev/null || true)
}

# Emits: pane_id|name|project|tool|status|session_id|cwd|done_at
#
# STATUS is llmux-watch's read of the pane, and its vocabulary is worth knowing before
# you trust it:
#   idle     at the prompt with nothing to do -- safe to interrupt, will read at once
#   (empty)  producing output right now; rendered "working"
#   busy     producing output for 2+ minutes straight
#   blocked  stopped on a question or a menu
#   perm     stopped on a permission gate
# It is a LAGGING indicator: the watcher samples every 5s, and `idle` for claude needs
# either a bare prompt line or 30s of an unchanged screen. So "not yet idle" can mean
# "finished two seconds ago". done_at (the finish edge, 0 once Jay has looked) is what
# turns that into a real answer: idle WITH a done_at is definitely finished.
# Only real threads -- the terminal, sidebar and parked anchor are infrastructure and
# have nobody to talk to.
thread_directory() {
  tmux list-panes -s -t "$SESSION" \
    -F '#{pane_id}|#{@llmux_name}|#{@llmux_project}|#{@llmux_tool}|#{@llmux_status}|#{@llmux_claude_session}|#{@llmux_opencode_session}|#{pane_current_path}|#{@llmux_terminal}|#{@llmux_sidebar}|#{@llmux_parked_anchor}|#{@llmux_done_at}' \
    2>/dev/null | awk -F'|' '
      $2 != "" && $9 != "1" && $10 != "1" && $11 != "1" {
        sid = ($6 != "") ? $6 : $7
        printf "%s|%s|%s|%s|%s|%s|%s|%s\n", $1, $2, ($3 == "" ? "scratch" : $3), $4, $5, sid, $8, $12
      }'
}

cmd_who() {
  local as_json=0
  [[ "${1:-}" == "--json" ]] && as_json=1
  if ! tmux has-session -t "$SESSION" 2>/dev/null; then
    echo "No llmux session running" >&2; return 1
  fi
  sender_thread_name; local me="$R_SENDER"
  local pane_id name project tool status sid cwd done_at now_ts
  now_ts=$(date +%s)
  if (( as_json )); then
    # For agents: one object per thread, so picking a recipient is a filter and not
    # a screen-scrape of a column layout that may change.
    local first=1
    printf '['
    while IFS='|' read -r pane_id name project tool status sid cwd done_at; do
      [[ -z "$name" ]] && continue
      (( first )) || printf ','
      first=0
      local idle_for=""
      [[ -n "$done_at" && "$done_at" != "0" ]] && idle_for=$(( now_ts - done_at ))
      python3 -c '
import json, sys
idle = sys.argv[8]
print(json.dumps({"name": sys.argv[1], "project": sys.argv[2], "tool": sys.argv[3],
                  "status": sys.argv[4] or "working", "session_id": sys.argv[5],
                  "cwd": sys.argv[6], "self": sys.argv[7] == sys.argv[1],
                  "idle_seconds": int(idle) if idle else None}), end="")
' "$name" "$project" "$tool" "$status" "$sid" "$cwd" "$me" "$idle_for"
    done < <(thread_directory)
    printf ']\n'
    return 0
  fi
  printf '%-24s  %-20s  %-8s  %-14s  %-36s  %s\n' NAME PROJECT TOOL STATUS SESSION CWD
  while IFS='|' read -r pane_id name project tool status sid cwd done_at; do
    [[ -z "$name" ]] && continue
    local mark="" shown="${status:-working}"
    [[ -n "$me" && "$name" == "$me" ]] && mark=" (you)"
    # "idle 12m" beats "idle": it answers "has this really finished, or did it just
    # go quiet a moment ago" without a second command.
    if [[ "$shown" == "idle" && -n "$done_at" && "$done_at" != "0" ]]; then
      fmt_age_short $(( now_ts - done_at )) >/dev/null
      shown="idle ${R_AGE}"
    fi
    printf '%-24s  %-20s  %-8s  %-14s  %-36s  %s\n' \
      "${name}${mark}" "$project" "${tool:-shell}" "$shown" "${sid:-—}" "${cwd/#$HOME/~}"
  done < <(thread_directory)
}

cmd_send() {
  local target="" msg="" force=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --force) force=1; shift ;;
      *) if [[ -z "$target" ]]; then target="$1"; else msg="${msg:+$msg }$1"; fi; shift ;;
    esac
  done
  [[ -n "$target" && -n "$msg" ]] \
    || { echo "Usage: llmux send <name|session-id> \"<message>\" [--force]" >&2; return 1; }

  local pane_id name project tool status sid cwd
  local hit_pane="" hit_name="" hit_status="" hit_tool="" matches=0
  while IFS='|' read -r pane_id name project tool status sid cwd; do
    [[ -z "$name" ]] && continue
    # Exact name, then session id, then unique name prefix. Anything ambiguous is an
    # error rather than a guess: delivering a message to the wrong agent is worse
    # than not delivering it.
    if [[ "$name" == "$target" || ( -n "$sid" && "$sid" == "$target" ) ]]; then
      hit_pane="$pane_id"; hit_name="$name"; hit_status="$status"; hit_tool="$tool"; matches=1; break
    fi
    if [[ "$name" == "$target"* ]]; then
      hit_pane="$pane_id"; hit_name="$name"; hit_status="$status"; hit_tool="$tool"
      matches=$(( matches + 1 ))
    fi
  done < <(thread_directory)

  if (( matches == 0 )); then
    echo "Error: no thread matches '$target' — try: llmux who" >&2; return 1
  fi
  if (( matches > 1 )); then
    echo "Error: '$target' matches $matches threads — name one exactly (llmux who)" >&2; return 1
  fi

  sender_thread_name
  local from="$R_SENDER"
  [[ -n "$from" && "$from" == "$hit_name" ]] && { echo "Error: that is this thread" >&2; return 1; }

  # A pane sitting on a permission prompt or a choice menu is READING KEYSTROKES AS
  # ANSWERS. Typing a message into it would pick an option -- approving a tool call
  # nobody vetted, or answering a question with prose. Refuse; --force is the escape
  # hatch for when you know the prompt is gone.
  if [[ "$hit_status" == "perm" ]] && (( ! force )); then
    echo "Error: $hit_name is at a permission prompt — a message would answer it. Deal with the prompt, or --force." >&2
    return 1
  fi
  local hit_src
  hit_src=$(tmux display-message -p -t "$hit_pane" '#{@llmux_status_src}' 2>/dev/null || true)
  if [[ "$hit_status" == "blocked" && "$hit_src" != "asking" ]] && (( ! force )); then
    echo "Error: $hit_name is showing a menu — a message would select an option. Answer it, or --force." >&2
    return 1
  fi

  # Attribution is part of the payload, not a convention the recipient has to know:
  # it will be read by an agent that may have no llmux context, and a peer's request
  # must not arrive looking like an instruction from Jay.
  local label
  if [[ -n "$from" ]]; then
    label="[llmux message from thread \"$from\" — another agent, not Jay]"
  else
    label="[llmux message from Jay]"
  fi
  # Collapsed to one line: a newline is ENTER in every one of these TUIs, so a
  # multi-line message submits itself in pieces, the first fragment landing as a
  # whole turn. Keep messages short; that is what the skill says too.
  local flat
  flat=$(printf '%s' "$msg" | tr '\n\r\t' '   ' | tr -s ' ')

  tmux send-keys -t "$hit_pane" -l "$label $flat" 2>/dev/null \
    || { echo "Error: could not write to $hit_name" >&2; return 1; }
  tmux send-keys -t "$hit_pane" Enter 2>/dev/null || true
  echo "→ $hit_name${hit_tool:+ ($hit_tool)}: $flat"
}

cmd_ls() {
  if ! tmux has-session -t "$SESSION" 2>/dev/null; then
    echo "No llmux session running"
    exit 0
  fi

  # Query owner-dev for shared resource info (best-effort)
  local owner_status=""
  local owner_infra=""
  local owner_root=""
  if command -v owner-dev &>/dev/null; then
    owner_status=$(owner-dev status --json 2>/dev/null || true)
    if [[ -n "$owner_status" ]]; then
      owner_root=$(echo "$owner_status" | python3 -c "import sys,json; d=json.load(sys.stdin); print(d.get('root','') or '')" 2>/dev/null || true)
      owner_infra=$(echo "$owner_status" | python3 -c "import sys,json; d=json.load(sys.stdin); print(','.join(d.get('infra',[])))" 2>/dev/null || true)
    fi
  fi

  printf "%-4s  %-30s  %-24s  %-6s  %-8s  %-30s  %s\n" "IDX" "NAME" "PROJECT" "TYPE" "SLOT" "WORKTREE" "DIRECTORY"
  printf "%-4s  %-30s  %-24s  %-6s  %-8s  %-30s  %s\n" "---" "----" "-------" "----" "----" "--------" "---------"
  local idx=0
  while IFS='|' read -r pane_id pane_name pane_path is_term existing_wt is_pin pane_slot is_sidebar is_anchor pane_project; do
    # Sidebar-mode infrastructure, not threads. The -s above is what exposes them;
    # unfiltered they printed as two "(unnamed)" rows.
    [[ "$is_sidebar" == "1" ]] && continue
    [[ "$is_anchor" == "1" ]] && continue
    [[ -z "$pane_name" ]] && pane_name="(unnamed)"
    local pane_type="llm"
    [[ "$is_term" == "1" ]] && pane_type="term"
    [[ "$is_pin" == "1" ]] && pane_type="pin"

    # Re-scan CWD for worktree, fall back to existing tag
    local wt_info
    wt_info=$(detect_worktree "$pane_path")
    if [[ -n "$wt_info" ]]; then
      # Update the tag if CWD changed to a worktree
      tmux set-option -p -t "$pane_id" @llmux_worktree "$wt_info" 2>/dev/null || true
    elif [[ -n "$existing_wt" ]]; then
      # Keep the manually-set or previously-detected tag
      wt_info="$existing_wt"
    else
      wt_info="—"
    fi

    # Re-detect the slot from cwd in case the pane drifted into one; this
    # makes `llmux ls` self-healing if a pane was created via grab/cwd-change
    # without going through `llmux add --slot`.
    local detected_slot
    detected_slot=$(slot_from_path "$pane_path")
    if [[ -n "$detected_slot" && "$detected_slot" != "$pane_slot" ]]; then
      tmux set-option -p -t "$pane_id" @llmux_slot "$detected_slot" 2>/dev/null || true
      pane_slot="$detected_slot"
    fi
    local slot_display="${pane_slot:-—}"
    local project_display="${pane_project:-$SCRATCH_KEY}"

    printf "%-4s  %-30s  %-24s  %-6s  %-8s  %-30s  %s\n" "$idx" "$pane_name" "$project_display" "$pane_type" "$slot_display" "$wt_info" "$pane_path"
    idx=$((idx + 1))
    # -s: without it this lists only the ACTIVE window, so in sidebar mode
  # `llmux ls` showed the one visible thread and silently omitted every parked
  # one — while still printing the paused section below, which made the output
  # read as authoritative.
  done < <(tmux list-panes -s -t "$SESSION" -F '#{pane_id}|#{@llmux_name}|#{pane_current_path}|#{@llmux_terminal}|#{@llmux_worktree}|#{@llmux_pinned}|#{@llmux_slot}|#{@llmux_sidebar}|#{@llmux_parked_anchor}|#{@llmux_project}')

  # Show paused panes
  local has_paused=false
  while IFS='|' read -r pname pdir ptool pwt paused_at psid pslot pproj; do
    [[ -z "$pname" ]] && continue
    if ! $has_paused; then
      echo ""
      printf "%-4s  %-30s  %-24s  %-6s  %-8s  %-30s  %s\n" "" "PAUSED" "" "" "" "" ""
      printf "%-4s  %-30s  %-24s  %-6s  %-8s  %-30s  %s\n" "---" "----" "-------" "----" "----" "--------" "---------"
      has_paused=true
    fi
    local wt_display="${pwt:-—}"
    local slot_display="${pslot:-—}"
    printf "%-4s  %-30s  %-24s  %-6s  %-8s  %-30s  %s\n" "  ~" "$pname" "${pproj:-$SCRATCH_KEY}" "${ptool:-—}" "$slot_display" "$wt_display" "$pdir"
  done < <(read_paused)

  # Show shared resource footer if owner-dev is running
  if [[ -n "$owner_infra" && "$owner_infra" != "" ]]; then
    echo ""
    echo "Shared infra (via owner-dev): $owner_infra"
    [[ -n "$owner_root" ]] && echo "  root: $owner_root"
  fi
}

cmd_attach() {
  ensure_session
  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$SESSION"
  else
    tmux attach-session -t "$SESSION"
  fi
}

cmd_setup() {
  # --- Install dependencies ---
  local deps=(gum tmux python3)
  local missing=()
  for dep in "${deps[@]}"; do
    command -v "$dep" &>/dev/null || missing+=("$dep")
  done

  if [[ ${#missing[@]} -gt 0 ]]; then
    echo "Installing missing dependencies: ${missing[*]}"
    if command -v brew &>/dev/null; then
      local brew_pkgs=()
      for dep in "${missing[@]}"; do
        case "$dep" in
          python3) brew_pkgs+=("python") ;;
          *)       brew_pkgs+=("$dep") ;;
        esac
      done
      brew install "${brew_pkgs[@]}"
    else
      echo "Error: Homebrew not found. Install manually: ${missing[*]}"
      exit 1
    fi
    echo ""
  fi

  echo "✓ All dependencies installed"
  echo ""

  # --- Find available LLM tools ---
  local found_tools=()
  for tool in "${KNOWN_TOOLS[@]}"; do
    command -v "$tool" &>/dev/null && found_tools+=("$tool")
  done

  if [[ ${#found_tools[@]} -eq 0 ]]; then
    echo "No known LLM tools found on PATH."
    exit 0
  fi

  # --- Configure args for each found tool ---
  mkdir -p "$CONFIG_DIR"
  : > "$CONFIG_FILE"

  for tool in "${found_tools[@]}"; do
    local default_args=""
    case "$tool" in
      claude) default_args="--dangerously-skip-permissions" ;;
      codex)  default_args="--dangerously-bypass-approvals-and-sandbox" ;;
    esac
    local args
    if [[ -n "$default_args" ]]; then
      read -rp "Args for $tool [$default_args]: " args
      [[ -z "$args" ]] && args="$default_args"
    else
      read -rp "Args for $tool (enter to skip): " args
    fi
    local upper
    upper=$(echo "$tool" | tr '[:lower:]-' '[:upper:]_')
    echo "LLMUX_ARGS_${upper}=\"${args}\"" >> "$CONFIG_FILE"
    if [[ -n "$args" ]]; then
      echo "  $tool: $args"
    else
      echo "  $tool: (no args)"
    fi
  done

  # --- Pick default tool ---
  echo ""
  local selected
  selected=$(printf '%s\n' "(none)" "${found_tools[@]}" | gum choose --header "Select DEFAULT LLM tool")
  [[ "$selected" == "(none)" ]] && selected=""

  # Write default at the top of config
  local tmp
  tmp=$(mktemp)
  echo "LLMUX_TOOL=\"$selected\"" > "$tmp"
  cat "$CONFIG_FILE" >> "$tmp"
  mv "$tmp" "$CONFIG_FILE"

  echo ""
  if [[ -n "$selected" ]]; then
    echo "✓ Default tool: $selected"
  else
    echo "✓ No default tool (shell only)"
  fi
  echo "  Saved to $CONFIG_FILE"
}

# Convert a relative-time string ("3d ago", "2 weeks ago", "45m ago") into an
# approximate age in seconds. Every harvester emits one of these two shapes:
#   compact:  45s / 30m / 6h / 12d ago   (claude + codex)
#   long:     3 days ago / 2 weeks ago    (amp, depending on its version)
# Unparseable input echoes nothing, which callers treat as "keep" — we never
# hide a session we can't confidently date.
relative_age_secs() {
  local s="$1" num unit
  if [[ "$s" =~ ^([0-9]+)([smhd])\ ago ]]; then
    num="${BASH_REMATCH[1]}"; unit="${BASH_REMATCH[2]}"
    case "$unit" in
      s) echo "$num" ;;
      m) echo "$((num * 60))" ;;
      h) echo "$((num * 3600))" ;;
      d) echo "$((num * 86400))" ;;
    esac
    return
  fi
  if [[ "$s" =~ ^([0-9]+)\ (second|minute|hour|day|week|month|year) ]]; then
    num="${BASH_REMATCH[1]}"; unit="${BASH_REMATCH[2]}"
    case "$unit" in
      second) echo "$num" ;;
      minute) echo "$((num * 60))" ;;
      hour)   echo "$((num * 3600))" ;;
      day)    echo "$((num * 86400))" ;;
      week)   echo "$((num * 604800))" ;;
      month)  echo "$((num * 2592000))" ;;
      year)   echo "$((num * 31536000))" ;;
    esac
    return
  fi
  echo ""
}

harvest_claude_sessions() {
  python3 << 'PYEOF'
import json, os, glob, time

def relative_time(mtime):
    delta = int(time.time() - mtime)
    if delta < 60:
        return f"{delta}s ago"
    elif delta < 3600:
        return f"{delta // 60}m ago"
    elif delta < 86400:
        return f"{delta // 3600}h ago"
    else:
        days = delta // 86400
        return f"{days}d ago"

def decode_project_path(encoded):
    """Decode Claude's project dir encoding by finding the real path on disk.
    Tries /, ., and - as separators with backtracking to find a valid path."""
    parts = encoded.lstrip("-").split("-")

    def resolve(idx, current):
        if idx == len(parts):
            return current
        part = parts[idx]
        seps = ["/"] if not current else ["/", ".", "-"]
        for sep in seps:
            candidate = current + sep + part
            result = resolve(idx + 1, candidate)
            if result and os.path.exists(result):
                return result
        return current + "/" + part if idx == len(parts) - 1 else None

    result = resolve(0, "")
    return result if result and os.path.exists(result) else "/" + "/".join(parts)

projects_dir = os.path.expanduser("~/.claude/projects")
if not os.path.isdir(projects_dir):
    exit(0)

home = os.path.expanduser("~")
# Sort by mtime descending (most recently active first)
for jsonl in sorted(glob.glob(f"{projects_dir}/*/*.jsonl"), key=os.path.getmtime, reverse=True)[:30]:
    project = os.path.basename(os.path.dirname(jsonl))
    session_id = os.path.basename(jsonl).replace(".jsonl", "")
    mtime = os.path.getmtime(jsonl)

    proj_path = decode_project_path(project)

    # Look for custom-title (set by /rename), fall back to first user message
    custom_title = ""
    first_message = ""
    with open(jsonl) as f:
        for line in f:
            try:
                msg = json.loads(line.strip())
                if msg.get("type") == "custom-title":
                    custom_title = msg.get("customTitle", "")
                if not first_message and msg.get("type") == "user":
                    content = msg.get("message", {}).get("content", "")
                    if isinstance(content, str):
                        text = content
                    elif isinstance(content, list):
                        text = next((b["text"] for b in content if isinstance(b, dict) and b.get("type") == "text"), "")
                    else:
                        continue
                    if text and not text.startswith("<local-command") and not text.startswith("<command-name>"):
                        first_message = text[:80].replace("\n", " ").strip()
            except:
                pass

    summary = custom_title or first_message or "(empty session)"
    ts = relative_time(mtime)
    # Output pipe-delimited: session_id|project_path|timestamp|summary
    print(f"{session_id}|{proj_path}|{ts}|{summary}")
PYEOF
}

harvest_amp_sessions() {
  amp threads list 2>/dev/null | tail -n +3 | while IFS= read -r line; do
    # Parse the table output: Title, Last Updated, Visibility, Messages, Thread ID
    # The format is column-aligned, thread ID is the last field
    local thread_id title updated
    thread_id=$(echo "$line" | grep -oE 'T-[0-9a-f-]+' | head -1)
    [[ -z "$thread_id" ]] && continue
    # Extract title (everything before the first date-like pattern or time-ago)
    title=$(echo "$line" | sed -E 's/[[:space:]]+(([0-9]+[smhd]|[0-9]+ (seconds?|minutes?|hours?|days?|weeks?|months?)) ago|[0-9]{4}-[0-9]{2}-[0-9]{2}).*//' | sed 's/[[:space:]]*$//')
    updated=$(echo "$line" | grep -oE '([0-9]+[smhd]|[0-9]+ (seconds?|minutes?|hours?|days?|weeks?|months?)) ago' | head -1)
    # Output: session_id|directory|timestamp|summary
    echo "${thread_id}|$(pwd)|${updated:-unknown}|${title}"
  done
}

harvest_codex_sessions() {
  local db="$HOME/.codex/state_5.sqlite"
  [[ -f "$db" ]] || return
  sqlite3 -separator '|' "$db" \
    "SELECT id, cwd, updated_at, REPLACE(SUBSTR(title, 1, 80), CHAR(10), ' ')
     FROM threads WHERE archived = 0
     ORDER BY updated_at DESC LIMIT 50" 2>/dev/null | while IFS='|' read -r sid cwd ts title; do
    [[ -z "$sid" ]] && continue
    local rel_ts
    rel_ts=$(python3 -c "
import time
diff = int(time.time()) - int('$ts')
if diff < 60: print(f'{diff}s ago')
elif diff < 3600: print(f'{diff//60}m ago')
elif diff < 86400: print(f'{diff//3600}h ago')
else: print(f'{diff//86400}d ago')
" 2>/dev/null)
    echo "${sid}|${cwd}|${rel_ts:-unknown}|${title}"
  done
}

# Harvester contract (shared by all of these): emit `id|cwd|relative_ts|title`.
#
# opencode keeps every session in ONE sqlite db keyed by `directory`, rather than
# claude's per-cwd transcript dirs — so this is a query, not a filesystem walk.
#
# `parent_id IS NULL` is load-bearing: subagent sessions are rows in the same
# table, so a single fan-out would otherwise flood the picker with a dozen
# entries for work the user never started directly.
#
# Timestamps here are MILLISECONDS (codex's are seconds) — divide before
# formatting or every session reads as ~56000 years old.
harvest_opencode_sessions() {
  [[ -f "$OPENCODE_DB" ]] || return
  sqlite3 -separator '|' "$OPENCODE_DB" \
    "SELECT id, directory, time_updated,
            REPLACE(REPLACE(SUBSTR(title, 1, 80), CHAR(10), ' '), '|', '/')
     FROM session WHERE parent_id IS NULL
     ORDER BY time_updated DESC LIMIT 50" 2>/dev/null | while IFS='|' read -r sid cwd ts title; do
    [[ -z "$sid" ]] && continue
    local rel_ts
    rel_ts=$(python3 -c "
import time
diff = int(time.time()) - int('${ts:-0}') // 1000
if diff < 60: print(f'{diff}s ago')
elif diff < 3600: print(f'{diff//60}m ago')
elif diff < 86400: print(f'{diff//3600}h ago')
else: print(f'{diff//86400}d ago')
" 2>/dev/null)
    echo "${sid}|${cwd}|${rel_ts:-unknown}|${title}"
  done
}

fetch_thread_title() {
  local tool="$1" thread_id="$2"
  case "$tool" in
    amp)
      amp threads search --json --no-color --no-ide --limit 1 "$thread_id" 2>/dev/null \
        | python3 -c "import sys,json; d=json.load(sys.stdin); print(d[0]['title'] if d else '')" 2>/dev/null
      ;;
    *) echo "" ;;
  esac
}

# Show related threads as a drop-down after initial selection.
# For Amp: uses cluster_of: search. For Claude: no-op.
# Sets _related_result to the final thread ID to resume.
show_related_threads() {
  local tool="$1" thread_id="$2" summary="$3"
  _related_result="$thread_id"

  [[ "$tool" != "amp" ]] && return 0

  echo "  Fetching related threads…"
  local related_json=""
  related_json=$(amp threads search --json --no-color --no-ide --limit 15 "cluster_of:$thread_id" 2>/dev/null) || return 0

  # Parse JSON into parallel arrays via temp file (tree-formatted display lines)
  local tmpfile
  tmpfile=$(mktemp)
  python3 -c "
import sys, json, time, datetime
try:
    data = json.loads(sys.argv[1])
except:
    sys.exit(0)
if len(data) <= 1:
    sys.exit(0)
original = sys.argv[2]
for i, t in enumerate(data):
    tid = t.get('id', '')
    title = t.get('title', '(untitled)')[:50]
    msgs = t.get('messageCount', 0)
    updated = t.get('updatedAt', '')
    ts = '?'
    if updated:
        try:
            dt = datetime.datetime.fromisoformat(updated.replace('Z', '+00:00'))
            delta = int(time.time() - dt.timestamp())
            if delta < 60: ts = f'{delta}s ago'
            elif delta < 3600: ts = f'{delta // 60}m ago'
            elif delta < 86400: ts = f'{delta // 3600}h ago'
            else: ts = f'{delta // 86400}d ago'
        except:
            pass
    is_last = (i == len(data) - 1)
    branch = '└──' if is_last else '├──'
    marker = ' ◀' if tid == original else ''
    print(f'{tid}\t{branch} {ts:<8} {title:<50} {msgs:>3} msgs{marker}')
" "$related_json" "$thread_id" > "$tmpfile" 2>/dev/null || true

  local related_ids=()
  local related_display=()
  while IFS=$'\t' read -r rid rline; do
    [[ -z "$rid" ]] && continue
    related_ids+=("$rid")
    related_display+=("$rline")
  done < "$tmpfile"
  rm -f "$tmpfile"

  if [[ ${#related_display[@]} -le 1 ]]; then
    return 0
  fi

  # Find the index of the originally selected thread for --cursor
  local cursor_idx=0
  for i in "${!related_ids[@]}"; do
    if [[ "${related_ids[$i]}" == "$thread_id" ]]; then
      cursor_idx=$((i + 1))
      break
    fi
  done

  local picked
  picked=$(printf '%s\n' "${related_display[@]}" | gum choose \
    --header "  Workstream (${#related_display[@]} threads)" \
    --cursor "▸ " \
    --cursor.foreground "212" \
    --header.foreground "99" \
    --item.foreground "245" \
    --height "${#related_display[@]}") || true

  [[ -z "$picked" ]] && return 0

  for i in "${!related_display[@]}"; do
    if [[ "${related_display[$i]}" == "$picked" ]]; then
      _related_result="${related_ids[$i]}"
      return 0
    fi
  done
}

cmd_resume() {
  local tool_override=""
  local show_all=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --tool) tool_override="${2:?--tool requires a value}"; shift 2 ;;
      --all)  show_all=1; shift ;;
      *) shift ;;
    esac
  done

  # Entries older than this many days are hidden from the picker by default,
  # so the daily-driver list stays short. This applies to BOTH paused panes and
  # harvested tool session history. Override the cutoff with
  # LLMUX_RESUME_MAX_AGE_DAYS in the config (0 = never filter), or bypass it for
  # one invocation with `--all`. Hidden paused panes still live in paused.json
  # and appear in `llmux ls` — only the resume picker hides them.
  load_config
  local max_age_days="${LLMUX_RESUME_MAX_AGE_DAYS:-14}"
  [[ -n "$show_all" ]] && max_age_days=0
  [[ "$max_age_days" =~ ^[0-9]+$ ]] || max_age_days=14
  local max_age_secs=$((max_age_days * 86400))
  local hidden_paused=0
  local hidden_sessions=0
  local now_epoch; now_epoch=$(date +%s)

  # --- Collect paused panes ---
  local paused_raw=()
  local paused_display=()
  while IFS='|' read -r pname pdir ptool pwt paused_at psid pslot pproj; do
    [[ -z "$pname" ]] && continue
    # Hide paused panes older than the cutoff (they remain in paused.json and in
    # `llmux ls`). Entries with an unparseable/missing paused_at are kept.
    if [[ "$max_age_secs" -gt 0 && "$paused_at" =~ ^[0-9]+$ ]]; then
      if (( now_epoch - paused_at > max_age_secs )); then
        ((hidden_paused++))
        continue
      fi
    fi
    # Append the slot and project as extra fields after the trailing summary
    # placeholder. Older callsites that ignore the trailing tokens stay
    # backward-compatible.
    paused_raw+=("paused|$pname|$pdir|$ptool|$pwt|$psid||$pslot|$pproj")
    local short_dir="${pdir/#$HOME/\~}"
    local ts=""
    if [[ -n "$paused_at" ]]; then
      ts=$(python3 -c "
import time
delta = int(time.time()) - int($paused_at)
if delta < 60: print(f'{delta}s ago')
elif delta < 3600: print(f'{delta // 60}m ago')
elif delta < 86400: print(f'{delta // 3600}h ago')
else: print(f'{delta // 86400}d ago')
" 2>/dev/null)
    fi
    local tool_tag="${ptool:+ [$ptool]}"
    paused_display+=("$(printf '  %-10s │ %-50s │ %s' "${ts:-?}" "${pname}${tool_tag}" "$short_dir")")
  done < <(read_paused)

  # --- Determine tool for session history ---
  local tool="$tool_override"
  if [[ -z "$tool" ]]; then
    load_config
    local resumable=()
    for t in claude amp codex; do
      command -v "$t" &>/dev/null && resumable+=("$t")
    done

    if [[ ${#resumable[@]} -eq 0 && ${#paused_raw[@]} -eq 0 ]]; then
      echo "No resumable tools found and no paused panes."
      exit 1
    elif [[ ${#resumable[@]} -eq 1 ]]; then
      tool="${resumable[0]}"
    elif [[ ${#resumable[@]} -gt 1 ]]; then
      tool=$(printf '%s\n' "${resumable[@]}" | gum choose --header "Which tool's sessions?")
      [[ -z "$tool" ]] && exit 0
    fi
  fi

  # --- Collect tool session history ---
  local session_raw=()
  local session_display=()

  if [[ -n "$tool" ]]; then
    local harvest_fn=""
    case "$tool" in
      claude)   harvest_fn=harvest_claude_sessions ;;
      amp)      harvest_fn=harvest_amp_sessions ;;
      codex)    harvest_fn=harvest_codex_sessions ;;
      opencode) harvest_fn=harvest_opencode_sessions ;;
    esac

    if [[ -n "$harvest_fn" ]]; then
      while IFS='|' read -r sid dir ts summary; do
        [[ -z "$sid" ]] && continue
        # Filter out old sessions unless the cutoff is disabled (0) or the age
        # is unparseable (relative_age_secs echoes nothing → keep).
        if [[ "$max_age_secs" -gt 0 ]]; then
          local age; age=$(relative_age_secs "$ts")
          if [[ -n "$age" && "$age" -gt "$max_age_secs" ]]; then
            ((hidden_sessions++))
            continue
          fi
        fi
        session_raw+=("session|$sid|$dir|$tool|||$summary")
        local short_dir="${dir/#$HOME/\~}"
        session_display+=("$(printf '  %-10s │ %-50s │ %s' "${ts:-?}" "${summary:0:50}" "$short_dir")")
      done < <($harvest_fn)
    fi
  fi

  # --- Build unified picker ---
  local all_raw=()
  local all_display=()

  if [[ ${#paused_display[@]} -gt 0 ]]; then
    all_raw+=("header||||||")
    local paused_header="PAUSED"
    [[ "$hidden_paused" -gt 0 ]] && paused_header+="   ($hidden_paused older hidden — llmux resume --all)"
    all_display+=("$paused_header")
    for i in "${!paused_raw[@]}"; do
      all_raw+=("${paused_raw[$i]}")
      all_display+=("${paused_display[$i]}")
    done
  fi

  if [[ ${#session_display[@]} -gt 0 ]]; then
    all_raw+=("header||||||")
    local sess_header="SESSIONS"
    [[ "$hidden_sessions" -gt 0 ]] && sess_header+="   ($hidden_sessions older hidden — llmux resume --all)"
    all_display+=("$sess_header")
    for i in "${!session_raw[@]}"; do
      all_raw+=("${session_raw[$i]}")
      all_display+=("${session_display[$i]}")
    done
  fi

  if [[ ${#all_display[@]} -eq 0 ]]; then
    local hidden_total=$((hidden_paused + hidden_sessions))
    if [[ "$hidden_total" -gt 0 ]]; then
      echo "Nothing recent (${hidden_total} older than ${max_age_days}d hidden). Use 'llmux resume --all' to see them."
    else
      echo "No paused panes or past sessions found."
    fi
    exit 0
  fi

  local selected_line
  selected_line=$(printf '%s\n' "${all_display[@]}" | gum filter \
    --header "Resume" \
    --indicator "▸" \
    --indicator.foreground "212" \
    --text.foreground "245" \
    --match.foreground "212" \
    --header.foreground "99" \
    --prompt.foreground "39" \
    --cursor-text.foreground "white")

  [[ -z "$selected_line" ]] && exit 0

  # Skip if they selected a section header
  if [[ "$selected_line" == PAUSED* || "$selected_line" == SESSIONS* ]]; then
    echo "Please select a specific entry, not a section header."
    exit 0
  fi

  # Find matching raw entry
  local match_idx=-1
  for i in "${!all_display[@]}"; do
    if [[ "${all_display[$i]}" == "$selected_line" ]]; then
      match_idx=$i
      break
    fi
  done

  [[ "$match_idx" -lt 0 ]] && { echo "Error: could not match selection"; exit 1; }

  local entry_type entry_id entry_dir entry_tool entry_wt entry_sid entry_summary entry_slot entry_project
  IFS='|' read -r entry_type entry_id entry_dir entry_tool entry_wt entry_sid entry_summary entry_slot entry_project <<< "${all_raw[$match_idx]}"

  if [[ "$entry_type" == "paused" ]]; then
    # --- Unpause flow ---
    local pane_name="$entry_id"
    local pane_dir="$entry_dir"
    local pane_tool="$entry_tool"

    remove_paused "$pane_name" || echo "Warning: could not remove '$pane_name' from paused list"

    # If the paused pane was riding an owner-wt slot, re-grab the same branch
    # into a fresh idle slot. The original slot may have been claimed by another
    # session in the meantime, so any idle one will do — branches survive
    # release. If no idle slot is available, fall back to launching the pane
    # in $HOME rather than blocking the resume.
    local adopted_slot=""
    if [[ -n "$entry_slot" ]]; then
      if [[ -z "$entry_wt" ]]; then
        echo "Warning: paused entry had slot=$entry_slot but no branch recorded; skipping slot re-grab." >&2
      else
        local slot
        if slot=$(pick_idle_slot ""); then
          echo "Re-grabbing $slot for branch '$entry_wt'..." >&2
          if (cd "$OWNER_REPO_ROOT" && owner-wt grab "$entry_wt" --slot="$slot"); then
            adopted_slot="$slot"
            pane_dir="$OWNER_SLOTS_DIR/$slot"
          else
            echo "Warning: owner-wt grab failed; resuming without a slot." >&2
          fi
        else
          echo "Warning: no idle slot available to re-adopt '$entry_wt'; resuming without a slot." >&2
        fi
      fi
    fi

    # Validate directory still exists (e.g., worktree may have been cleaned up)
    if [[ ! -d "$pane_dir" ]]; then
      echo "Warning: directory $pane_dir no longer exists, using home directory"
      pane_dir="$HOME"
    fi

    ensure_session

    local new_pane
    new_pane=$(spawn_llm_pane "$pane_dir")
    tmux select-pane -t "$new_pane" -T "$pane_name"
    tmux set-option -p -t "$new_pane" @llmux_name "$pane_name"
    [[ -n "$entry_wt" ]] && tmux set-option -p -t "$new_pane" @llmux_worktree "$entry_wt"
    [[ -n "$adopted_slot" ]] && tmux set-option -p -t "$new_pane" @llmux_slot "$adopted_slot"
    # A resumed thread returns to the project it was paused from — including one
    # whose other threads have all gone, which is why the project registry is
    # append-only.
    if [[ -n "$entry_project" ]]; then
      tmux set-option -p -t "$new_pane" @llmux_project "$entry_project"
      register_project "$entry_project"
    fi
    tag_pane_worktree "$new_pane" "$pane_dir"
    apply_layout

    if [[ -n "$pane_tool" ]]; then
      resume_tool_in_pane "$new_pane" "$pane_tool" "$pane_name" "$entry_sid"
    fi

    if [[ -n "$adopted_slot" ]]; then
      echo "Resumed '$pane_name' on $adopted_slot"
    else
      echo "Resumed '$pane_name'"
    fi
    attach_to_pane "$pane_name"

  else
    # --- Original session resume flow ---
    local selected_id="$entry_id"
    local selected_dir="$entry_dir"
    local selected_tool="$entry_tool"

    # Amp: show related threads
    show_related_threads "$selected_tool" "$selected_id" ""
    selected_id="$_related_result"

    local selected_summary="$entry_summary"
    if [[ "$selected_id" != "$entry_id" ]]; then
      selected_summary=$(fetch_thread_title "$selected_tool" "$selected_id")
    fi

    local default_name="${selected_summary:0:40}"
    [[ -z "$default_name" ]] && default_name="$selected_id"

    local pane_name
    # No-space title looks deliberately set (slug-like); use it directly.
    # Otherwise it's likely first-words of the conversation — prompt for a name.
    if [[ -n "$selected_summary" && "$selected_summary" != *" "* ]]; then
      pane_name="$default_name"
    else
      read -rp "Pane name [$default_name]: " pane_name
      [[ -z "$pane_name" ]] && pane_name="$default_name"
    fi

    local tool_cmd
    tool_cmd="$(build_tool_cmd "$selected_tool")"
    local resume_cmd=""
    case "$selected_tool" in
      claude) resume_cmd="$tool_cmd --resume $selected_id" ;;
      amp)    resume_cmd="$tool_cmd threads continue $selected_id" ;;
      codex)  resume_cmd="$tool_cmd resume $selected_id" ;;
    esac

    ensure_session

    # If the resumed session shares a name with a paused entry, drop the stale
    # entry so it doesn't show up duplicated in `llmux ls` / `llmux resume`.
    remove_paused "$pane_name" >/dev/null 2>&1 || true

    local new_pane
    new_pane=$(spawn_llm_pane "$selected_dir")
    tmux select-pane -t "$new_pane" -T "$pane_name"
    tmux set-option -p -t "$new_pane" @llmux_name "$pane_name"
    tag_pane_worktree "$new_pane" "$selected_dir"
    apply_layout
    tmux send-keys -t "$new_pane" "unset CLAUDECODE CLAUDE_CODE_SESSION; $resume_cmd" Enter
    echo "Resuming as '$pane_name'"
  fi
}

cmd_grab() {
  local name="${1:?Usage: llmux grab <name> [source-pane]}"
  local source="${2:-}"

  ensure_session

  # Check if a pane with this name already exists
  if tmux list-panes -s -t "$SESSION" -F '#{@llmux_name}' 2>/dev/null | grep -qxF "$name"; then
    echo "Error: pane '$name' already exists"
    exit 1
  fi

  # If no source given, show available panes to pick from
  if [[ -z "$source" ]]; then
    echo "Available tmux panes (excluding llmux):"
    echo ""
    local panes=()
    local idx=1
    while IFS= read -r line; do
      local pane_target pane_title pane_cmd pane_path
      pane_target=$(echo "$line" | cut -d'|' -f1)
      pane_title=$(echo "$line" | cut -d'|' -f2)
      pane_cmd=$(echo "$line" | cut -d'|' -f3)
      pane_path=$(echo "$line" | cut -d'|' -f4)
      # Skip panes in the llmux session
      [[ "$pane_target" == "$SESSION:"* ]] && continue
      panes+=("$pane_target")
      printf "  %d) %s  [%s]  (%s)\n" "$idx" "$pane_target" "$pane_cmd" "$pane_path"
      ((idx++))
    done < <(tmux list-panes -a -F '#{session_name}:#{window_index}.#{pane_index}|#{pane_title}|#{pane_current_command}|#{pane_current_path}')

    if [[ ${#panes[@]} -eq 0 ]]; then
      echo "  No other panes found."
      exit 0
    fi

    echo ""
    local choice
    read -rp "Select pane to grab [1]: " choice
    choice="${choice:-1}"
    if [[ "$choice" -lt 1 || "$choice" -gt ${#panes[@]} ]]; then
      echo "Invalid choice"
      exit 1
    fi
    source="${panes[$((choice - 1))]}"
  fi

  # Join the source pane into llmux (terminal pane stays on top)
  tmux join-pane -s "$source" -t "$SESSION" -v
  tmux select-pane -t "$SESSION" -T "$name"
  tmux set-option -p -t "$SESSION" @llmux_name "$name"
  local grab_dir
  grab_dir=$(tmux display-message -p -t "$SESSION" '#{pane_current_path}')
  tag_pane_worktree "$SESSION" "$grab_dir"
  apply_layout
  echo "Grabbed pane '$source' as '$name'"
}

WATCH_PIDFILE="/tmp/llmux-watch.pid"
WATCH_STATE_DIR="/tmp/llmux-watch"

watch_stop() {
  # Kill any tracked watcher first.
  if [[ -f "$WATCH_PIDFILE" ]]; then
    kill "$(cat "$WATCH_PIDFILE")" 2>/dev/null || true
    rm -f "$WATCH_PIDFILE"
  fi
  # Also kill any orphaned watcher processes — restarts before this fix
  # could leave stale watchers around that compete to write @llmux_ctx,
  # causing the displayed value to oscillate. Clean slate every start.
  pkill -f "bash .*/llmux-watch" 2>/dev/null || true
}

watch_start() {
  watch_stop
  mkdir -p "$WATCH_STATE_DIR"
  local watch_bin
  watch_bin="$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")/llmux-watch"
  nohup bash "$watch_bin" </dev/null >/dev/null 2>&1 &
  disown
}

# Output owner-wt slot summary for status bar: "s1:branch s2:idle s3:branch ".
# Reads slot state directly from git (same rule as owner-wt's slot_is_idle:
# detached HEAD ⇒ idle, branch checked out ⇒ held). This surfaces slots
# held outside the current llmux session too — prior sessions killed
# without releasing, or manual `owner-wt grab` invocations. The per-pane
# border format covers the in-llmux-session case; this covers the rest.
# Days of silence after which a registered PR stops being drawn. "Ongoing" has to
# mean something, and a PR nobody has pushed to in two weeks is not it. The entry
# stays in paused.json — this hides the row, it does not unregister.
PR_STALE_DAYS="${LLMUX_PR_STALE_DAYS:-14}"

# Which review UI a PR row opens. Graphite by default: the work being tracked here is
# stacked, and Graphite is where a stack is reviewable as a stack — a GitHub PR page
# shows one link in the chain with no way up or down it. Set LLMUX_PR_LINK=github for
# a repo whose org isn't on Graphite, where the app.graphite.dev URL would 404.
PR_LINK="${LLMUX_PR_LINK:-graphite}"

# @llmux_prs_state format: "repo#num=state,draft,updated_epoch;..."
pr_state_get() {
  local key="$1" blob
  blob=$(tmux show-option -t "$SESSION" -qv @llmux_prs_state 2>/dev/null || true)
  [[ -z "$blob" ]] && return 0
  printf '%s' "$blob" | tr ';' '\n' | grep -m1 -F "${key}=" | cut -d= -f2- || true
}

# Refresh the fetched half. One `gh pr view` per registered PR (~1s each), which is
# why this is never called from the render loop — llmux-watch drives it on a slow
# timer and the sidebar only ever reads the cache it leaves behind.
cmd__pr_refresh() {
  command -v gh >/dev/null 2>&1 || return 0
  local blob="" repo number url title project branch base stack
  while IFS='|' read -r repo number url title project branch base stack; do
    [[ -z "$repo" || -z "$number" ]] && continue
    local j
    j=$(gh pr view "$number" --repo "$repo" \
          --json state,isDraft,updatedAt 2>/dev/null) || continue
    [[ -z "$j" ]] && continue
    local parsed
    parsed=$(printf '%s' "$j" | python3 -c '
import json, sys, datetime
d = json.load(sys.stdin)
ts = d.get("updatedAt") or ""
try:
    ep = int(datetime.datetime.strptime(ts, "%Y-%m-%dT%H:%M:%SZ")
             .replace(tzinfo=datetime.timezone.utc).timestamp())
except Exception:
    ep = 0
print("%s,%d,%d" % (d.get("state","") , 1 if d.get("isDraft") else 0, ep))
' 2>/dev/null) || continue
    blob+="${repo}#${number}=${parsed};"
  done < <(read_prs)
  tmux set-option -t "$SESSION" @llmux_prs_state "${blob%;}" 2>/dev/null || true
  invalidate_pr_rows
}

cmd_pr() {
  local action="${1:-ls}"; shift 2>/dev/null || true

  case "$action" in
    ls)
      local repo number url title project branch base stack st
      printf '%-22s %-8s %-26s %-18s %s\n' PROJECT PR TITLE STACK STATE
      while IFS='|' read -r repo number url title project branch base stack; do
        [[ -z "$number" ]] && continue
        st=$(pr_state_get "${repo}#${number}")
        printf '%-22s %-8s %-26s %-18s %s\n' \
          "${project:-scratch}" "#${number}" "${title:0:26}" "${stack:0:18}" "${st:-—}"
      done < <(read_prs)
      return 0
      ;;
    refresh) cmd__pr_refresh; echo "Refreshed PR state."; return 0 ;;
    rm)
      local target="${1:-}"
      [[ -z "$target" ]] && { echo "Usage: llmux pr rm <number|url>" >&2; return 1; }
      local num="${target##*/}" repo=""
      # A URL identifies its own repo; a bare number means "this pane's repo".
      if [[ "$target" == http*://* ]]; then
        repo=$(printf '%s' "$target" | sed -E 's#https?://[^/]+/([^/]+/[^/]+)/pull/.*#\1#')
      else
        repo=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || true)
      fi
      [[ -z "$repo" ]] && { echo "Error: could not determine repo — pass the PR URL" >&2; return 1; }
      if remove_pr "$repo" "$num"; then
        invalidate_pr_rows
        echo "Unregistered ${repo}#${num}."
        render_sidebar 2>/dev/null || true
      else
        echo "Error: ${repo}#${num} was not registered" >&2; return 1
      fi
      return 0
      ;;
    add) ;;
    *) echo "Usage: llmux pr [add|rm|ls|refresh] ..." >&2; return 1 ;;
  esac

  # ── add ───────────────────────────────────────────────────────────────────
  local target="" title="" project="" stack="" repo=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --title)   title="${2:-}"; shift 2 ;;
      --project) project="${2:-}"; shift 2 ;;
      --stack)   stack="${2:-}"; shift 2 ;;
      --repo)    repo="${2:-}"; shift 2 ;;
      --title=*)   title="${1#*=}"; shift ;;
      --project=*) project="${1#*=}"; shift ;;
      --stack=*)   stack="${1#*=}"; shift ;;
      --repo=*)    repo="${1#*=}"; shift ;;
      *) target="$1"; shift ;;
    esac
  done
  [[ -z "$target" ]] && { echo "Usage: llmux pr add <number|url> [--title T] [--project P] [--stack S]" >&2; return 1; }
  command -v gh >/dev/null 2>&1 || { echo "Error: gh not installed" >&2; return 1; }

  local num="${target##*/}"
  if [[ "$target" == http*://* && -z "$repo" ]]; then
    repo=$(printf '%s' "$target" | sed -E 's#https?://[^/]+/([^/]+/[^/]+)/pull/.*#\1#')
  fi
  [[ -z "$repo" ]] && repo=$(gh repo view --json nameWithOwner -q .nameWithOwner 2>/dev/null || true)
  [[ -z "$repo" ]] && { echo "Error: could not determine repo — pass --repo owner/name" >&2; return 1; }

  local meta
  meta=$(gh pr view "$num" --repo "$repo" \
           --json number,title,url,headRefName,baseRefName 2>/dev/null) \
    || { echo "Error: no PR #${num} in ${repo}" >&2; return 1; }

  local gh_title url branch base
  gh_title=$(printf '%s' "$meta" | python3 -c 'import json,sys;print(json.load(sys.stdin)["title"])')
  url=$(printf '%s' "$meta"      | python3 -c 'import json,sys;print(json.load(sys.stdin)["url"])')
  branch=$(printf '%s' "$meta"   | python3 -c 'import json,sys;print(json.load(sys.stdin)["headRefName"])')
  base=$(printf '%s' "$meta"     | python3 -c 'import json,sys;print(json.load(sys.stdin)["baseRefName"])')

  # No --project: inherit the calling pane's section. An agent running in a thread
  # already knows which piece of work it is on, so making it pass that explicitly
  # is a step it can only get wrong.
  if [[ -z "$project" ]]; then
    project=$(tmux display-message -p '#{@llmux_project}' 2>/dev/null || true)
  fi
  [[ -z "$title" ]] && title="$gh_title"

  add_pr "$repo" "$num" "$url" "$title" "$project" "$branch" "$base" "$stack"
  invalidate_pr_rows
  echo "Registered ${repo}#${num} → ${project:-scratch}${stack:+ [stack: $stack]}"
  echo "  $title"
  cmd__pr_refresh 2>/dev/null || true
  render_sidebar 2>/dev/null || true
}

# `llmux review` is a thin front for `reviewq` — it exists to get the PROJECT right.
# reviewq defaults --project to the basename of the cwd, which for a thread in a
# worktree is a repo name, not the work; entries land under "Owner" or "jay" and
# match no section, so the doc never appears where Jay would look for it. Called
# from a thread, this fills in that thread's project the way `pr add` does.
#
# Everything else forwards verbatim. The queue stays reviewq's, so `reviewq review`
# and `reviewq ls` keep working on exactly the same entries.
# Mark this thread as waiting on a human answer, so its row recolours.
#
# The status option itself is NOT written here: llmux-watch owns @llmux_status and
# recomputes it every 5s, so anything written directly would be erased within one
# cycle. This sets @llmux_asking, which llmux-watch promotes to `blocked`.
#
# Claude threads get this automatically from the Stop/Notification hooks. This
# command is for the tools with no hook system (codex, amp, opencode, a plain
# shell), and for the case where an agent knows it is asking before it stops.
cmd_asking() {
  local action="${1:-on}"
  local pane="${TMUX_PANE:-}"
  # -t "$TMUX_PANE": a bare display-message answers for whichever pane is ACTIVE, so
  # an agent running in the background would flag whatever thread Jay is looking at.
  if [[ -z "$pane" ]]; then
    echo "Error: not inside a tmux pane — run this from the thread that is asking" >&2
    return 1
  fi
  case "$action" in
    on|"")
      tmux set-option -p -t "$pane" @llmux_asking "$(date +%s)" 2>/dev/null || true
      echo "Marked $(tmux show-option -p -t "$pane" -qv @llmux_name 2>/dev/null || echo "$pane") as waiting on an answer."
      ;;
    off|clear|answered)
      tmux set-option -p -t "$pane" @llmux_asking "" 2>/dev/null || true
      echo "Cleared."
      ;;
    *) echo "Usage: llmux asking [on|off]" >&2; return 1 ;;
  esac
  render_sidebar 2>/dev/null || true
}

cmd_review() {
  local action="${1:-ls}"; shift 2>/dev/null || true
  command -v reviewq >/dev/null 2>&1 \
    || { echo "Error: reviewq not installed (expected ~/.local/bin/reviewq)" >&2; return 1; }

  case "$action" in
    ls)
      local only=""
      [[ "${1:-}" == "--project" ]] && only="${2:-}"
      printf '%-6s %-22s %-9s %s\n' ID PROJECT STATE TITLE
      local r_proj r_id r_state r_title r_url
      while IFS=$'\t' read -r r_proj r_id r_state r_title r_url; do
        [[ -z "$r_id" ]] && continue
        [[ -n "$only" && "$r_proj" != "$only" ]] && continue
        printf '%-6s %-22s %-9s %s\n' "#$r_id" "$r_proj" "$r_state" "$r_title"
      done < <(build_review_rows "$(known_projects | tr '\n' ',')")
      return 0
      ;;
    done|dismiss)
      [[ $# -gt 0 ]] || { echo "Usage: llmux review $action <id>..." >&2; return 1; }
      reviewq "$action" "$@" || return 1
      invalidate_review_rows
      render_sidebar 2>/dev/null || true
      return 0
      ;;
    open)
      [[ -n "${1:-}" ]] || { echo "Usage: llmux review open <id>" >&2; return 1; }
      reviewq open "$1"; return $?
      ;;
    mv)
      # Re-file an entry whose project llmux could not match — including everything
      # queued through reviewq directly, before this existed. Stored in paused.json,
      # not written back into reviewq's file: that queue belongs to reviewq, and two
      # writers on one jsonl is how you lose an entry.
      [[ $# -ge 1 ]] || { echo "Usage: llmux review mv <id> [project]  -- no project restores the reviewq one" >&2; return 1; }
      local rid="${1#\#}" proj="${2:-}"
      [[ -n "$proj" ]] && proj=$(sanitize_project "$proj")
      set_review_project "$rid" "$proj"
      invalidate_review_rows
      echo "Review #${rid} → ${proj:-the project reviewq recorded}"
      render_sidebar 2>/dev/null || true
      return 0
      ;;
    add) ;;
    *) echo "Usage: llmux review [add|ls|done|dismiss|open|mv] ..." >&2; return 1 ;;
  esac

  # ── add ───────────────────────────────────────────────────────────────────
  local title="" url="" context="" kind="" project="" requester="" args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --title)     title="${2:-}"; shift 2 ;;
      --url)       url="${2:-}"; shift 2 ;;
      --context)   context="${2:-}"; shift 2 ;;
      --kind)      kind="${2:-}"; shift 2 ;;
      --project)   project="${2:-}"; shift 2 ;;
      --requester) requester="${2:-}"; shift 2 ;;
      --title=*)     title="${1#*=}"; shift ;;
      --url=*)       url="${1#*=}"; shift ;;
      --context=*)   context="${1#*=}"; shift ;;
      --kind=*)      kind="${1#*=}"; shift ;;
      --project=*)   project="${1#*=}"; shift ;;
      --requester=*) requester="${1#*=}"; shift ;;
      *) shift ;;
    esac
  done
  [[ -n "$title" && -n "$url" ]] \
    || { echo "Usage: llmux review add --title T --url U [--context C] [--kind K] [--project P]" >&2; return 1; }

  # -t "$TMUX_PANE", not a bare display-message. Bare, tmux answers for whichever
  # pane is ACTIVE — so an agent enqueueing from a background shell, or while Jay is
  # looking at another thread, files its doc under someone else's project. TMUX_PANE
  # is set per pane by tmux itself and names the caller, whoever is on screen.
  local ctx=()
  [[ -n "${TMUX_PANE:-}" ]] && ctx=(-t "$TMUX_PANE")
  if [[ -z "$project" ]]; then
    project=$(tmux display-message -p ${ctx[@]+"${ctx[@]}"} '#{@llmux_project}' 2>/dev/null || true)
  fi
  [[ -z "$project" ]] && project="$SCRATCH_KEY"
  if [[ -z "$requester" ]]; then
    local pane_name
    pane_name=$(tmux display-message -p ${ctx[@]+"${ctx[@]}"} '#{@llmux_name}' 2>/dev/null || true)
    [[ -n "$pane_name" ]] && requester="llmux:${pane_name}"
  fi

  args=(add --title "$title" --url "$url" --project "$project")
  [[ -n "$kind" ]]      && args+=(--kind "$kind")
  [[ -n "$requester" ]] && args+=(--requester "$requester")
  # Context on stdin, not as an argument: it is prose, routinely multi-paragraph,
  # and reviewq reads stdin for exactly this.
  local out_line
  if [[ -n "$context" ]]; then
    out_line=$(printf '%s\n' "$context" | reviewq "${args[@]}") || return 1
  elif [[ ! -t 0 ]]; then
    out_line=$(reviewq "${args[@]}") || return 1
  else
    echo "Error: --context is required (say what needs review and what feedback you want)" >&2
    return 1
  fi
  invalidate_review_rows
  echo "${out_line} → ${project}"
  echo "  $title"
  render_sidebar 2>/dev/null || true
}


# ── Crash resilience ─────────────────────────────────────────────────────────
#
# Everything about a LIVE thread -- its name, project, tool, worktree, slot and
# claude/opencode session id -- lives in tmux pane options, which die with the tmux
# server. Paused threads and registered PRs were already on disk; the running
# session, the part actually holding work in flight, was not. A crash lost all of it.
#
# So: mirror the live session into paused.json under "session" on a slow timer and
# after anything structural. This is a DERIVED cache, never a source of truth -- a
# live tmux session always wins, and the snapshot is only consulted by `llmux restore`
# when there is no session to read.
#
# Deliberately not sqlite. The data is tens of rows written rarely; what JSON lacked
# was atomicity (fixed: temp file + fsync + rename) and concurrent-write safety
# (fixed: flock). A database would add a dependency and a migration without
# persisting one byte more than this does.
snapshot_session() {
  tmux has-session -t "$SESSION" 2>/dev/null || return 0
  local rows="" line
  while IFS='|' read -r line; do
    [[ -n "$line" ]] && rows+="${line}"$'\n'
  done < <(tmux list-panes -s -t "$SESSION" \
      -F '#{@llmux_name}|#{pane_current_path}|#{@llmux_tool}|#{@llmux_project}|#{@llmux_worktree}|#{@llmux_slot}|#{@llmux_claude_session}|#{@llmux_opencode_session}|#{@llmux_order}|#{@llmux_pinned}|#{@llmux_terminal}|#{@llmux_sidebar}|#{@llmux_parked_anchor}' \
      2>/dev/null || true)
  [[ -z "$rows" ]] && return 0

  local opts=""
  local o
  for o in project_order sidebar_mode sidebar_width pr_expanded; do
    opts+="${o}=$(tmux show-option -t "$SESSION" -qv "@llmux_${o}" 2>/dev/null || true)"$'\n'
  done

  # When the tmux server was (re)started is the signal that separates a genuine
  # wind-down from the bare session that comes up after a crash/reboot. Passed to
  # the writer so it can refuse to clobber a rich snapshot with the empty one.
  local screated
  screated=$(tmux display-message -p -t "$SESSION" '#{session_created}' 2>/dev/null || echo 0)

  printf '%s\x00%s' "$rows" "$opts" | python3 -c "$PY_PAUSED_IO"'
import sys, time
path = sys.argv[1]
session_created = int(sys.argv[2]) if len(sys.argv) > 2 and sys.argv[2].isdigit() else 0
raw = sys.stdin.read()
rows, _, opts = raw.partition("\x00")
keys = ["name","dir","tool","project","worktree","slot","claude_session",
        "opencode_session","order","pinned","terminal","sidebar","anchor"]
threads = []
for line in rows.splitlines():
    if not line.strip():
        continue
    f = line.split("|")
    f += [""] * (len(keys) - len(f))
    t = dict(zip(keys, f))
    # The sidebar and the parked-window placeholder are furniture, not work.
    if t["sidebar"] == "1" or t["anchor"] == "1" or not t["name"]:
        continue
    threads.append(t)
if not threads:
    sys.exit(0)
options = {}
for line in opts.splitlines():
    k, _, v = line.partition("=")
    if k:
        options[k] = v
_lk = _lock(path)
d = _load(path)

# Crash-recovery guard. After a reboot the tmux server comes up with a bare
# session (a terminal, maybe one auto-launched pane) and the snapshotter would
# overwrite the rich pre-crash record that `llmux restore` needs -- which is
# exactly how a live session was lost once. Refuse to shrink a multi-thread
# snapshot down to at most one real thread WHEN the server has restarted since
# that snapshot was taken (session_created > saved_at). A genuine wind-down on
# the SAME server is not blocked: there session_created predates saved_at. And
# the moment the session grows back past one thread the guard stops firing, so
# it never freezes a snapshot that is legitimately changing.
old_sess = d.get("session") or {}
old_threads = old_sess.get("threads") or []
old_saved = old_sess.get("saved_at", 0)
new_content = [t for t in threads if t.get("terminal") != "1"]
old_content = [t for t in old_threads if t.get("terminal") != "1"]
if (len(new_content) <= 1 and len(old_content) >= 2
        and old_saved > 0 and session_created > old_saved):
    sys.exit(0)

# Identity is monotonic: a thread that HAD a session id has not stopped having one
# just because this read came back blank. Without this, one degraded snapshot -- a
# pane mid-relaunch, or a restore where resume rejected a stale id -- permanently
# overwrites the only record of how to resume that conversation. Losing that is the
# failure this whole feature exists to prevent, so a blank never beats a known value.
prev = {t.get("name"): t for t in ((d.get("session") or {}).get("threads") or [])}
for t in threads:
    old_t = prev.get(t.get("name"))
    if not old_t:
        continue
    for k in ("claude_session", "opencode_session", "worktree", "slot", "project", "tool"):
        if not t.get(k) and old_t.get(k):
            t[k] = old_t[k]

d["session"] = {"saved_at": int(time.time()), "threads": threads, "options": options}
_save(path, d)
' "$PAUSED_FILE" 2>/dev/null || true
}

# Print what the snapshot holds, so "did it capture my work?" is answerable without
# reading JSON by hand.
cmd_snapshot() {
  case "${1:-show}" in
    save) snapshot_session; echo "Snapshot saved."; return 0 ;;
    show) ;;
    *) echo "Usage: llmux snapshot [show|save]" >&2; return 1 ;;
  esac
  [[ -f "$PAUSED_FILE" ]] || { echo "No snapshot."; return 0; }
  python3 -c "$PY_PAUSED_IO"'
import sys, time
d = _load(sys.argv[1])
s = d.get("session") or {}
if not s:
    print("No session snapshot yet.")
    raise SystemExit(0)
age = int(time.time()) - int(s.get("saved_at", 0))
print("Snapshot %ds old — %d threads" % (age, len(s.get("threads", []))))
for t in s.get("threads", []):
    print("  %-24s %-9s %-22s %s" % (t.get("name",""), t.get("tool","") or "shell",
                                     t.get("project","") or "scratch", t.get("dir","")))
' "$PAUSED_FILE"
}

# Rebuild a session from the snapshot after a crash or a reboot. Refuses to run over
# a live session unless forced: the live one is the source of truth and restoring on
# top of it would duplicate every thread.
cmd_restore() {
  local force=0
  [[ "${1:-}" == "--force" ]] && force=1
  if tmux has-session -t "$SESSION" 2>/dev/null && (( ! force )); then
    local n
    n=$({ tmux list-panes -s -t "$SESSION" -F '#{@llmux_name}' 2>/dev/null | grep -c . ; } || echo 0)
    echo "Error: session '$SESSION' is already running ($n panes)." >&2
    echo "  Nothing to restore onto. Use --force only if you know it is empty/broken." >&2
    return 1
  fi

  local rows
  rows=$(python3 -c "$PY_PAUSED_IO"'
import sys
d = _load(sys.argv[1])
s = d.get("session") or {}
for t in s.get("threads", []):
    if t.get("terminal") == "1":
        continue
    print("|".join([t.get(k, "") for k in
        ["name","dir","tool","project","worktree","slot","claude_session","opencode_session","order","pinned"]]))
' "$PAUSED_FILE" 2>/dev/null || true)
  if [[ -z "$rows" ]]; then
    echo "No session snapshot to restore." >&2
    return 1
  fi

  ensure_session
  local name dir tool project worktree slot csid osid order pinned pane n=0
  while IFS='|' read -r name dir tool project worktree slot csid osid order pinned; do
    [[ -z "$name" ]] && continue
    [[ -d "$dir" ]] || dir="$HOME"
    pane=$(spawn_llm_pane "$dir") || continue
    tmux set-option -p -t "$pane" @llmux_name "$name"
    [[ -n "$tool" ]]      && tmux set-option -p -t "$pane" @llmux_tool "$tool"
    [[ -n "$project" ]]   && tmux set-option -p -t "$pane" @llmux_project "$project"
    [[ -n "$worktree" ]]  && tmux set-option -p -t "$pane" @llmux_worktree "$worktree"
    [[ -n "$slot" ]]      && tmux set-option -p -t "$pane" @llmux_slot "$slot"
    [[ -n "$order" ]]     && tmux set-option -p -t "$pane" @llmux_order "$order"
    [[ "$pinned" == "1" ]] && tmux set-option -p -t "$pane" @llmux_pinned 1
    # Resume the SAME conversation rather than starting a fresh one — the session id
    # is the whole reason the snapshot bothers to carry it.
    if [[ -n "$csid" ]]; then
      tmux set-option -p -t "$pane" @llmux_claude_session "$csid"
      resume_tool_in_pane "$pane" "${tool:-claude}" "$name" "$csid" 2>/dev/null || true
    elif [[ -n "$osid" ]]; then
      tmux set-option -p -t "$pane" @llmux_opencode_session "$osid"
      resume_tool_in_pane "$pane" "${tool:-opencode}" "$name" "$osid" 2>/dev/null || true
    elif [[ -n "$tool" ]]; then
      launch_tool_in_pane "$pane" "$tool" "$name" 2>/dev/null || true
    fi
    ((n++))
    echo "  + $name${tool:+ ($tool)}${project:+ → $project}"
  done <<< "$rows"

  local sopts
  sopts=$(python3 -c "$PY_PAUSED_IO"'
import sys
d = _load(sys.argv[1])
for k, v in ((d.get("session") or {}).get("options") or {}).items():
    print("%s=%s" % (k, v))
' "$PAUSED_FILE" 2>/dev/null || true)
  local k v
  while IFS='=' read -r k v; do
    [[ -n "$k" && -n "$v" ]] && tmux set-option -t "$SESSION" "@llmux_${k}" "$v" 2>/dev/null || true
  done <<< "$sopts"

  apply_layout
  # The sidebar is rebuilt rather than restored: its pane is furniture, and
  # `sidebar on` is the one supported way to register bindings and hooks.
  if [[ "$(tmux show-option -t "$SESSION" -qv @llmux_sidebar_mode 2>/dev/null || true)" == "1" ]]; then
    tmux set-option -t "$SESSION" @llmux_sidebar_mode "0" 2>/dev/null || true
    cmd_sidebar on >/dev/null 2>&1 || true
  fi
  echo "Restored $n thread(s) from snapshot."
}

cmd__slot_status() {
  # Cached for 60s. This shells out to `git rev-parse` once per slot and the Owner
  # monorepo has nine of them, so a live call costs ~700ms — paid by the tmux status
  # line every status-interval, which is what made the whole session feel sluggish.
  # Slot ownership changes on the scale of minutes, not seconds.
  local _cache _at _now
  _now=$(date +%s)
  _at=$(tmux show-option -t "$SESSION" -qv @llmux_slotstatus_at 2>/dev/null || true)
  if [[ "$_at" =~ ^[0-9]+$ ]] && (( _now - _at < 60 )); then
    tmux show-option -t "$SESSION" -qv @llmux_slotstatus 2>/dev/null || true
    return 0
  fi
  [[ -d "$OWNER_SLOTS_DIR" ]] || return 0

  local out=""
  shopt -s nullglob
  for slot_path in "$OWNER_SLOTS_DIR"/slot-*; do
    [[ -d "$slot_path" ]] || continue
    local slot_name="${slot_path##*/}"
    local short_num="${slot_name#slot-}"
    local branch
    branch="$(git -C "$slot_path" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")"
    if [[ -z "$branch" || "$branch" == "HEAD" ]]; then
      out+="s${short_num}:idle "
    else
      out+="s${short_num}:${branch} "
    fi
  done
  shopt -u nullglob

  tmux set-option -t "$SESSION" @llmux_slotstatus "$out" 2>/dev/null || true
  tmux set-option -t "$SESSION" @llmux_slotstatus_at "$_now" 2>/dev/null || true
  printf '%s' "$out"
}

# Output waiting pane count for status bar (called via tmux #(llmux _status-count))
# Counts for an outer statusline. Reports the blocking states separately from
# `idle`: "3 threads finished" and "3 threads stuck on a question" want very
# different reactions, and a single count could not tell them apart.
# The status-bar tally counts only the states that want something from Jay.
# `idle` is deliberately NOT counted: it's the resting state, so its tally hovers
# near the thread count and a number that is almost always high carries no
# information — see STATUS_FLAGS. An empty tally means nothing needs you, which is
# the useful reading.
cmd__status_count() {
  local blocked=0 perm=0
  while IFS='|' read -r status is_term; do
    [[ "$is_term" == "1" ]] && continue
    case "$status" in
      blocked)         blocked=$((blocked + 1)) ;;
      perm)            perm=$((perm + 1)) ;;
    esac
    # -s: parked threads live in a hidden window, and a tally that silently omits
  # them is worse than no tally.
  done < <(tmux list-panes -s -t "$SESSION" -F '#{@llmux_status}|#{@llmux_terminal}' 2>/dev/null)
  [[ $blocked -gt 0 ]] && printf '🙋%d ' "$blocked"
  [[ $perm    -gt 0 ]] && printf '🔐%d ' "$perm"
  return 0
}

cmd_kill() {
  if ! tmux has-session -t "$SESSION" 2>/dev/null; then
    echo "No llmux session running"
    exit 0
  fi
  watch_stop
  rm -rf "$WATCH_STATE_DIR"
  tmux kill-session -t "$SESSION"
  echo "Killed llmux session"
}

cmd_refresh() {
  if ! tmux has-session -t "$SESSION" 2>/dev/null; then
    echo "No llmux session running"
    exit 0
  fi

  # Snapshot current panes: llmux name, directory, tool, terminal flag, pinned
  # flag, and the captured claude session UUID. Carrying the UUID lets each pane
  # resume its *exact* session (--resume <id>) instead of --continue, which only
  # grabs the most-recent session in the cwd — wrong when a pane isn't the newest
  # and a silent collision when two panes share a cwd.
  # The project goes in the snapshot too: refresh kills the session, and with it
  # every @llmux_project and the project registry — so without carrying it, a
  # refresh would silently dump every thread back into SCRATCH.
  local pane_data=()
  while IFS='|' read -r name dir tool is_term is_pin sid project; do
    pane_data+=("$name|$dir|$tool|$is_term|$is_pin|$sid|$project")
  done < <(tmux list-panes -s -t "$SESSION" -F '#{@llmux_name}|#{pane_current_path}|#{@llmux_tool}|#{@llmux_terminal}|#{@llmux_pinned}|#{@llmux_claude_session}|#{@llmux_project}')

  # Stop watcher and kill the old session
  watch_stop
  rm -rf "$WATCH_STATE_DIR"
  tmux kill-session -t "$SESSION"

  # Filter to named non-terminal, non-pinned panes only
  local active=()
  local skipped=()
  local had_pinned_tool=""
  local had_pinned_session=""
  for entry in "${pane_data[@]}"; do
    local name dir tool is_term is_pin sid project
    name=$(echo "$entry" | cut -d'|' -f1)
    dir=$(echo "$entry" | cut -d'|' -f2)
    tool=$(echo "$entry" | cut -d'|' -f3)
    is_term=$(echo "$entry" | cut -d'|' -f4)
    is_pin=$(echo "$entry" | cut -d'|' -f5)
    sid=$(echo "$entry" | cut -d'|' -f6)
    project=$(echo "$entry" | cut -d'|' -f7)

    # Skip terminal — recreated by ensure_session
    [[ "$is_term" == "1" ]] && continue
    # Skip pinned — recreated by ensure_session, resume tool after
    if [[ "$is_pin" == "1" ]]; then
      had_pinned_tool="$tool"
      had_pinned_session="$sid"
      continue
    fi

    if [[ -z "$name" ]]; then
      skipped+=("(unnamed shell in $dir)")
      continue
    fi

    active+=("$name|$dir|$tool|$sid|$project")
  done

  # Recreate session (creates terminal + pinned, skipping pinned tool launch)
  LLMUX_SKIP_PINNED_LAUNCH=1 ensure_session

  # Resume tool in pinned pane if it was running one
  if [[ -n "$had_pinned_tool" ]]; then
    local pinned_pane
    pinned_pane=$(get_pinned_pane)
    if [[ -n "$pinned_pane" ]]; then
      resume_tool_in_pane "$pinned_pane" "$had_pinned_tool" "${LLMUX_PINNED_NAME:-}" "$had_pinned_session"
    fi
  fi

  if [[ ${#active[@]} -eq 0 ]]; then
    echo "No named panes to restore."
    return
  fi

  # Recreate each LLM pane below the top row
  for entry in "${active[@]}"; do
    local name dir tool sid project
    name=$(echo "$entry" | cut -d'|' -f1)
    dir=$(echo "$entry" | cut -d'|' -f2)
    tool=$(echo "$entry" | cut -d'|' -f3)
    sid=$(echo "$entry" | cut -d'|' -f4)
    project=$(echo "$entry" | cut -d'|' -f5)

    local new_pane
    new_pane=$(spawn_llm_pane "$dir")
    tmux select-pane -t "$new_pane" -T "$name"
    tmux set-option -p -t "$new_pane" @llmux_name "$name"
    if [[ -n "$project" ]]; then
      tmux set-option -p -t "$new_pane" @llmux_project "$project"
      register_project "$project"
    fi
    tag_pane_worktree "$new_pane" "$dir"
    if [[ -z "$tool" ]]; then
      load_config
      tool="${LLMUX_TOOL:-}"
    fi
    if [[ -n "$tool" ]]; then
      resume_tool_in_pane "$new_pane" "$tool" "$name" "$sid"
    fi
  done

  apply_layout

  echo ""
  echo "✓ Restored ${#active[@]} pane(s) + pinned"
  for entry in "${active[@]}"; do
    echo "  + $(echo "$entry" | cut -d'|' -f1)"
  done
  if [[ ${#skipped[@]} -gt 0 ]]; then
    echo "  Dropped ${#skipped[@]} idle pane(s)"
  fi
}

cmd_dash() {
  if ! tmux has-session -t "$SESSION" 2>/dev/null; then
    echo "No llmux session running"
    exit 0
  fi

  while true; do
    clear
    printf '\033[1m  llmux dash\033[0m\n\n'

    # Collect active panes
    local entries=()
    local display=()
    while IFS='|' read -r pane_id pname status is_term is_pin ptool; do
      [[ "$is_term" == "1" ]] && continue
      [[ -z "$pname" ]] && continue
      local icon="  " smeta
      smeta=$(status_meta "$status")
      [[ -n "${smeta%%|*}" ]] && icon="${smeta%%|*}"
      # Pin marker only when the pane isn't asking for something: "needs you"
      # outranks "this is the pinned pane" in a list you scan to decide what next.
      [[ "$is_pin" == "1" && "$status" != "blocked" && "$status" != "perm" ]] && icon="📌"
      local tool_label="${ptool:-shell}"
      entries+=("$pane_id|$pname|$tool_label|$is_pin")
      display+=("$icon  $pname ($tool_label)")
    done < <(tmux list-panes -s -t "$SESSION" -F '#{pane_id}|#{@llmux_name}|#{@llmux_status}|#{@llmux_terminal}|#{@llmux_pinned}|#{@llmux_tool}')

    # Collect paused panes
    local paused_entries=()
    local paused_display=()
    while IFS='|' read -r pname pdir ptool pwt paused_at psid; do
      [[ -z "$pname" ]] && continue
      paused_entries+=("$pname|$pdir|$ptool")
      paused_display+=("💤  $pname (${ptool:-?})")
    done < <(read_paused)

    # Build choice list
    local choices=()
    for d in "${display[@]}"; do choices+=("$d"); done
    if [[ ${#paused_display[@]} -gt 0 ]]; then
      choices+=("─── paused ───")
      for d in "${paused_display[@]}"; do choices+=("$d"); done
    fi
    choices+=("─── actions ───")
    choices+=("➕  New session")
    choices+=("🔄  Refresh")
    choices+=("❌  Quit dash")

    local pick
    pick=$(printf '%s\n' "${choices[@]}" | gum filter \
      --header "Select a session" \
      --indicator "▸" \
      --indicator.foreground "212" \
      --match.foreground "212" \
      --header.foreground "99" \
      --prompt.foreground "39" \
      --height 20) || break
    [[ -z "$pick" ]] && break

    # Handle separators
    [[ "$pick" == "───"* ]] && continue
    [[ "$pick" == "❌  Quit dash" ]] && break
    [[ "$pick" == "🔄  Refresh" ]] && continue

    if [[ "$pick" == "➕  New session" ]]; then
      local new_name
      new_name=$(gum input --placeholder "session name" --header "New session name" \
        --header.foreground "99" --prompt.foreground "39") || continue
      [[ -z "$new_name" ]] && continue
      cmd_add "$new_name"
      continue
    fi

    # Match paused pane
    for i in "${!paused_display[@]}"; do
      if [[ "${paused_display[$i]}" == "$pick" ]]; then
        local pname pdir ptool
        pname=$(echo "${paused_entries[$i]}" | cut -d'|' -f1)
        local action
        action=$(printf 'Resume\nRemove\nBack' | gum filter \
          --header "$pname" \
          --indicator "▸" \
          --indicator.foreground "212" \
          --header.foreground "99") || continue
        case "$action" in
          Resume)
            # Remove from paused, recreate pane
            remove_paused "$pname"
            pdir=$(echo "${paused_entries[$i]}" | cut -d'|' -f2)
            ptool=$(echo "${paused_entries[$i]}" | cut -d'|' -f3)
            local new_pane
            new_pane=$(tmux split-window -t "$SESSION" -v -c "$pdir" -P -F '#{pane_id}')
            tmux select-pane -t "$new_pane" -T "$pname"
            tmux set-option -p -t "$new_pane" @llmux_name "$pname"
            tag_pane_worktree "$new_pane" "$pdir"
            if [[ -n "$ptool" ]]; then
              resume_tool_in_pane "$new_pane" "$ptool" "$pname"
            fi
            apply_layout
            echo "Resumed '$pname'"
            sleep 1
            ;;
          Remove)
            remove_paused "$pname"
            echo "Removed '$pname' from paused"
            sleep 1
            ;;
        esac
        continue 2
      fi
    done

    # Match active pane
    for i in "${!display[@]}"; do
      if [[ "${display[$i]}" == "$pick" ]]; then
        local pane_id pname tool_label is_pin
        pane_id=$(echo "${entries[$i]}" | cut -d'|' -f1)
        pname=$(echo "${entries[$i]}" | cut -d'|' -f2)
        tool_label=$(echo "${entries[$i]}" | cut -d'|' -f3)
        is_pin=$(echo "${entries[$i]}" | cut -d'|' -f4)

        local actions="Focus"
        [[ "$is_pin" != "1" ]] && actions="$actions\nPause\nRemove"
        actions="$actions\nBack"

        local action
        action=$(printf "$actions" | gum filter \
          --header "$pname ($tool_label)" \
          --indicator "▸" \
          --indicator.foreground "212" \
          --header.foreground "99") || continue
        case "$action" in
          Focus)
            tmux select-pane -t "$pane_id"
            break 2
            ;;
          Pause)
            cmd_pause "$pname"
            sleep 1
            ;;
          Remove)
            cmd_rm "$pname"
            sleep 1
            ;;
        esac
        break
      fi
    done
  done
}

# --- Main ---
command="${1:-help}"
shift || true

# setup and help don't need deps; everything else does
case "$command" in
  setup|help) ;;
  *)          check_deps ;;
esac

case "$command" in
  add)       cmd_add "$@" ;;
  prompt)    cmd_prompt "$@" ;;
  dash)      cmd_dash "$@" ;;
  resume)    cmd_resume "$@" ;;
  grab)      cmd_grab "$@" ;;
  rm)        cmd_rm "$@" ;;
  pause)     cmd_pause "$@" ;;
  cycle)     cmd_cycle "$@" ;;
  ls)        cmd_ls "$@" ;;
  worktree)  cmd_worktree "$@" ;;
  attach)    cmd_attach "$@" ;;
  refresh)   cmd_refresh "$@" ;;
  kill)      cmd_kill "$@" ;;
  setup)     cmd_setup "$@" ;;
  sidebar)   cmd_sidebar "$@" ;;
  switch)    cmd_switch "$@" ;;
  mv)        cmd_mv "$@" ;;
  project)   cmd_project "$@" ;;
  pr)        cmd_pr "$@" ;;
  review)    cmd_review "$@" ;;
  asking)    cmd_asking "$@" ;;
  context)   cmd_context "$@" ;;
  who)       cmd_who "$@" ;;
  send)      cmd_send "$@" ;;
  restore)   cmd_restore "$@" ;;
  snapshot)  cmd_snapshot "$@" ;;
  next)      cmd_next "$@" ;;
  prev)      cmd_prev "$@" ;;
  top)       cmd_top "$@" ;;
  _relayout)     apply_layout ;;
  _sidebar-loop) sidebar_loop ;;
  _render)       render_sidebar ;;
  _click)        sidebar_click "$@" ;;
  _newthread)    cmd__newthread "$@" ;;
  _movethread)   cmd__movethread "$@" ;;
  _watch)        watch_start; echo "Watcher started" ;;
  _watch-stop)   watch_stop; echo "Watcher stopped" ;;
  _status-count) cmd__status_count ;;
  _slot-status)  cmd__slot_status ;;
  _pr-refresh)   cmd__pr_refresh ;;
  _snapshot)     snapshot_session ;;
  help)          usage ;;
  *)             echo "Unknown command: $command"; usage; exit 1 ;;
esac
